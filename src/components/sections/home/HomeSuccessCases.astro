---
/**
 * HomeSuccessCases — "Nuestros casos de éxito"
 * --------------------------------------------------------------------------
 * Figma: Home › "Frame 628099" (muro de testimonios), mejorado:
 *   - Encabezado con antetítulo, bajada y dos datos de la comunidad.
 *   - Historias en video reales: el caso de éxito del canal de YouTube y el
 *     testimonio de un alumno en TikTok (src/data/testimonials.ts ›
 *     successVideos). Se reproducen en el modal del sitio (el de TikTok, en
 *     vertical); sin JavaScript abren YouTube / TikTok.
 *   - Testimonios: al llegar a la fila, el bloque queda fijo bajo el header y
 *     el scroll pasa las tarjetas una por una (con contador y barra); después
 *     de la última, el scroll sigue a la sección de abajo
 *     (src/scripts/motion.ts › data-scroll-slider="pin"). Sin JavaScript se
 *     desliza con el dedo.
 *
 * Los testimonios vienen de src/data/testimonials.ts (o WordPress).
 *
 * Uso: <HomeSuccessCases /> (página de inicio).
 */
import { Image } from 'astro:assets';

import TestimonialCard from '@components/cards/TestimonialCard.astro';
import Icon from '@components/ui/Icon.astro';
import SliderProgress from '@components/ui/SliderProgress.astro';
import { successVideos } from '@data/testimonials';
import { tiktokPostUrl, tiktokProfile } from '@data/social';
import { getTestimonials } from '@lib/content';
import Star from '@assets/graphics/stars/star-4-point.svg';

const testimonials = await getTestimonials();
const { youtube, tiktok } = successVideos;

// ----- Contenido de la sección -----
const content = {
	eyebrow: 'Historias reales',
	title: 'Nuestros casos de éxito',
	subtitle:
		'Estudiantes que ganaron su beca y hoy estudian en Rusia. Conoce sus historias contadas por ellos mismos.',
	stats: [
		{ value: '+100', label: 'estudiantes acompañados' },
		{ value: tiktokProfile.likes, label: '“me gusta” en TikTok' },
	],
	watch: 'Ver video',
	views: 'reproducciones',
	listLabel: 'Testimonios de estudiantes',
	reelEyebrow: 'Testimonios',
	reelTitle: 'Lo que dicen nuestros estudiantes',
};
---

<section class="home-cases section" id="casos-de-exito" aria-labelledby="home-cases-title">
	<header class="home-cases__header container">
		<div class="home-cases__intro">
			<p class="home-cases__eyebrow">
				<Star class="home-cases__eyebrow-star" aria-hidden="true" />
				{content.eyebrow}
			</p>
			<h2 id="home-cases-title" class="home-cases__title">
				{content.title}
			</h2>
			<p class="home-cases__subtitle">{content.subtitle}</p>
		</div>

		<ul class="home-cases__stats" role="list">
			{content.stats.map((stat) => (
				<li class="home-cases__stat">
					<strong class="home-cases__stat-value">{stat.value}</strong>
					<span class="home-cases__stat-label">{stat.label}</span>
				</li>
			))}
		</ul>
	</header>

	<!-- Historias en video (reales) -->
	<div class="home-cases__spotlight container">
		<a
			class="case-video case-video--wide"
			href={`https://www.youtube.com/watch?v=${youtube.youtubeId}`}
			target="_blank"
			rel="noopener"
			data-video-open
			data-video-youtube={youtube.youtubeId}
			data-video-title={youtube.title}
		>
			<Image
				src={youtube.cover}
				alt=""
				widths={[640, 960, 1280]}
				sizes="(max-width: 1100px) 92vw, 860px"
				class="case-video__cover"
			/>
			<span class="case-video__shade" aria-hidden="true" />
			<span class="case-video__badge" aria-hidden="true">
				<Icon name="youtube-play" size={16} class="case-video__badge-icon" />
				YouTube · {youtube.duration}
			</span>
			<span class="case-video__play" aria-hidden="true">
				<Icon name="play" size={28} />
			</span>
			<span class="case-video__caption">
				<span class="visually-hidden">{content.watch}: </span>
				<span class="case-video__kicker">{youtube.kicker}</span>
				<span class="case-video__title">{youtube.title}</span>
			</span>
		</a>

		<a
			class="case-video case-video--tall"
			href={tiktokPostUrl(tiktok.tiktokId)}
			target="_blank"
			rel="noopener"
			data-video-open
			data-video-tiktok={tiktok.tiktokId}
			data-video-title={tiktok.title}
		>
			<Image
				src={tiktok.cover}
				alt=""
				widths={[300, 540]}
				sizes="(max-width: 640px) 120px, 300px"
				class="case-video__cover"
			/>
			<span class="case-video__shade" aria-hidden="true" />
			<span class="case-video__badge" aria-hidden="true">
				<Icon name="tiktok" size={14} />
				TikTok
			</span>
			<span class="case-video__play" aria-hidden="true">
				<Icon name="play" size={22} />
			</span>
			<span class="case-video__caption">
				<span class="visually-hidden">{content.watch}: </span>
				<span class="case-video__kicker">{tiktok.kicker}</span>
				<span class="case-video__title">{tiktok.title}</span>
				<span class="case-video__views">
					<Icon name="play" size={12} />
					{tiktok.views}
					<span class="visually-hidden"> {content.views}</span>
				</span>
			</span>
		</a>
	</div>

	<!-- Testimonios: el bloque queda fijo y el scroll pasa las tarjetas -->
	<div class="home-cases__reel" data-scroll-slider="pin" data-slider-step="0.34">
		<div class="home-cases__stage">
			<div class="home-cases__reel-header container">
				<p class="home-cases__reel-eyebrow">{content.reelEyebrow}</p>
				<h3 class="home-cases__reel-title">{content.reelTitle}</h3>
			</div>

			<div class="home-cases__viewport" data-slider-viewport>
				<ul class="home-cases__track" role="list" aria-label={content.listLabel} data-slider-track>
					{testimonials.map((testimonial) => (
						<li class="home-cases__item" data-slider-item>
							<TestimonialCard testimonial={testimonial} />
						</li>
					))}
				</ul>
			</div>

			<SliderProgress total={testimonials.length} tone="light" class="home-cases__progress container" />
		</div>
	</div>
</section>

<style>
	.home-cases {
		--cases-inset: max(var(--gutter), calc((100% - var(--container-max)) / 2));

		position: relative;
		display: flex;
		flex-direction: column;
		gap: clamp(var(--space-7), 3.5vw, var(--space-9));
		overflow: clip;
		background:
			radial-gradient(50rem 28rem at 100% 0%, rgb(0 122 252 / 0.18), transparent 60%),
			var(--surface-dark);
		color: var(--text-on-dark);
	}

	/* ===== Encabezado ===== */
	.home-cases__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-6) var(--space-8);
	}

	.home-cases__intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		max-width: 40rem;
	}

	.home-cases__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border: 1px solid rgb(255 255 255 / 0.14);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.06);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
	}

	.home-cases__eyebrow-star {
		width: 1rem;
		height: 1rem;
		color: var(--color-yellow);
	}

	.home-cases__title {
		font-size: var(--font-size-h1);
		line-height: 1.1;
	}

	.home-cases__subtitle {
		font-size: var(--font-size-lg);
		line-height: 1.75rem;
		color: rgb(244 244 244 / 0.78);
	}

	.home-cases__stats {
		display: flex;
		gap: var(--space-3);
	}

	.home-cases__stat {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 10rem;
		padding: var(--space-4) var(--space-5);
		border: 1px solid rgb(255 255 255 / 0.12);
		border-radius: var(--radius-lg);
		background-color: rgb(255 255 255 / 0.04);
	}

	.home-cases__stat-value {
		font-size: 1.75rem;
		font-weight: var(--font-weight-bold);
		line-height: 2.125rem;
		color: var(--color-skyblue);
	}

	.home-cases__stat-label {
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
		color: rgb(244 244 244 / 0.75);
	}

	/* ===== Historias en video ===== */
	.home-cases__spotlight {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
		gap: clamp(var(--space-4), 2vw, var(--space-6));
	}

	.case-video {
		position: relative;
		isolation: isolate;
		display: block;
		overflow: clip;
		border-radius: var(--radius-xl);
		background-color: var(--surface-dark-raised);
		box-shadow: 0 2rem 4rem -2rem rgb(0 0 0 / 0.8);
		color: var(--color-pure-white);
	}

	.case-video--wide {
		aspect-ratio: 16 / 9;
	}

	.case-video__cover {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.8s var(--ease-out);
	}

	.case-video:hover .case-video__cover {
		scale: 1.05;
	}

	.case-video__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(to top, rgb(6 10 20 / 0.88) 0%, rgb(6 10 20 / 0.25) 45%, transparent 65%),
			linear-gradient(to bottom, rgb(6 10 20 / 0.35), transparent 25%);
	}

	.case-video__badge {
		position: absolute;
		top: var(--space-4);
		left: var(--space-4);
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.75rem;
		border-radius: var(--radius-pill);
		background-color: rgb(0 0 0 / 0.5);
		backdrop-filter: blur(8px);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
	}

	.case-video__badge :global(.case-video__badge-icon) {
		color: var(--color-red);
	}

	.case-video__play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 4.75rem;
		height: 4.75rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		box-shadow:
			0 0 0 0.75rem rgb(255 255 255 / 0.22),
			0 1rem 2rem -0.75rem rgb(0 0 0 / 0.6);
		color: var(--color-blue);
		translate: -50% -50%;
		transition: scale var(--duration-slow) var(--ease-out);
	}

	.case-video__play :global(svg) {
		margin-left: 0.25rem;
	}

	.case-video--tall .case-video__play {
		width: 3.5rem;
		height: 3.5rem;
		box-shadow:
			0 0 0 0.5rem rgb(255 255 255 / 0.22),
			0 1rem 2rem -0.75rem rgb(0 0 0 / 0.6);
	}

	.case-video:hover .case-video__play {
		scale: 1.08;
	}

	.case-video__caption {
		position: absolute;
		inset: auto var(--space-6) var(--space-6);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.case-video--tall .case-video__caption {
		inset: auto var(--space-4) var(--space-4);
	}

	.case-video__kicker {
		padding: 0.1875rem 0.625rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-red);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		letter-spacing: 0.02em;
	}

	.case-video__title {
		max-width: 26ch;
		font-size: clamp(1.25rem, 0.95rem + 1.1vw, 2rem);
		font-weight: var(--font-weight-bold);
		line-height: 1.15;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.case-video--tall .case-video__title {
		font-size: var(--font-size-md);
		line-height: 1.35;
	}

	.case-video__views {
		display: inline-flex;
		align-items: center;
		gap: 0.3125rem;
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		color: rgb(255 255 255 / 0.9);
	}

	.case-video:focus-visible {
		outline: 3px solid var(--color-skyblue);
		outline-offset: 4px;
	}

	/* ===== Testimonios (fila deslizable; con el slider, fija y avanza con el scroll) ===== */
	.home-cases__stage {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.home-cases__reel-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.home-cases__reel-eyebrow {
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-skyblue);
	}

	.home-cases__reel-title {
		font-size: var(--font-size-h3);
		line-height: 1.2;
		color: var(--color-pure-white);
	}

	/* Con el slider activo: el bloque mide lo que dura el recorrido y queda
	   fijo bajo el header mientras pasan las tarjetas */
	.home-cases__reel:global(.is-scroll-slider) {
		height: calc(100svh - var(--header-height) + var(--slider-length, 0px));
	}

	.home-cases__reel:global(.is-scroll-slider) .home-cases__stage {
		position: sticky;
		top: var(--header-height);
		justify-content: center;
		height: calc(100svh - var(--header-height));
		padding-block: var(--space-5);
	}

	/* Pantallas bajas (.is-slider-compact, lo decide src/scripts/motion.ts): menos aire */
	.home-cases__reel:global(.is-scroll-slider.is-slider-compact) .home-cases__stage {
		gap: var(--space-3);
		padding-block: var(--space-3);
	}

	.home-cases__viewport {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--cases-inset);
		scrollbar-width: none;
		padding-block: var(--space-3) var(--space-7);
		margin-block: calc(-1 * var(--space-3)) calc(-1 * var(--space-7));
	}

	.home-cases__viewport::-webkit-scrollbar {
		display: none;
	}

	.home-cases__track {
		display: flex;
		align-items: stretch;
		gap: var(--space-4);
		width: max-content;
		padding-inline: var(--cases-inset);
	}

	.home-cases__item {
		display: flex;
		flex-shrink: 0;
		scroll-snap-align: start;
	}

	.home-cases :global(.testimonial-card) {
		--testimonial-card-width: 22rem;
	}

	.home-cases__reel:global(.is-scroll-slider) .home-cases__viewport {
		overflow: hidden;
		scroll-snap-type: none;
	}

	.home-cases__reel:global(.is-scroll-slider) .home-cases__track {
		transform: translate3d(var(--slider-x, 0px), 0, 0);
		will-change: transform;
	}

	/* ===== Tablet ===== */
	@media (max-width: 1100px) {
		.home-cases__header {
			flex-direction: column;
			align-items: flex-start;
		}

		/* El video ancho arriba; el de TikTok como una tarjeta horizontal */
		.home-cases__spotlight {
			grid-template-columns: minmax(0, 1fr);
		}

		.case-video--tall {
			display: grid;
			grid-template-columns: 9rem minmax(0, 1fr);
			align-items: center;
			min-height: 16rem;
			background-color: var(--surface-dark-raised);
		}

		.case-video--tall .case-video__cover {
			position: relative;
			inset: auto;
			z-index: 0;
			width: 9rem;
			height: 16rem;
		}

		.case-video--tall .case-video__shade {
			display: none;
		}

		.case-video--tall .case-video__play {
			left: 4.5rem;
			width: 3rem;
			height: 3rem;
		}

		.case-video--tall .case-video__caption {
			position: static;
			padding: var(--space-5) var(--space-6);
		}

		.case-video--tall .case-video__title {
			font-size: var(--font-size-lg);
		}
	}

	/* ===== Móvil ===== */
	@media (max-width: 640px) {
		.home-cases {
			gap: var(--space-6);
			padding-block: var(--space-9);
		}

		.home-cases__stage {
			gap: var(--space-4);
		}

		.home-cases__reel-header {
			align-items: center;
			text-align: center;
		}

		.home-cases__reel-title {
			font-size: var(--font-size-card-title-mobile);
		}

		.home-cases__header {
			align-items: stretch;
		}

		.home-cases__intro {
			align-items: center;
			max-width: none;
			text-align: center;
		}

		.home-cases__title {
			font-size: var(--font-size-title-mobile);
			line-height: var(--line-height-title-mobile);
		}

		.home-cases__subtitle {
			font-size: var(--font-size-md);
			line-height: 1.5rem;
		}

		.home-cases__stats {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-2);
		}

		.home-cases__stat {
			min-width: 0;
			padding: var(--space-3) var(--space-4);
		}

		.home-cases__stat-value {
			font-size: 1.375rem;
			line-height: 1.75rem;
		}

		.home-cases__stat-label {
			font-size: var(--font-size-xs);
		}

		.home-cases__spotlight {
			gap: var(--space-3);
		}

		.case-video {
			border-radius: var(--radius-lg);
		}

		.case-video__caption {
			inset: auto var(--space-4) var(--space-4);
		}

		.case-video__title {
			font-size: var(--font-size-card-title-mobile);
			line-height: 1.3;
		}

		.case-video__play {
			width: 3.5rem;
			height: 3.5rem;
		}

		.case-video--tall {
			grid-template-columns: 7.5rem minmax(0, 1fr);
			min-height: 13.25rem;
		}

		.case-video--tall .case-video__cover {
			width: 7.5rem;
			height: 13.25rem;
		}

		.case-video--tall .case-video__play {
			left: 3.75rem;
			width: 2.75rem;
			height: 2.75rem;
		}

		.case-video--tall .case-video__caption {
			padding: var(--space-4);
		}

		.case-video--tall .case-video__title {
			font-size: var(--font-size-md);
		}

		.case-video--tall .case-video__badge {
			top: var(--space-2);
			left: var(--space-2);
			padding: 0.25rem 0.5rem;
		}

		.home-cases :global(.testimonial-card) {
			--testimonial-card-width: min(82vw, 20rem);
		}
	}
</style>
