---
/**
 * UniversityTips — "Consejos"
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Universidad Single" (3333:276) › "Frame 628437" (3333:261).
 *
 * Tarjetas grises con la forma celeste de "reloj de arena" de la marca, el
 * consejo en azul (ExtraBold) y dos estrellas pequeñas (roja y amarilla).
 * 2 columnas en desktop/tablet y 1 en móvil. Encabezado con etiqueta, título
 * y bajada; las tarjetas aparecen en cascada al hacer scroll.
 *
 * Uso: <UniversityTips id="consejos" tips={university.tips} />
 */
import Hourglass from '@assets/graphics/shapes/shape-hourglass-tip.svg';
import Star from '@assets/graphics/stars/star-4-point.svg';
import StarRed from '@assets/graphics/stars/star-red-small.svg';
import StarYellow from '@assets/graphics/stars/star-yellow-small.svg';

interface Props {
	/** id del ancla (lo usa la píldora de navegación) */
	id: string;
	tips: string[];
}

const { id, tips } = Astro.props;

// ----- Contenido de la sección -----
const content = {
	eyebrow: 'Consejos',
	title: 'Antes de llegar, ten en cuenta',
	text: 'Consejos prácticos para que tu primer año en Rusia sea más fácil.',
};
---

<section id={id} class="university-tips section" aria-labelledby={`${id}-title`}>
	<header class="university-tips__header container">
		<p class="university-tips__eyebrow">
			<Star class="university-tips__eyebrow-star" aria-hidden="true" />
			{content.eyebrow}
		</p>
		<h2 id={`${id}-title`} class="university-tips__title">
			{content.title}
		</h2>
		<p class="university-tips__text">{content.text}</p>
	</header>

	<ul class="university-tips__grid container" role="list">
		{tips.map((tip) => (
			<li class="tip-card">
				<Hourglass class="tip-card__shape" aria-hidden="true" />
				<p class="tip-card__text">{tip}</p>
				<span class="tip-card__star tip-card__star--red" aria-hidden="true">
					<StarRed />
				</span>
				<span class="tip-card__star tip-card__star--yellow" aria-hidden="true">
					<StarYellow />
				</span>
			</li>
		))}
	</ul>
</section>

<style>
	.university-tips {
		display: flex;
		flex-direction: column;
		gap: clamp(var(--space-7), 4vw, var(--space-9));
		background-color: var(--surface-white);
		color: var(--text-on-light);
		scroll-margin-top: calc(var(--header-height) + 5.5rem);
	}

	.university-tips__header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
	}

	.university-tips__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border-radius: var(--radius-pill);
		background-color: rgb(0 122 252 / 0.1);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
		color: var(--color-blue-title);
	}

	.university-tips__eyebrow-star {
		width: 1rem;
		height: 1rem;
		color: var(--color-red);
	}

	.university-tips__title {
		font-size: var(--font-size-h1);
		line-height: 1.1;
		color: var(--text-heading-light);
		text-wrap: balance;
	}

	.university-tips__text {
		max-width: 38rem;
		font-size: var(--font-size-lg);
		line-height: 1.75rem;
		color: #363636;
	}

	.university-tips__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-5) var(--space-4); /* 24px filas · 16px columnas */
		/* El reinicio de listas (ul[role='list'] { padding: 0 }) le quita el margen de .container */
		padding-inline: var(--gutter);
	}

	/* ----- Tarjeta (585 × 430 px en Figma) ----- */
	.tip-card {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 26.875rem; /* 430px */
		padding: var(--space-8) 9.06%; /* texto de 479px de ancho */
		border-radius: var(--radius-lg); /* 24px */
		overflow: clip;
		background-color: var(--color-white);
		text-align: center;
	}

	/* Forma de reloj de arena: centrada y recortada arriba y abajo por la tarjeta */
	.tip-card__shape {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: -1;
		width: auto;
		max-width: none;
		height: 167.75%; /* 721px sobre 430px */
		aspect-ratio: 495.625 / 721.277;
		transform: translate(-50%, -50%);
	}

	.tip-card__text {
		font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem); /* 36px */
		font-weight: var(--font-weight-extrabold);
		line-height: 1.22; /* 44px */
		color: var(--color-blue-title);
		text-wrap: balance;
	}

	/* ----- Estrellas pequeñas (posiciones de Figma, en % de la tarjeta) ----- */
	.tip-card__star {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
	}

	.tip-card__star :global(svg) {
		flex: none;
		max-width: none;
	}

	.tip-card__star--red {
		left: 11.24%;
		top: 69.21%;
		width: 14.689px;
		height: 17.477px;
	}

	.tip-card__star--red :global(svg) {
		transform: rotate(-36.13deg) skewX(-8.85deg);
	}

	.tip-card__star--yellow {
		left: 83.66%;
		top: 23.82%;
		width: 12.232px;
		height: 15.723px;
	}

	/* En la columna derecha la estrella amarilla sube un poco */
	.tip-card:nth-child(even) .tip-card__star--yellow {
		left: 89%;
		top: 16.98%;
	}

	.tip-card__star--yellow :global(svg) {
		transform: rotate(16.73deg) skewX(7.82deg);
	}

	@media (max-width: 640px) {
		.university-tips {
			gap: var(--space-6);
		}

		.university-tips__title {
			font-size: var(--font-size-title-mobile);
			line-height: var(--line-height-title-mobile);
		}

		.university-tips__text {
			font-size: var(--font-size-md);
			line-height: 1.5rem;
		}

		.university-tips__grid {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}

		.tip-card {
			min-height: 20rem;
			padding: var(--space-9) var(--space-6);
		}

		.tip-card:nth-child(even) .tip-card__star--yellow {
			left: 83.66%;
			top: 23.82%;
		}
	}
</style>
