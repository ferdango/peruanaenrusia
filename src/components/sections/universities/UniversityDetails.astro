---
/**
 * UniversityDetails — "Detalles" de la ficha de universidad
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Universidad Single" (3333:276) › "Frame 628442"
 * (3333:266, áreas de estudio), "Frame 628441" (3333:265, "Reputación y
 * rankings") y "Frame 628439" (3333:263, "Vida estudiantil e
 * internacionalización").
 *
 * Desktop: las áreas de estudio a la izquierda (acordeón nativo <details>:
 * al abrir una facultad, el nombre se vuelve azul y aparece la estrella de la
 * marca, como el primer ítem de Figma) y a la derecha las tarjetas de
 * rankings y de vida estudiantil. Tablet y móvil: una columna.
 * Solo se dibujan los bloques con datos.
 *
 * Uso: <UniversityDetails id="detalles" university={university} />
 */
import Icon from '@components/ui/Icon.astro';
import UniversityStarList from './UniversityStarList.astro';
import type { University } from '@data/universities';
import Star from '@assets/graphics/stars/star-4-point.svg';

interface Props {
	/** id del ancla (lo usa la píldora de navegación) */
	id: string;
	university: University;
}

const { id, university } = Astro.props;
const { faculties = [], rankings, studentLife = [] } = university;

// ----- Contenido de la sección -----
const content = {
	eyebrow: 'Detalles',
	title: 'Carreras, prestigio y vida estudiantil',
	facultiesTitle: 'Áreas de estudio',
	facultiesLead: 'Las áreas de estudio incluyen:',
	rankingsTitle: 'Reputación y rankings',
	studentLifeTitle: 'Vida estudiantil e internacionalización',
};

const hasAside = Boolean(rankings) || studentLife.length > 0;
---

<section id={id} class="university-details section" aria-labelledby={`${id}-title`}>
	<div class="container">
		<header class="university-details__header">
			<p class="university-details__eyebrow">
				<Star class="university-details__eyebrow-star" aria-hidden="true" />
				{content.eyebrow}
			</p>
			<h2 id={`${id}-title`} class="university-details__title">
				{content.title}
			</h2>
		</header>

		<div class:list={['university-details__grid', { 'is-single': !faculties.length || !hasAside }]}>
			{faculties.length > 0 && (
				<div class="university-details__block">
					<h3 class="university-details__block-title">{content.facultiesTitle}</h3>
					<p class="university-details__text">{content.facultiesLead}</p>

					<div class="faculty-list">
						{faculties.map((faculty, index) =>
							faculty.description ? (
								<details class="faculty" name="university-faculties" open={index === 0}>
									<summary class="faculty__summary">
										<span class="faculty__name">{faculty.name}</span>
										<span class="faculty__toggle" aria-hidden="true">
											<Star class="faculty__star" />
										</span>
									</summary>
									<p class="faculty__description">{faculty.description}</p>
								</details>
							) : (
								<div class="faculty">
									<p class="faculty__summary">
										<span class="faculty__name">{faculty.name}</span>
									</p>
								</div>
							),
						)}
					</div>
				</div>
			)}

			{hasAside && (
				<div class="university-details__aside">
					{rankings && (
						<div class="university-details__card">
							<span class="university-details__card-icon" aria-hidden="true">
								<Icon name="landmark" size={24} />
							</span>
							<h3 class="university-details__block-title">{content.rankingsTitle}</h3>
							{rankings.intro && <p class="university-details__text">{rankings.intro}</p>}
							<UniversityStarList items={rankings.items} />
						</div>
					)}

					{studentLife.length > 0 && (
						<div class="university-details__card university-details__card--life">
							<span class="university-details__card-icon" aria-hidden="true">
								<Icon name="user" size={24} />
							</span>
							<h3 class="university-details__block-title">{content.studentLifeTitle}</h3>
							{studentLife.map((paragraph) => (
								<p class="university-details__text">{paragraph}</p>
							))}
						</div>
					)}
				</div>
			)}
		</div>
	</div>
</section>

<style>
	.university-details {
		position: relative;
		overflow: clip;
		background: radial-gradient(50rem 28rem at 100% 0%, rgb(0 192 252 / 0.14), transparent 70%), #f1f7fb;
		color: var(--text-on-light);
		scroll-margin-top: calc(var(--header-height) + 5.5rem);
	}

	/* ===== Encabezado ===== */
	.university-details__header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		margin-bottom: clamp(var(--space-7), 4vw, var(--space-9));
	}

	.university-details__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border-radius: var(--radius-pill);
		background-color: var(--surface-white);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
		color: var(--color-blue-title);
	}

	.university-details__eyebrow-star {
		width: 1rem;
		height: 1rem;
		color: var(--color-red);
	}

	.university-details__title {
		max-width: 22ch;
		font-size: var(--font-size-h1);
		line-height: 1.1;
		color: var(--text-heading-light);
		text-wrap: balance;
	}

	/* ===== Dos columnas: áreas de estudio · tarjetas ===== */
	.university-details__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		align-items: start;
		gap: var(--space-6);
	}

	.university-details__grid.is-single {
		grid-template-columns: minmax(0, 1fr);
	}

	.university-details__block,
	.university-details__aside {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.university-details__block-title {
		font-size: var(--font-size-h3);
		line-height: 1.2;
		color: var(--color-blue-title);
	}

	.university-details__text {
		font-size: var(--font-size-md);
		line-height: 1.6rem;
		color: #2c3030;
	}

	/* ----- Acordeón de facultades ----- */
	.faculty-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.faculty {
		border: 1px solid rgb(18 91 168 / 0.1);
		border-radius: var(--radius-lg);
		background-color: var(--surface-white);
		box-shadow: 0 1rem 2rem -1.75rem rgb(18 91 168 / 0.6);
		transition:
			border-color var(--duration-base) var(--ease-out),
			box-shadow var(--duration-slow) var(--ease-out);
	}

	.faculty[open] {
		border-color: rgb(0 122 252 / 0.4);
		box-shadow: 0 1.5rem 2.5rem -1.75rem rgb(0 122 252 / 0.7);
	}

	.faculty__summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 4.25rem;
		padding: var(--space-4) var(--space-5);
		border-radius: inherit;
		list-style: none;
		cursor: pointer;
	}

	div.faculty .faculty__summary {
		cursor: default;
	}

	.faculty__summary::-webkit-details-marker {
		display: none;
	}

	.faculty__summary:focus-visible {
		outline: 3px solid var(--color-blue);
		outline-offset: 2px;
	}

	.faculty__name {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-semibold);
		line-height: 1.5rem;
		color: var(--text-on-light);
		transition:
			color var(--duration-base) var(--ease-out),
			translate var(--duration-slow) var(--ease-out);
	}

	.faculty[open] .faculty__name,
	.faculty__summary:hover .faculty__name {
		color: var(--color-blue-title);
		translate: 0.25rem 0;
	}

	/* Estrella de la marca: gris al cerrar, azul y girada al abrir */
	.faculty__toggle {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-pill);
		background-color: #eef4f9;
		color: rgb(18 91 168 / 0.45);
		transition:
			background-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out),
			rotate var(--duration-slow) var(--ease-out);
	}

	.faculty__star {
		width: 1.125rem;
		height: 1.125rem;
	}

	.faculty[open] .faculty__toggle {
		background-color: var(--color-blue);
		color: var(--color-pure-white);
		rotate: 45deg;
	}

	.faculty__description {
		padding: 0 var(--space-5) var(--space-5);
		font-size: var(--font-size-md);
		line-height: 1.6rem;
		color: #2c3030;
	}

	@media (prefers-reduced-motion: no-preference) {
		.faculty {
			interpolate-size: allow-keywords;
		}

		.faculty::details-content {
			block-size: 0;
			overflow-y: clip;
			transition:
				block-size 0.4s var(--ease-out),
				content-visibility 0.4s allow-discrete;
		}

		.faculty[open]::details-content {
			block-size: auto;
		}
	}

	/* ----- Tarjetas: rankings y vida estudiantil ----- */
	.university-details__card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		padding: var(--space-6);
		border-radius: var(--radius-xl);
		background-color: var(--surface-white);
		box-shadow: 0 1.5rem 3rem -2.25rem rgb(18 91 168 / 0.55);
	}

	.university-details__card--life {
		background:
			radial-gradient(22rem 12rem at 100% 0%, rgb(251 189 29 / 0.18), transparent 70%),
			var(--surface-white);
	}

	.university-details__card-icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-pill);
		background: linear-gradient(135deg, var(--color-skyblue), var(--color-blue));
		color: var(--color-pure-white);
	}

	.university-details__card--life .university-details__card-icon {
		background: var(--color-yellow);
		color: #002546;
	}

	.university-details__card :global(.star-list) {
		padding-left: 0;
	}

	.university-details__card :global(.star-list__item) {
		align-items: flex-start;
		font-size: var(--font-size-md);
		line-height: 1.6rem;
	}

	.university-details__card :global(.star-list__icon) {
		width: 1.25rem;
		height: auto;
		margin-top: 0.2em;
	}

	/* ===== Tablet y móvil: una columna ===== */
	@media (max-width: 1100px) {
		.university-details__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.university-details__title {
			font-size: var(--font-size-title-mobile);
			line-height: var(--line-height-title-mobile);
		}

		.university-details__block-title {
			font-size: var(--font-size-card-title-mobile);
		}

		.faculty__name {
			font-size: var(--font-size-md);
		}

		.university-details__card {
			padding: var(--space-5);
			border-radius: var(--radius-lg);
		}
	}
</style>
