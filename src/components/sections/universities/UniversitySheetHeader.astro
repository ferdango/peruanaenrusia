---
/**
 * UniversitySheetHeader — Cabecera de la ficha de universidad
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Universidad Single" (3333:276) › "Frame 628450" (3333:275).
 *
 * Ilustración de la marca (edificio + onda + estrella), nombre de la
 * universidad (h1 de la página), píldora "Ir al sitio web" (solo si la
 * universidad tiene `website`) y botón ✕ que vuelve al listado.
 *
 * Uso (dentro de la hoja de src/pages/universidades/[slug].astro):
 *   <UniversitySheetHeader university={university} />
 */
import Icon from '@components/ui/Icon.astro';
import BuildingIllustration from '@assets/graphics/illustrations/university-building.svg';
import { routes } from '@data/navigation';
import type { University } from '@data/universities';

interface Props {
	university: University;
}

const { university } = Astro.props;

// ----- Contenido de la sección -----
const content = {
	website: 'Ir al sitio web',
	websiteHint: '(se abre en una pestaña nueva)',
	close: 'Cerrar y volver a todas las universidades',
};
---

<header class="university-header">
	<div class="university-header__main">
		<BuildingIllustration class="university-header__illustration" aria-hidden="true" />

		<div class="university-header__text">
			<h1 class="university-header__title">{university.name}</h1>
			{university.website && (
				<a
					href={university.website}
					class="university-header__website"
					target="_blank"
					rel="noopener"
				>
					<Icon name="external-link" size={16} />
					{content.website}
					<span class="visually-hidden">{content.websiteHint}</span>
				</a>
			)}
		</div>
	</div>

	<a href={routes.universities} class="university-header__close" aria-label={content.close}>
		<Icon name="close-line" size={28} />
	</a>
</header>

<style>
	.university-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-5);
		padding: 2.25rem var(--space-7) 0; /* 36px 40px */
	}

	.university-header__main {
		display: flex;
		align-items: flex-start;
		gap: var(--space-7); /* 40px */
	}

	/* Ilustración: 174 × 151 px (tamaño de Figma, sin deformar) */
	.university-header__illustration {
		flex: none;
		max-width: none;
		aspect-ratio: 174.121 / 151.472;
	}

	.university-header__text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3); /* 12px */
		max-width: 33.75rem; /* 540px */
	}

	.university-header__title {
		font-size: var(--font-size-h2); /* 40px */
		line-height: 1.1; /* 44px */
		color: var(--color-blue-title);
	}

	/* ----- Píldora "Ir al sitio web" ----- */
	.university-header__website {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem; /* 10px */
		padding: var(--space-2) var(--space-3); /* 8px 12px */
		border-radius: 1rem; /* 16px */
		background-color: var(--color-white);
		color: var(--color-blue-title);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-medium);
		line-height: 1.5rem;
		transition: background-color var(--duration-base) var(--ease-out);
	}

	.university-header__website:hover {
		background-color: color-mix(in srgb, var(--color-blue-title) 10%, var(--color-white));
	}

	/* ----- Botón ✕ (vuelve al listado) ----- */
	.university-header__close {
		display: grid;
		flex: none;
		place-items: center;
		width: 4rem; /* 64px */
		height: 4rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-white);
		color: var(--color-black);
		transition:
			background-color var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out);
	}

	.university-header__close:hover {
		background-color: color-mix(in srgb, var(--color-black) 8%, var(--color-white));
		transform: rotate(90deg);
	}

	/* ----- Tablet / móvil ----- */
	@media (max-width: 1100px) {
		.university-header__main {
			gap: var(--space-5);
		}

		.university-header__illustration {
			width: 7.5rem; /* 120px */
			height: auto;
		}
	}

	@media (max-width: 640px) {
		.university-header {
			padding: var(--space-5) var(--space-4) 0;
		}

		.university-header__main {
			flex-direction: column;
			gap: var(--space-3);
		}

		.university-header__illustration {
			width: 5.5rem; /* 88px */
		}

		.university-header__title {
			font-size: 1.75rem;
		}

		.university-header__close {
			width: 3rem;
			height: 3rem;
		}
	}
</style>
