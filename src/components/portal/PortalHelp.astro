---
/**
 * PortalHelp — tarjeta "¿Necesitas ayuda?"
 * --------------------------------------------------------------------------
 * Contacto directo con el equipo desde el portal: WhatsApp (píldora verde,
 * como en la pantalla de pago) y el correo con botón de copiar.
 *
 * El correo, el teléfono y el mensaje de WhatsApp salen de src/data/site.ts.
 *
 * Uso (columna lateral de "Mi proceso" y de los resultados del pago):
 *   <PortalHelp />
 *   <PortalHelp text="¿Dudas con tu transferencia? Escríbenos." />
 */
import Icon from '@components/ui/Icon.astro';
import CopyPill from './CopyPill.astro';
import { site, whatsappUrl } from '@data/site';

interface Props {
	/** Bajada bajo el título */
	text?: string;
}

// ----- Textos -----
const content = {
	title: '¿Necesitas ayuda?',
	text: 'Escríbenos y resolvemos tus dudas en cada paso de tu proceso.',
	whatsapp: 'Escríbenos por WhatsApp',
	newTab: '(se abre en una pestaña nueva)',
	email: 'O escríbenos al correo:',
	copyEmail: 'Copiar correo',
};

const { text = content.text } = Astro.props;
---

<section class="portal-help" aria-labelledby="portal-help-title">
	<h2 id="portal-help-title" class="portal-help__title">
		{content.title}
	</h2>
	<p class="portal-help__text">{text}</p>

	<a class="portal-help__whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
		<Icon name="whatsapp" size={22} />
		{content.whatsapp}
		<span class="visually-hidden">{content.newTab}</span>
	</a>

	<div class="portal-help__email">
		<p class="portal-help__email-label">{content.email}</p>
		<CopyPill value={site.contact.email} label={content.copyEmail} />
	</div>
</section>

<style>
	.portal-help {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		padding: var(--space-5) var(--space-6) var(--space-6);
		border: var(--portal-card-border);
		border-radius: var(--portal-radius-card);
		background-color: var(--portal-surface);
		box-shadow: var(--portal-card-shadow);
	}

	.portal-help__title {
		color: var(--color-blue-title);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
		line-height: 1.5rem;
	}

	.portal-help__text {
		margin-top: calc(-1 * var(--space-2));
		color: var(--portal-text-soft);
		font-size: var(--font-size-sm);
		line-height: 1.375rem;
	}

	.portal-help__whatsapp {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		width: 100%;
		min-height: 3rem;
		padding-inline: var(--space-4);
		border-radius: var(--radius-pill);
		background-color: var(--portal-whatsapp);
		color: var(--portal-text-button); /* texto oscuro: contraste AA sobre el verde */
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		transition:
			background-color var(--duration-base) var(--ease-out),
			translate var(--duration-base) var(--ease-out);
	}

	.portal-help__whatsapp:hover {
		background-color: color-mix(in srgb, var(--portal-whatsapp) 85%, var(--color-black));
		translate: 0 -1px;
	}

	.portal-help__whatsapp:focus-visible {
		outline: 3px solid var(--color-blue);
		outline-offset: 2px;
	}

	.portal-help__email {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		margin-top: var(--space-1);
	}

	.portal-help__email-label {
		color: var(--portal-text-soft);
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
	}
</style>
