---
/**
 * HomeHero — Portada inmersiva
 * --------------------------------------------------------------------------
 * Contenido del Figma (Home › "Frame 23": título, "Postular ahora" y video de
 * presentación) con el lenguaje visual del Manual de marca 2025:
 *   · Fondo azul de marca con el tubo degradé azul (render oficial de la marca;
 *     su fondo es #007cff, por eso el hero termina en ese tono exacto).
 *   · Estudiante en primer plano y tubo degradé rojo por delante: profundidad.
 *   · Titular con el lineamiento textual "Estudia en Rusia. Hazlo posible." y
 *     la línea plana amarilla bajo "posible".
 *   · Tarjetas flotantes: video, ruta Perú → Rusia y acompañamiento.
 *
 * Movimiento: entrada al cargar (CSS, abajo), flotación continua, parallax con
 * el puntero y con el scroll (src/scripts/home-motion.ts lee data-hero-scene y
 * escribe --px, --py y --hero-scroll). Con "reducir movimiento" todo es estático.
 *
 * VIDEO: "Ver video" y la tarjeta flotante abren el video destacado
 * (src/data/videos.ts › featuredVideo) en el modal con mini reproductor
 * (src/components/overlays/VideoModal.astro). Sin JavaScript, abren YouTube.
 */
import { Image } from 'astro:assets';

import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { studentAvatars } from '@data/benefits';
import { featuredVideo } from '@data/videos';
import { withBase } from '@utils/url';
import graduate from '@assets/images/overlays/auth-graduate.png';
import tubeScene from '@assets/graphics/tubes/tube-blue-scene.webp';
import tubeRed from '@assets/graphics/tubes/tube-red.webp';
import Star from '@assets/graphics/stars/star-4-point.svg';
import FlagPe from '@assets/graphics/flags/pe.svg';
import FlagRu from '@assets/graphics/flags/ru.svg';

// ----- Contenido de la sección -----
const content = {
	eyebrow: 'Convocatoria 2026 · Becas para estudiar en Rusia',
	/** Cada fila es una línea del titular; la palabra marcada lleva la línea amarilla */
	title: [
		[{ text: 'Estudia' }, { text: 'en' }, { text: 'Rusia.' }],
		[{ text: 'Hazlo' }, { text: 'posible.', highlight: true }],
	],
	subtitle:
		'Te acompañamos en cada paso para ganar tu beca y vivir la experiencia que transformará tu vida.',
	cta: 'Postular ahora',
	videoCta: 'Ver video',
	proof: '+100 estudiantes cambiaron sus vidas',
	video: {
		title: '¿Quieres conocernos?',
		text: 'Mira el video completo y obtén beneficios adicionales',
	},
	route: { from: 'Perú', to: 'Rusia', text: 'Tu futuro, sin fronteras' },
	badge: { title: 'Te acompañamos', text: 'en cada paso del proceso' },
	scroll: 'Descubre más',
	graduateAlt: 'Estudiante graduado con toga y birrete',
};

/** Palabras del titular con su orden (retraso escalonado de la animación) */
let wordIndex = 0;
const titleLines = content.title.map((line) => line.map((word) => ({ ...word, index: wordIndex++ })));
const titleText = content.title.map((line) => line.map((word) => word.text).join(' ')).join(' ');

/** Enlace que abre el video destacado en el modal (sin JavaScript: YouTube) */
const videoLink = {
	href: featuredVideo.url,
	target: '_blank',
	rel: 'noopener',
	'data-video-open': '',
	'data-video-youtube': featuredVideo.youtubeId,
	'data-video-title': featuredVideo.title,
};
---

<section class="home-hero" aria-labelledby="home-hero-title" data-hero>
	<div class="home-hero__inner">
		<!-- ===== Texto ===== -->
		<div class="home-hero__content">
			<p class="hero-eyebrow">
				<Star class="hero-eyebrow__star" aria-hidden="true" />
				{content.eyebrow}
			</p>

			<h1 id="home-hero-title" class="hero-title" aria-label={titleText}>
				{titleLines.map((line) => (
					<span class="hero-title__line" aria-hidden="true">
						{line.map((word) => (
							<Fragment>
								{word.highlight ? (
									<span class="hero-title__highlight">
										<span class="hero-title__word">
											<span class="hero-title__word-inner" style={`--i: ${word.index}`}>
												{word.text}
											</span>
										</span>
										<svg
											class="hero-title__underline"
											viewBox="0 0 320 28"
											preserveAspectRatio="none"
											fill="none"
										>
											<path
												d="M4 19C58 7 108 25 164 15S262 5 316 13"
												pathLength="1"
												stroke="currentColor"
												stroke-width="7"
												stroke-linecap="round"
											/>
										</svg>
									</span>
								) : (
									<span class="hero-title__word">
										<span class="hero-title__word-inner" style={`--i: ${word.index}`}>
											{word.text}
										</span>
									</span>
								)}{' '}
							</Fragment>
						))}
					</span>
				))}
			</h1>

			<p class="hero-subtitle">{content.subtitle}</p>

			<div class="hero-actions">
				<Button
					variant="primary"
					size="md"
					class="hero-actions__cta"
					data-dialog-open="auth-modal"
					data-magnetic
				>
					{content.cta}
				</Button>
				<a class="hero-play" {...videoLink} data-magnetic>
					<span class="hero-play__icon" aria-hidden="true">
						<Icon name="play" size={16} />
					</span>
					<span>{content.videoCta}</span>
					<span class="hero-play__duration">{featuredVideo.duration}</span>
				</a>
			</div>

			<div class="hero-proof">
				<ul class="hero-proof__avatars" role="list" aria-hidden="true">
					{studentAvatars.map((avatar) => (
						<li>
							<Image src={avatar} alt="" width={44} height={44} class="hero-proof__avatar" />
						</li>
					))}
				</ul>
				<p class="hero-proof__text">{content.proof}</p>
			</div>
		</div>

		<!-- ===== Escena (capas con profundidad) ===== -->
		<div class="hero-scene" data-hero-scene>
			<div class="hero-scene__layer hero-scene__tube" style="--depth: 0.35" aria-hidden="true">
				<Image
					src={tubeScene}
					alt=""
					widths={[960, 1600, 2400]}
					sizes="(max-width: 1023px) 190vw, 80vw"
					loading="eager"
					class="hero-scene__tube-image"
				/>
			</div>

			<div class="hero-scene__layer hero-scene__person" style="--depth: 0.7">
				<Image
					src={graduate}
					alt={content.graduateAlt}
					widths={[480, 768, 1024]}
					sizes="(max-width: 1023px) 70vw, 34vw"
					loading="eager"
					fetchpriority="high"
					class="hero-scene__person-image"
				/>
			</div>

			<div class="hero-scene__layer hero-scene__tube-red" style="--depth: 1.25" aria-hidden="true">
				<Image
					src={tubeRed}
					alt=""
					widths={[640, 1200, 1800]}
					sizes="(max-width: 1023px) 90vw, 42vw"
					loading="eager"
					class="hero-scene__tube-red-image"
				/>
			</div>

			<Star class="hero-star hero-star--yellow" aria-hidden="true" />
			<Star class="hero-star hero-star--sky" aria-hidden="true" />
			<Star class="hero-star hero-star--white" aria-hidden="true" />

			<!-- Tarjetas flotantes -->
			<div class="hero-float hero-float--route" style="--depth: 1" aria-hidden="true">
				<span class="hero-route__flags">
					<FlagPe class="hero-route__flag" />
					<svg class="hero-route__path" viewBox="0 0 48 16" fill="none">
						<path
							d="M2 12C14 2 34 2 46 12"
							stroke="currentColor"
							stroke-width="2"
							stroke-dasharray="3 4"
						/>
					</svg>
					<FlagRu class="hero-route__flag" />
				</span>
				<span class="hero-float__text">
					<strong>
						{content.route.from} → {content.route.to}
					</strong>
					<small>{content.route.text}</small>
				</span>
			</div>

			<a class="hero-float hero-float--video" style="--depth: 1.1" {...videoLink}>
				<span class="hero-video-card__thumb">
					<Image
						src={featuredVideo.cover}
						alt=""
						width={176}
						height={99}
						widths={[176, 352]}
						sizes="88px"
						class="hero-video-card__image"
					/>
					<span class="hero-video-card__play" aria-hidden="true">
						<Icon name="play" size={14} />
					</span>
					<span class="hero-video-card__duration">{featuredVideo.duration}</span>
				</span>
				<span class="hero-float__text">
					<strong>{content.video.title}</strong>
					<small>{content.video.text}</small>
				</span>
			</a>

			<div class="hero-float hero-float--badge" style="--depth: 0.9" aria-hidden="true">
				<span class="hero-badge__icon">
					<Icon name="check" size={18} />
				</span>
				<span class="hero-float__text">
					<strong>{content.badge.title}</strong>
					<small>{content.badge.text}</small>
				</span>
			</div>
		</div>
	</div>

	<a class="hero-scroll" href={withBase('/#acompanamiento')}>
		<span class="hero-scroll__line" aria-hidden="true"></span>
		{content.scroll}
	</a>
</section>

<style>
	.home-hero {
		/* Fondo del render del tubo azul (equivale al azul de marca #007afc) */
		--hero-blue: #007cff;
		/* Distancia del contenido al borde de la pantalla (para que el tubo sangre) */
		--hero-bleed: max(var(--gutter), calc((100vw - var(--container-max)) / 2));
		--hero-ink: #0b1f3a; /* Texto de las tarjetas blancas */

		position: relative;
		isolation: isolate;
		/* El header (transparente en el Home) queda encima del hero */
		margin-top: calc(-1 * var(--header-height));
		padding-top: var(--header-height);
		overflow: clip;
		/* Azul más profundo detrás del texto (contraste AA) que termina en el tono del render */
		background: linear-gradient(100deg, #0052c4 0%, #0066e8 35%, var(--hero-blue) 66%);
		color: var(--color-pure-white);
	}

	.home-hero__inner {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
		gap: var(--space-6);
		max-width: var(--container-max);
		min-height: clamp(38rem, calc(100svh - var(--header-height)), 54rem);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	/* ===== Texto ===== */
	.home-hero__content {
		position: relative;
		z-index: 3;
		align-self: center;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-5);
		padding-block: var(--space-8) var(--space-10);
		/* Al bajar, el texto sube y se desvanece (src/scripts/home-motion.ts) */
		transform: translate3d(0, calc(var(--hero-scroll, 0) * -5rem), 0);
		opacity: calc(1 - var(--hero-scroll, 0) * 1.2);
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.5rem 1rem 0.5rem 0.75rem;
		border: 1px solid rgb(255 255 255 / 0.32);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.1);
		backdrop-filter: blur(10px);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		line-height: 1.25rem;
	}

	.hero-eyebrow__star {
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
		color: var(--color-yellow);
	}

	/* Titular: Poppins Bold, muy grande y compacto (más chico en pantallas bajas) */
	.hero-title {
		font-size: clamp(2.875rem, min(1.1rem + 5vw, 1rem + 8.5vh), 6rem);
		font-weight: var(--font-weight-bold);
		line-height: 0.98;
		letter-spacing: -0.035em;
		color: var(--color-pure-white);
	}

	.hero-title__line {
		display: block;
	}

	/* Cada palabra sube desde detrás de una "ventana" (overflow: clip) */
	.hero-title__word {
		display: inline-block;
		overflow: clip;
		padding-bottom: 0.1em;
		margin-bottom: -0.1em;
		vertical-align: top;
	}

	.hero-title__word-inner {
		display: inline-block;
	}

	.hero-title__highlight {
		position: relative;
		display: inline-block;
		color: var(--color-pure-white);
	}

	/* Línea plana amarilla de la marca bajo "posible" */
	.hero-title__underline {
		position: absolute;
		left: -2%;
		bottom: -0.16em;
		width: 104%;
		height: 0.3em;
		color: var(--color-yellow);
		overflow: visible;
	}

	.hero-subtitle {
		max-width: 34rem;
		font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.25rem);
		line-height: 1.6;
		color: var(--color-pure-white);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-5);
		margin-top: var(--space-2);
	}

	.hero-actions :global(.hero-actions__cta) {
		min-width: 13.5rem;
		box-shadow: 0 18px 36px -16px rgb(251 189 29 / 0.7);
	}

	/* "Ver video": círculo con ▶ y anillo que late */
	.hero-play {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 3.75rem;
		padding: 0 var(--space-2) 0 0;
		color: var(--color-pure-white);
		font-weight: var(--font-weight-semibold);
	}

	.hero-play__icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border: 1.5px solid rgb(255 255 255 / 0.7);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.14);
		transition:
			background-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out);
	}

	.hero-play__icon::after {
		content: '';
		position: absolute;
		inset: -1px;
		border: 1.5px solid rgb(255 255 255 / 0.6);
		border-radius: inherit;
		opacity: 0;
	}

	.hero-play__duration {
		padding: 0.125rem 0.5rem;
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.16);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-medium);
		line-height: 1.25rem;
	}

	.hero-play:hover .hero-play__icon {
		background-color: var(--color-pure-white);
		color: var(--color-blue);
	}

	.hero-proof {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-3);
	}

	.hero-proof__avatars {
		display: flex;
	}

	.hero-proof__avatars li + li {
		margin-left: -0.75rem;
	}

	.hero-proof__avatar {
		display: block;
		width: 2.75rem;
		height: 2.75rem;
		border: 2px solid #0058cf;
		border-radius: var(--radius-pill);
	}

	.hero-proof__text {
		max-width: 12rem;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		line-height: 1.25rem;
	}

	/* ===== Escena ===== */
	.hero-scene {
		position: relative;
		z-index: 2;
		align-self: stretch;
		min-height: 32rem;
		/* Al bajar, la escena se queda atrás (más lenta que el texto) */
		transform: translate3d(0, calc(var(--hero-scroll, 0) * 3rem), 0);
	}

	/* Cada capa se mueve con el puntero según su profundidad (--depth) */
	.hero-scene__layer,
	.hero-float,
	.hero-star {
		transform: translate3d(
			calc(var(--px, 0) * var(--depth, 0.5) * 1px),
			calc(var(--py, 0) * var(--depth, 0.5) * 1px),
			0
		);
	}

	.hero-scene__layer {
		position: absolute;
		pointer-events: none;
	}

	/* Tubo azul: grande, detrás del estudiante y sangrando hacia la derecha y hacia
	   abajo. Donde el fondo ya es #007cff (derecha) se ve entero; hacia la
	   izquierda y arriba se funde con el degradado (sin costuras) */
	.hero-scene__tube {
		z-index: 0;
		right: calc(-1 * var(--hero-bleed) - 12vw);
		bottom: -7%;
		width: clamp(46rem, 90vw, 104rem);
		mask-image:
			linear-gradient(to right, transparent 0%, #000 42%),
			linear-gradient(to bottom, transparent 0%, #000 14%);
		mask-composite: intersect;
	}

	.hero-scene__tube-image,
	.hero-scene__tube-red-image {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Estudiante: de pie sobre el borde inferior, centrado en la escena */
	.hero-scene__person {
		z-index: 2;
		inset: auto 0 0;
		display: flex;
		justify-content: center;
		height: 96%;
	}

	.hero-scene__person-image {
		display: block;
		width: auto;
		max-width: none;
		height: 100%;
		filter: drop-shadow(0 32px 48px rgb(0 18 70 / 0.35));
	}

	/* Tubo rojo por delante del estudiante */
	.hero-scene__tube-red {
		z-index: 3;
		right: -12%;
		bottom: 5%;
		width: 62%;
		rotate: -8deg;
		filter: drop-shadow(0 24px 32px rgb(120 0 20 / 0.28));
	}

	/* Estrellas de la marca */
	.hero-star {
		position: absolute;
		z-index: 4;
		pointer-events: none;
	}

	.hero-star--yellow {
		top: 19%;
		right: 6%;
		width: 2.25rem;
		height: 2.25rem;
		color: var(--color-yellow);
		--depth: 1.5;
	}

	.hero-star--sky {
		top: 44%;
		left: 6%;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--color-skyblue);
		--depth: 1.8;
	}

	.hero-star--white {
		top: 30%;
		left: 22%;
		width: 1rem;
		height: 1rem;
		color: var(--color-pure-white);
		--depth: 2.2;
	}

	/* ----- Tarjetas flotantes (blancas, legibles sobre el azul) ----- */
	.hero-float {
		position: absolute;
		z-index: 5;
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: 0.75rem 1rem;
		border: 1px solid rgb(255 255 255 / 0.7);
		border-radius: 1.25rem;
		background-color: rgb(255 255 255 / 0.9);
		backdrop-filter: blur(16px) saturate(1.4);
		box-shadow: 0 24px 48px -20px rgb(0 22 80 / 0.55);
		color: var(--hero-ink);
	}

	.hero-float__text {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		text-align: left;
	}

	.hero-float__text strong {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		line-height: 1.25rem;
	}

	.hero-float__text small {
		font-size: var(--font-size-xs);
		line-height: 1rem;
		color: rgb(11 31 58 / 0.72);
	}

	.hero-float--route {
		top: 7%;
		right: 0;
	}

	.hero-route__flags {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--color-blue);
	}

	.hero-route__flag {
		width: 1.75rem;
		height: 1.75rem;
		border-radius: var(--radius-pill);
	}

	.hero-route__path {
		width: 2.25rem;
		height: 0.75rem;
	}

	.hero-float--video {
		bottom: 9%;
		left: -6%;
		max-width: 19rem;
		padding: 0.5rem 1rem 0.5rem 0.5rem;
		transition:
			box-shadow var(--duration-base) var(--ease-out),
			background-color var(--duration-base) var(--ease-out);
	}

	.hero-float--video:hover {
		background-color: var(--color-pure-white);
		box-shadow: 0 28px 56px -18px rgb(0 22 80 / 0.7);
	}

	.hero-video-card__thumb {
		position: relative;
		flex-shrink: 0;
		overflow: hidden;
		width: 5.5rem;
		aspect-ratio: 16 / 9;
		border-radius: 0.75rem;
	}

	.hero-video-card__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale var(--duration-slow) var(--ease-out);
	}

	.hero-float--video:hover .hero-video-card__image {
		scale: 1.08;
	}

	.hero-video-card__play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background-color: rgb(0 40 120 / 0.35);
		color: var(--color-pure-white);
	}

	.hero-video-card__duration {
		position: absolute;
		right: 0.25rem;
		bottom: 0.25rem;
		padding: 0 0.25rem;
		border-radius: 0.25rem;
		background-color: rgb(0 0 0 / 0.72);
		font-size: 0.625rem;
		font-weight: var(--font-weight-semibold);
		line-height: 0.875rem;
		color: var(--color-pure-white);
	}

	.hero-float--badge {
		top: 38%;
		left: -4%;
	}

	.hero-badge__icon {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-green);
		color: var(--color-pure-white);
	}

	/* ===== "Descubre más" ===== */
	.hero-scroll {
		position: absolute;
		z-index: 6;
		left: var(--hero-bleed);
		bottom: var(--space-6);
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		font-size: var(--font-size-xs);
