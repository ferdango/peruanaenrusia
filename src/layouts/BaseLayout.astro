---
/**
 * BaseLayout
 * --------------------------------------------------------------------------
 * Estructura HTML mínima compartida por TODAS las páginas:
 * <head> (SEO, redes sociales, datos estructurados, favicon) + estilos globales.
 *
 * No incluye header ni footer: para el sitio público usa SiteLayout y para el
 * portal del estudiante usa PortalLayout (ambos envuelven a este layout).
 *
 * SEO incluido en cada página:
 *   - <title> y descripción, URL canónica, robots e idioma (es-PE). La
 *     dirección temporal de GitHub Pages no se indexa (src/lib/seo/indexing.ts).
 *   - Open Graph y Twitter Card con imagen optimizada de 1200 × 630.
 *   - Datos estructurados JSON-LD: organización y sitio web (siempre) más los
 *     que pase cada página (`jsonLd`: artículo, video, universidad…).
 *   - Enlaces a sitemap, RSS del blog y manifiesto web.
 */

// Fuente Poppins autoalojada (sin peticiones a Google): solo los pesos usados.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/400-italic.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';

import '@styles/global.css';

import { site } from '@data/site';
import type { ImageSource } from '@lib/content/images';
import { isIndexable } from '@lib/seo/indexing';
import { organizationSchema, serializeJsonLd, websiteSchema, type JsonLd } from '@lib/seo/schema';
import { shareImageUrl } from '@lib/seo/share-image';
import { withBase } from '@utils/url';

export interface Props {
	/** Título de la página (se completa con " | Peruana en Rusia") */
	title?: string;
	/** Descripción para buscadores y redes sociales (ideal: 70–160 caracteres) */
	description?: string;
	/** Imagen para compartir en redes (local, remota o ruta). Se recorta a 1200 × 630 */
	image?: ImageSource | string;
	/** Texto alternativo de la imagen para compartir */
	imageAlt?: string;
	/** true = la página no se indexa en buscadores (ej. portal, 404) */
	noindex?: boolean;
	/** Tipo de página para Open Graph */
	type?: 'website' | 'article';
	/** Datos de artículo (fechas AAAA-MM-DD, autor y categoría) */
	article?: {
		publishedTime: string;
		modifiedTime?: string;
		author?: string;
		section?: string;
	};
	/** Datos estructurados propios de la página (se suman a los globales) */
	jsonLd?: JsonLd[];
	/** Clase extra para el <body> (ej. para cambiar el fondo de la página) */
	bodyClass?: string;
}

const {
	title,
	description = site.description,
	image,
	imageAlt,
	noindex = false,
	type = 'website',
	article,
	jsonLd = [],
	bodyClass,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const indexable = !noindex && isIndexable(Astro.site);

// ----- Imagen para compartir: siempre 1200 × 630 (JPG) -----
const ogImage = await shareImageUrl(image, Astro.site);
const ogImageAlt = imageAlt ?? `${site.name} — ${site.tagline}`;

// ----- Datos estructurados -----
const logoUrl = new URL(withBase('/apple-touch-icon.png'), Astro.site).href;
const structuredData = [organizationSchema(Astro.site, logoUrl), websiteSchema(Astro.site), ...jsonLd];
---

<!doctype html>
<html lang="es-PE">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta
			name="robots"
			content={
				indexable
					? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
					: 'noindex, nofollow'
			}
		/>

		<!-- Idioma: el sitio está en español (Perú). Las versiones en otros idiomas se agregan aquí -->
		<link rel="alternate" hreflang="es-PE" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

		<!-- Ícono del sitio: símbolo de la marca -->
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
		<link rel="manifest" href={withBase('/site.webmanifest')} />
		<meta name="theme-color" content="#171a1a" />
		<meta name="format-detection" content="telephone=no" />

		<!-- Mapa del sitio y RSS del blog -->
		<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`Blog de ${site.name}`}
			href={withBase('/rss.xml')}
		/>

		<!-- Open Graph (vista previa al compartir en redes sociales) -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		{article && (
			<Fragment>
				<meta property="article:published_time" content={article.publishedTime} />
				<meta
					property="article:modified_time"
					content={article.modifiedTime ?? article.publishedTime}
				/>
				{article.author && <meta property="article:author" content={article.author} />}
				{article.section && <meta property="article:section" content={article.section} />}
			</Fragment>
		)}

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Datos estructurados (schema.org) -->
		<script type="application/ld+json" is:inline set:html={serializeJsonLd(structuredData)} />
		<slot name="head" />
	</head>

	<body class={bodyClass}>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>
		<slot />
	</body>
</html>
