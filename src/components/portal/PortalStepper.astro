---
/**
 * PortalStepper — progreso "Registro → Pago → Mi Proceso"
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "MacBook Pro 14' - 7" › stepper (2252:573, paso 2
 * activo) y "MacBook Pro 14' - 12" › stepper (2267:701, paso 3 activo).
 *
 * Va sobre la banda azul de la marca (PortalLayout), en una píldora de vidrio.
 * Estados de cada paso (se calculan a partir de `current`):
 *   done    → círculo celeste con check (pasos anteriores)
 *   active  → círculo blanco con el número y anillo amarillo (paso actual)
 *   pending → círculo vacío translúcido (pasos siguientes)
 * La línea que llega a un paso se pinta de celeste si ese paso ya se alcanzó.
 *
 * Los pasos y sus enlaces viven en src/data/portal.ts (portalSteps).
 *
 * Uso (ya lo incluye PortalLayout con la prop `currentStep`):
 *   <PortalStepper current="payment" />
 */
import Icon from '@components/ui/Icon.astro';
import { portalSteps, type PortalStepId } from '@data/portal';

interface Props {
	/** Paso actual */
	current: PortalStepId;
}

const { current } = Astro.props;

type StepState = 'done' | 'active' | 'pending';

const currentIndex = portalSteps.findIndex((step) => step.id === current);

/** Texto para lectores de pantalla según el estado */
const stateLabels: Record<StepState, string> = {
	done: 'completado',
	active: 'paso actual',
	pending: 'pendiente',
};

const steps = portalSteps.map((step, index) => ({
	...step,
	number: index + 1,
	state: (index < currentIndex ? 'done' : index === currentIndex ? 'active' : 'pending') as StepState,
}));
---

<nav class="portal-stepper" aria-label="Progreso de tu inscripción">
	<ol class="portal-stepper__list" role="list">
		{steps.map((step) => {
			const Tag = step.href ? 'a' : 'span';
			return (
				<li class:list={['portal-stepper__item', `portal-stepper__item--${step.state}`]}>
					<Tag
						class="portal-stepper__step"
						href={step.href}
						aria-current={step.state === 'active' ? 'step' : undefined}
					>
						<span class="portal-stepper__circle" aria-hidden="true">
							{step.state === 'done' ? <Icon name="check" size={24} /> : step.number}
						</span>
						<span class="portal-stepper__label">
							{step.label}
							<span class="visually-hidden">({stateLabels[step.state]})</span>
						</span>
					</Tag>
				</li>
			);
		})}
	</ol>
</nav>

<style>
	.portal-stepper {
		--stepper-column: 8.5rem; /* distancia entre centros de círculo */
		--stepper-circle: 2.75rem; /* 44px */
		--stepper-line: 3px;

		padding: var(--space-4) var(--space-3) var(--space-3);
		border: 1px solid rgb(255 255 255 / 0.16);
		border-radius: var(--radius-xl);
		background-color: rgb(255 255 255 / 0.07);
		backdrop-filter: blur(10px);
	}

	.portal-stepper__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, var(--stepper-column)));
		justify-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.portal-stepper__item {
		--step-label: var(--color-pure-white);
		--step-line: var(--color-skyblue);
		--step-fill: var(--color-skyblue);
		--step-border: var(--color-skyblue);
		--step-number: #002546;

		position: relative;
		display: flex;
		justify-content: center;
	}

	.portal-stepper__item--active {
		--step-fill: var(--color-pure-white);
		--step-border: var(--color-pure-white);
		--step-number: var(--color-blue-title);
	}

	.portal-stepper__item--pending {
		--step-label: rgb(255 255 255 / 0.6);
		--step-line: rgb(255 255 255 / 0.2);
		--step-fill: transparent;
		--step-border: rgb(255 255 255 / 0.35);
		--step-number: rgb(255 255 255 / 0.7);
	}

	/* Línea que une el círculo anterior con el actual */
	.portal-stepper__item + .portal-stepper__item::before {
		content: '';
		position: absolute;
		top: calc((var(--stepper-circle) - var(--stepper-line)) / 2);
		left: calc(-50% + var(--stepper-circle) / 2 + 0.375rem);
		right: calc(50% + var(--stepper-circle) / 2 + 0.375rem);
		height: var(--stepper-line);
		border-radius: var(--radius-pill);
		background-color: var(--step-line);
	}

	.portal-stepper__step {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		color: var(--step-label);
	}

	.portal-stepper__circle {
		display: grid;
		place-items: center;
		width: var(--stepper-circle);
		height: var(--stepper-circle);
		border: 2px solid var(--step-border);
		border-radius: var(--radius-pill);
		background-color: var(--step-fill);
		color: var(--step-number);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
		line-height: 1;
		transition: scale var(--duration-base) var(--ease-out);
	}

	.portal-stepper__circle :global(svg) {
		width: 1.25rem;
		height: 1.25rem;
	}

	/* Paso actual: anillo amarillo */
	.portal-stepper__item--active .portal-stepper__circle {
		box-shadow:
			0 0 0 4px rgb(251 189 29 / 0.9),
			0 0.75rem 1.5rem -0.5rem rgb(0 0 0 / 0.45);
	}

	.portal-stepper__label {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		line-height: 1.25rem;
		text-align: center;
		white-space: nowrap;
	}

	a.portal-stepper__step:hover .portal-stepper__circle {
		scale: 1.06;
	}

	a.portal-stepper__step:hover .portal-stepper__label {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	a.portal-stepper__step:focus-visible {
		border-radius: var(--radius-md);
		outline: 2px solid var(--color-yellow);
		outline-offset: 4px;
	}

	@media (max-width: 640px) {
		.portal-stepper {
			--stepper-circle: 2.25rem;

			width: 100%;
		}

		.portal-stepper__list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.portal-stepper__circle {
			font-size: var(--font-size-md);
		}

		.portal-stepper__label {
			font-size: var(--font-size-xs);
		}
	}
</style>
