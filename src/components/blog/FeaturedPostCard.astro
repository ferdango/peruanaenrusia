---
/**
 * FeaturedPostCard
 * --------------------------------------------------------------------------
 * Tarjeta de una publicación del blog para "Novedades": miniatura 16:9 (con
 * ▶ y duración si es un video), categoría, fecha, título y resumen.
 * Toda la tarjeta es clicable.
 *
 * Con `modal`, los videos se reproducen en el modal del sitio
 * (src/components/overlays/VideoModal.astro, que debe estar en la página);
 * sin JavaScript, y en los artículos, lleva a /blog/{slug}/.
 *
 * Uso:
 *   <FeaturedPostCard post={post} modal />
 */
import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import type { BlogPost } from '@data/blog';
import { detailRoutes } from '@data/navigation';
import { formatDate } from '@utils/format';

interface Props {
	post: BlogPost;
	headingLevel?: 'h2' | 'h3';
	/** true = los videos se reproducen en el modal del sitio */
	modal?: boolean;
	class?: string;
}

const { post, headingLevel: Heading = 'h3', modal = false, class: className } = Astro.props;

const video = post.type === 'video' ? post.video : undefined;
const summary = post.type === 'video' ? post.video.description : post.article.excerpt;
const category = video ? 'Videoblog' : post.category;
const modalAttributes =
	modal && video?.youtubeId
		? { 'data-video-open': '', 'data-video-youtube': video.youtubeId, 'data-video-title': video.title }
		: {};
---

<article class:list={['post-tile', { 'post-tile--video': video }, className]}>
	<div class="post-tile__media">
		<MediaImage
			image={post.image}
			alt=""
			widths={[400, 800]}
			sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 432px"
			class="post-tile__image"
		/>
		{video && (
			<span class="post-tile__play" aria-hidden="true">
				<Icon name="play" size={20} />
			</span>
		)}
		{video?.duration && (
			<span class="post-tile__duration" aria-hidden="true">
				{video.duration}
			</span>
		)}
	</div>

	<div class="post-tile__body">
		<p class="post-tile__meta">
			<span class="post-tile__category">
				{video && <Icon name="youtube-play" size={14} class="post-tile__category-icon" />}
				{category}
			</span>
			<time datetime={post.date}>{formatDate(post.date)}</time>
		</p>
		<Heading class="post-tile__title">
			<a href={detailRoutes.blogPost(post.slug)} class="post-tile__link" {...modalAttributes}>
				{video && <span class="visually-hidden">Video: </span>}
				{post.title}
			</a>
		</Heading>
		{summary && <p class="post-tile__text">{summary}</p>}
	</div>
</article>

<style>
	.post-tile {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: clip;
		border: 1px solid rgb(255 255 255 / 0.08);
		border-radius: var(--radius-xl);
		background-color: var(--surface-dark-raised);
		color: var(--text-on-dark);
		transition:
			border-color var(--duration-base) var(--ease-out),
			box-shadow 0.6s var(--ease-out);
	}

	.post-tile:hover {
		border-color: rgb(255 255 255 / 0.18);
		box-shadow: 0 2rem 4rem -2rem rgb(0 0 0 / 0.8);
	}

	.post-tile__media {
		position: relative;
		overflow: clip;
		aspect-ratio: 16 / 9;
	}

	.post-tile__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.8s var(--ease-out);
	}

	.post-tile:hover .post-tile__image {
		scale: 1.05;
	}

	.post-tile__play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		box-shadow:
			0 0 0 0.5rem rgb(255 255 255 / 0.25),
			0 1rem 2rem -0.75rem rgb(0 0 0 / 0.6);
		color: var(--color-blue);
		translate: -50% -50%;
		transition: scale var(--duration-slow) var(--ease-out);
	}

	.post-tile__play :global(svg) {
		margin-left: 0.1875rem;
	}

	.post-tile:hover .post-tile__play {
		scale: 1.1;
	}

	.post-tile__duration {
		position: absolute;
		right: var(--space-3);
		bottom: var(--space-3);
		padding: 0.25rem 0.5rem;
		border-radius: 0.5rem;
		background-color: rgb(0 0 0 / 0.72);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		font-variant-numeric: tabular-nums;
		line-height: 1rem;
		color: var(--color-pure-white);
	}

	.post-tile__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-5) var(--space-5) var(--space-6);
	}

	.post-tile__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-3);
		font-size: 0.8125rem;
		color: rgb(244 244 244 / 0.7);
	}

	.post-tile__category {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.1875rem 0.625rem;
		border: 1px solid rgb(255 255 255 / 0.16);
		border-radius: var(--radius-pill);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
		color: var(--color-pure-white);
	}

	.post-tile__category :global(.post-tile__category-icon) {
		color: var(--color-red);
	}

	.post-tile__title {
		font-size: clamp(1.125rem, 1rem + 0.35vw, 1.3125rem);
		font-weight: var(--font-weight-bold);
		line-height: 1.3;
		text-wrap: balance;
	}

	.post-tile__text {
		display: -webkit-box;
		overflow: hidden;
		font-size: var(--font-size-sm);
		line-height: 1.375rem;
		color: rgb(244 244 244 / 0.75);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	/* Toda la tarjeta es clicable */
	.post-tile__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 3;
		border-radius: inherit;
	}

	.post-tile__link:focus-visible {
		outline: none;
	}

	.post-tile:has(.post-tile__link:focus-visible) {
		outline: 3px solid var(--color-skyblue);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.post-tile {
			border-radius: var(--radius-lg);
		}

		.post-tile__body {
			padding: var(--space-4) var(--space-4) var(--space-5);
		}

		.post-tile__title {
			font-size: var(--font-size-card-title-mobile);
		}
	}
</style>
