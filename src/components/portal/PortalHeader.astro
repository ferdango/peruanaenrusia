---
/**
 * PortalHeader — barra superior del portal del estudiante
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "MacBook Pro 14' - 7" › header (1975:126). Se repite
 * igual en todas las pantallas del portal (2045:365, 2075:465, 2113:147, 2026:240).
 *
 * Va sobre la banda azul de la marca (PortalLayout): logo en blanco,
 * "Volver al sitio", el saludo con la inicial del estudiante y el botón
 * "Salir" (cierra la sesión).
 *
 * El nombre sale de la sesión del estudiante (Astro.locals.user, ver
 * src/middleware.ts); si no hay sesión se usa el nombre de ejemplo de
 * src/data/portal.ts.
 *
 * Uso (ya lo incluye PortalLayout):
 *   <PortalHeader />
 */
import Logo from '@components/brand/Logo.astro';
import Icon from '@components/ui/Icon.astro';
import { routes } from '@data/navigation';
import { portalRoutes, student } from '@data/portal';

// ----- Textos -----
const content = {
	greeting: 'Hola,',
	homeLabel: 'Peruana en Rusia — ir al inicio',
	site: 'Volver al sitio',
	logout: 'Salir',
	logoutLabel: 'Cerrar sesión',
};

/** Primer nombre del estudiante con sesión iniciada */
const firstName = Astro.locals.user?.name.trim().split(/\s+/)[0] || student.firstName;
const initial = firstName.charAt(0).toUpperCase();
---

<header class="portal-header container">
	<a class="portal-header__logo" href={routes.home} aria-label={content.homeLabel}>
		<Logo variant="horizontal" color="mono" width={132} />
	</a>

	<div class="portal-header__actions">
		<a class="portal-header__site" href={routes.home}>
			<Icon name="arrow-left" size={16} />
			{content.site}
		</a>

		<div class="portal-header__user">
			<span class="portal-header__avatar" aria-hidden="true">
				{initial}
			</span>
			<p class="portal-header__greeting">
				{content.greeting}
				<strong class="portal-header__name">{firstName}</strong>
			</p>
		</div>

		<!-- Cierra la sesión en el servidor antes de salir (src/scripts/portal-nav.ts) -->
		<a
			class="portal-header__logout"
			href={portalRoutes.logout}
			title={content.logoutLabel}
			data-portal-logout
		>
			<Icon name="logout" size={20} />
			<span class="portal-header__logout-text">{content.logout}</span>
			<span class="visually-hidden"> ({content.logoutLabel.toLowerCase()})</span>
		</a>
	</div>
</header>

<script>
	import { initPortalNav } from '@scripts/portal-nav';

	initPortalNav();
</script>

<style>
	.portal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 4.75rem;
		padding-block: var(--space-3);
		border-bottom: 1px solid rgb(255 255 255 / 0.12);
		color: var(--color-pure-white);
	}

	.portal-header__logo {
		display: block;
		flex-shrink: 0;
	}

	.portal-header__logo :global(.logo) {
		display: block;
		height: auto;
	}

	.portal-header__actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	/* "Volver al sitio" */
	.portal-header__site {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		color: rgb(255 255 255 / 0.82);
		transition: color var(--duration-base) var(--ease-out);
	}

	.portal-header__site :global(svg) {
		transition: translate var(--duration-base) var(--ease-out);
	}

	.portal-header__site:hover {
		color: var(--color-pure-white);
	}

	.portal-header__site:hover :global(svg) {
		translate: -3px 0;
	}

	/* ----- Saludo + avatar ----- */
	.portal-header__user {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: 0.25rem 1rem 0.25rem 0.25rem;
		border: 1px solid rgb(255 255 255 / 0.18);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.08);
	}

	.portal-header__avatar {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 2.5rem; /* 40px */
		height: 2.5rem;
		border-radius: var(--radius-pill);
		background: linear-gradient(135deg, var(--color-yellow), var(--color-orange));
		color: #002546;
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
	}

	.portal-header__greeting {
		display: flex;
		gap: 0.3em;
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
		color: rgb(255 255 255 / 0.82);
		white-space: nowrap;
	}

	.portal-header__name {
		max-width: 9rem;
		overflow: hidden;
		font-weight: var(--font-weight-semibold);
		color: var(--color-pure-white);
		text-overflow: ellipsis;
	}

	/* "Salir" */
	.portal-header__logout {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.75rem;
		padding: 0 var(--space-4);
		border: 1px solid rgb(255 255 255 / 0.28);
		border-radius: var(--radius-pill);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		color: var(--color-pure-white);
		transition:
			background-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out);
	}

	.portal-header__logout:hover {
		background-color: var(--color-pure-white);
		color: var(--color-blue-title);
	}

	.portal-header a:focus-visible {
		outline: 2px solid var(--color-yellow);
		outline-offset: 3px;
	}

	@media (max-width: 860px) {
		.portal-header__site {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.portal-header {
			min-height: 4rem;
		}

		.portal-header__logo :global(.logo) {
			width: 6.5rem;
		}

		.portal-header__actions {
			gap: var(--space-2);
		}

		.portal-header__user {
			padding-right: 0.75rem;
		}

		.portal-header__avatar {
			width: 2rem;
			height: 2rem;
			font-size: var(--font-size-md);
		}

		.portal-header__greeting {
			font-size: var(--font-size-xs);
		}

		.portal-header__name {
			max-width: 5rem;
		}

		/* Solo el ícono (el texto queda en aria-label) */
		.portal-header__logout {
			width: 2.5rem;
			min-height: 2.5rem;
			padding: 0;
			justify-content: center;
		}

		/* Visible solo para lectores de pantalla */
		.portal-header__logout-text {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
		}
	}
</style>
