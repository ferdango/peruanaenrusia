---
/**
 * FormField — campo de formulario (texto, lista o texto largo)
 * --------------------------------------------------------------------------
 * Figma: "Libro de reclamaciones" (1001:847): borde gris de 1px, radio 12px,
 * 60px de alto (117px el texto largo), la etiqueta dentro del campo y un
 * texto de ayuda debajo.
 *
 * Etiqueta flotante accesible: con el campo vacío ocupa el lugar del texto;
 * al escribir o elegir una opción sube y se achica. La ayuda y el mensaje de
 * error se asocian al campo con aria-describedby. Los mensajes de error
 * (`messages`) los muestra src/scripts/forms.ts usando la validación nativa
 * del navegador (required, type, pattern, maxlength…).
 *
 * Uso:
 *   <FormField id="c-name" name="fullName" label="Nombres completos" autocomplete="name"
 *       messages={{ required: 'Ingresa tus nombres completos.' }} />
 *   <FormField id="c-type" name="claimType" label="Tipo de reclamación" as="select"
 *       options={[{ value: 'reclamo', label: 'Reclamo' }]} />
 *   <FormField id="c-detail" name="detail" label="Detalle del reclamo" as="textarea" maxlength={3000} />
 */
import Icon from '@components/ui/Icon.astro';

type Option = string | { value: string; label: string };

interface Props {
	id: string;
	name: string;
	label: string;
	/** Texto de ayuda bajo el campo */
	help?: string;
	/** Tipo de control: campo de una línea, lista desplegable o texto largo */
	as?: 'input' | 'select' | 'textarea';
	type?: 'text' | 'email' | 'tel' | 'number' | 'date';
	/** Opciones de la lista (as="select") */
	options?: Option[];
	value?: string;
	required?: boolean;
	autocomplete?: string;
	inputmode?: 'text' | 'numeric' | 'decimal' | 'email' | 'tel';
	pattern?: string;
	minlength?: number;
	maxlength?: number;
	min?: number;
	step?: number | 'any';
	rows?: number;
	/** Mensajes de error: campo vacío y formato inválido */
	messages?: { required?: string; invalid?: string };
	class?: string;
}

const {
	id,
	name,
	label,
	help,
	as = 'input',
	type = 'text',
	options = [],
	value,
	required = false,
	autocomplete,
	inputmode,
	pattern,
	minlength,
	maxlength,
	min,
	step,
	rows = 4,
	messages = {},
	class: className,
} = Astro.props;

const helpId = help ? `${id}-help` : undefined;
const errorId = `${id}-error`;
const describedBy = [helpId, errorId].filter(Boolean).join(' ');

const normalizedOptions = options.map((option) =>
	typeof option === 'string' ? { value: option, label: option } : option,
);

const common = {
	id,
	name,
	required,
	'aria-describedby': describedBy,
	'data-msg-required': messages.required,
	'data-msg-invalid': messages.invalid,
	class: 'form-field__input',
};
---

<div class:list={['form-field', `form-field--${as}`, className]} data-form-field>
	<div class="form-field__control">
		{as === 'select' ? (
			<select {...common} autocomplete={autocomplete}>
				<option value="" disabled selected={!value} hidden />
				{normalizedOptions.map((option) => (
					<option value={option.value} selected={option.value === value}>
						{option.label}
					</option>
				))}
			</select>
		) : as === 'textarea' ? (
			<textarea {...common} rows={rows} minlength={minlength} maxlength={maxlength} placeholder=" ">
					{value}
				</textarea>
		) : (
			<input
				{...common}
				type={type}
				value={value}
				placeholder=" "
				autocomplete={autocomplete}
				inputmode={inputmode}
				pattern={pattern}
				minlength={minlength}
				maxlength={maxlength}
				min={min}
				step={step}
			/>
		)}
		<label for={id} class="form-field__label">
			{label}
			{!required && <span class="form-field__optional"> (opcional)</span>}
		</label>
		{as === 'select' && <Icon name="chevron-down" size={16} class="form-field__chevron" />}
	</div>
	{help && (
		<p id={helpId} class="form-field__help">
			{help}
		</p>
	)}
	<p id={errorId} class="form-field__error" aria-live="polite" data-form-error></p>
</div>

<style>
	.form-field {
		/* Colores de Figma sin token propio */
		--form-field-border: rgb(23 26 26 / 0.4);
		--form-field-placeholder: var(--text-on-light);
		/* Rojo de marca oscurecido: contraste AA sobre fondo claro */
		--form-field-error: color-mix(in srgb, var(--color-red) 75%, var(--color-black));

		display: flex;
		flex-direction: column;
		gap: var(--space-2); /* 8px */
		min-width: 0;
	}

	.form-field__control {
		position: relative;
		height: 3.75rem; /* 60px */
		border: 1px solid var(--form-field-border);
		border-radius: var(--radius-md); /* 12px */
		background-color: var(--surface-white);
		transition:
			border-color var(--duration-base) var(--ease-out),
			box-shadow var(--duration-base) var(--ease-out);
	}

	.form-field--textarea .form-field__control {
		height: auto;
		min-height: 7.3125rem; /* 117px */
	}

	.form-field__control:hover {
		border-color: var(--color-blue-title);
	}

	.form-field__control:focus-within {
		border-color: var(--color-blue-title);
		box-shadow: var(--focus-ring);
	}

	.form-field:has([aria-invalid='true']) .form-field__control {
		border-color: var(--form-field-error);
	}

	.form-field__input {
		display: block;
		width: 100%;
		height: 100%;
		padding: var(--space-4) var(--space-5); /* 16px 24px */
		border: 0;
		border-radius: inherit;
		background: transparent;
		color: var(--text-on-light);
		font-size: var(--font-size-nav);
		line-height: 1.25rem;
		appearance: none;
	}

	textarea.form-field__input {
		min-height: 7.25rem;
		padding-top: 2.25rem;
		resize: vertical;
	}

	.form-field__input:focus-visible {
		outline: none;
		box-shadow: none;
	}

	select.form-field__input {
		padding-inline-end: 3.5rem;
		cursor: pointer;
	}

	/* ----- Etiqueta: en reposo ocupa el lugar del texto (Figma: 15/20) ----- */
	.form-field__label {
		position: absolute;
		top: 50%;
		left: var(--space-5);
		right: var(--space-5);
		overflow: hidden;
		color: var(--form-field-placeholder);
		font-size: var(--font-size-nav);
		line-height: 1.25rem;
		text-overflow: ellipsis;
		white-space: nowrap;
		pointer-events: none;
		transform: translateY(-50%);
		transition:
			top var(--duration-base) var(--ease-out),
			font-size var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out),
			transform var(--duration-base) var(--ease-out);
	}

	.form-field--textarea .form-field__label {
		top: var(--space-4);
		transform: none;
	}

	.form-field__optional {
		color: rgb(23 26 26 / 0.6);
	}

	/* ----- Etiqueta flotante: campo con foco o con valor ----- */
	.form-field__input:focus + .form-field__label,
	input.form-field__input:not(:placeholder-shown) + .form-field__label,
	textarea.form-field__input:not(:placeholder-shown) + .form-field__label,
	select.form-field__input:valid + .form-field__label {
		top: var(--space-2);
		color: var(--color-blue-title);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		line-height: 1.125rem;
		transform: none;
	}

	input.form-field__input:focus,
	input.form-field__input:not(:placeholder-shown),
	select.form-field__input:valid,
	select.form-field__input:focus {
		padding-top: 1.75rem;
		padding-bottom: var(--space-2);
	}

	.form-field__chevron {
		position: absolute;
		top: 50%;
		right: var(--space-5);
		color: var(--text-on-light);
		pointer-events: none;
		transform: translateY(-50%);
	}

	/* Figma: Circular Std Book 12/16 → Poppins */
	.form-field__help {
		font-size: var(--font-size-xs);
		line-height: 1rem;
		color: var(--text-on-light);
		white-space: pre-line;
	}

	.form-field__error {
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-medium);
		line-height: 1rem;
		color: var(--form-field-error);
	}

	.form-field__error:empty {
		display: none;
	}
</style>
