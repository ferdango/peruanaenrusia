---
/**
 * Página de inicio ( / )
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Home" · UI Mobile › "Android Large - 1".
 *
 * La página es solo una lista ordenada de secciones. Para agregar, quitar o
 * reordenar bloques, edita esta lista. Cada sección vive en
 * src/components/sections/home/.
 *
 * Versión inmersiva (Manual de marca 2025): hero con los tubos degradé de la
 * marca, franjas con los lemas y movimiento al hacer scroll (apariciones,
 * parallax, tarjetas con inclinación 3D). El movimiento vive en
 * src/scripts/home-motion.ts y src/styles/home.css, y solo carga en esta página.
 */
import '@styles/home.css';

import SiteLayout from '@layouts/SiteLayout.astro';
import { getFaqs } from '@lib/content';
import { faqSchema } from '@lib/seo/schema';

import VideoModal from '@components/overlays/VideoModal.astro';
import HomeHero from '@components/sections/home/HomeHero.astro';
import HomeMarquee from '@components/sections/home/HomeMarquee.astro';
import HomeIntro from '@components/sections/home/HomeIntro.astro';
import HomeFounder from '@components/sections/home/HomeFounder.astro';
import HomeWhyUs from '@components/sections/home/HomeWhyUs.astro';
import HomeSteps from '@components/sections/home/HomeSteps.astro';
import HomeStartCta from '@components/sections/home/HomeStartCta.astro';
import HomeUniversities from '@components/sections/home/HomeUniversities.astro';
import HomeContactSplit from '@components/sections/home/HomeContactSplit.astro';
import HomeSuccessCases from '@components/sections/home/HomeSuccessCases.astro';
import HomeCommunityGrid from '@components/sections/home/HomeCommunityGrid.astro';
import HomeCommunityGallery from '@components/sections/home/HomeCommunityGallery.astro';
import HomeSocial from '@components/sections/home/HomeSocial.astro';
import HomeStories from '@components/sections/home/HomeStories.astro';
import HomeFaq from '@components/sections/home/HomeFaq.astro';

// Preguntas frecuentes como datos estructurados (schema.org FAQPage)
const faqs = await getFaqs();
---

<SiteLayout bodyClass="home" jsonLd={[faqSchema(faqs)]}>
	<HomeHero />
	<HomeMarquee />
	<HomeIntro />
	<HomeFounder />
	<HomeWhyUs />
	<HomeSteps />
	<HomeStartCta />
	<HomeUniversities />
	<HomeContactSplit />
	<HomeSuccessCases />
	<HomeCommunityGrid />
	<HomeCommunityGallery />
	<HomeSocial />
	<HomeStories />
	<HomeFaq />

	<!-- Reproductor del video destacado (se puede minimizar y seguir navegando) -->
	<VideoModal />
</SiteLayout>

<script>
	// Movimiento del Home: apariciones, parallax, tarjetas 3D y header transparente
	import { initHomeMotion } from '@scripts/home-motion';
	initHomeMotion();
</script>
