---
/**
 * LanguageModal — selector "Idioma y región"
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Modal Idiomas" (4028:113), con el branding del Manual
 * de marca 2025: cabecera azul con el tubo degradé y la estrella de la marca,
 * panel blanco y la opción elegida resaltada en azul (con ✓).
 *
 * - En desktop se muestra como un desplegable debajo de la píldora de idioma
 *   del header; en móvil, centrado en la pantalla.
 * - Al elegir una opción se guarda en localStorage ("peru-lang"), se
 *   actualiza la píldora del header (bandera + ES/EN/RU) y se cierra.
 *   Lógica en src/scripts/language.ts.
 * - Las opciones salen de src/data/languages.ts.
 *
 * TODO (i18n): la traducción real del sitio está pendiente; por ahora solo
 * se recuerda la preferencia (ver src/data/languages.ts).
 *
 * Se abre con cualquier elemento que tenga data-dialog-open="language-modal".
 */
import { Image, getImage } from 'astro:assets';

import Icon from '@components/ui/Icon.astro';
import { languages, defaultLanguage } from '@data/languages';
import tubeScene from '@assets/graphics/tubes/tube-blue-scene.webp';
import Star from '@assets/graphics/stars/star-4-point.svg';

// ----- Textos -----
const content = {
	title: 'Idioma y región',
	subtitle: 'Elige cómo quieres ver el sitio',
	close: 'Cerrar',
};

// Bandera de 24px para la píldora del header: mismos parámetros que usa
// SiteHeader, así el script puede cambiarla sin descargar otra imagen.
const options = await Promise.all(
	languages.map(async (language) => ({
		...language,
		pillFlagSrc: (await getImage({ src: language.flag, width: 24, height: 24 })).src,
	})),
);
---

<dialog
	id="language-modal"
	class="language-modal"
	aria-labelledby="language-modal-title"
	data-default-language={defaultLanguage}
>
	<div class="language-modal__panel">
		<!-- Cabecera de marca: azul, tubo degradé y estrella -->
		<div class="language-modal__header">
			<Image src={tubeScene} alt="" widths={[480, 960]} sizes="420px" class="language-modal__tube" />
			<Star class="language-modal__star" aria-hidden="true" />
			<h2 id="language-modal-title" class="language-modal__title">
				{content.title}
			</h2>
			<p class="language-modal__subtitle">{content.subtitle}</p>
			<button
				type="button"
				class="language-modal__close"
				data-dialog-close
				aria-label={content.close}
				title={content.close}
			>
				<Icon name="close" size={12} />
			</button>
		</div>

		<ul role="list" class="language-modal__list">
			{options.map((language) => (
				<li>
					<button
						type="button"
						class="language-option"
						aria-pressed={language.code === defaultLanguage ? 'true' : 'false'}
						data-language-option={language.code}
						data-language-short={language.short}
						data-language-name={language.name}
						data-language-flag={language.pillFlagSrc}
					>
						<Image
							src={language.flag}
							alt=""
							width={28}
							height={28}
							densities={[1, 2]}
							loading="eager"
							class="language-option__flag"
						/>
						<span class="language-option__text">
							<span
								class="language-option__label"
								lang={language.labelLang === 'es' ? undefined : language.labelLang}
							>
								{language.label}
							</span>
							<span class="language-option__region" lang={language.regionLang}>
								{language.region}
							</span>
						</span>
						<span class="language-option__check" aria-hidden="true">
							<Icon name="check" size={12} />
						</span>
					</button>
				</li>
			))}
		</ul>
	</div>
</dialog>

<script>
	import { initLanguageSelector } from '@scripts/language';
	initLanguageSelector();
</script>

<style>
	/* ----- <dialog>: desplegable bajo la píldora del header (posición desde el script) ----- */
	.language-modal {
		--language-ink: #0b1f3a; /* Texto principal del panel */

		position: fixed;
		inset: var(--language-modal-top, calc(var(--header-height) + var(--space-2))) auto auto
			var(--language-modal-left, var(--gutter));
		width: 21.25rem; /* 340px */
		max-width: calc(100vw - 2 * var(--space-4));
		max-height: calc(100dvh - 2 * var(--space-4));
		margin: 0;
		padding: 0;
		border: 0;
		overflow: visible;
		background: transparent;
		color: var(--language-ink);
	}

	.language-modal::backdrop {
		background: rgb(11 31 58 / 0.4);
		backdrop-filter: blur(2px);
	}

	.language-modal[open] .language-modal__panel {
		animation: language-modal-in var(--duration-slow) var(--ease-out);
	}

	@keyframes language-modal-in {
		from {
			opacity: 0;
			transform: translateY(-8px) scale(0.98);
		}
	}

	.language-modal__panel {
		overflow: hidden;
		border-radius: var(--radius-lg);
		background-color: var(--surface-white);
		box-shadow: 0 1.5rem 3.75rem -1.25rem rgb(0 20 60 / 0.5);
	}

	/* ----- Cabecera azul de la marca ----- */
	.language-modal__header {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		overflow: hidden;
		padding: 1.25rem 1.25rem 1.375rem;
		/* Azul profundo a la izquierda (contraste del texto) que termina en el tono del tubo */
		background: linear-gradient(100deg, #0052c4 0%, #0066e8 45%, #007cff 80%);
		color: var(--color-pure-white);
	}

	/* Tubo degradé (render oficial de la marca) asomando por la derecha */
	.language-modal__tube {
		position: absolute;
		z-index: -1;
		top: -40%;
		right: -48%;
		width: 125%;
		max-width: none;
		height: auto;
		mask-image: linear-gradient(to right, transparent 0%, #000 38%);
		pointer-events: none;
	}

	.language-modal__star {
		width: 1.125rem;
		height: 1.125rem;
		margin-bottom: var(--space-2);
		color: var(--color-yellow);
	}

	.language-modal__title {
		font-size: 1.25rem;
		font-weight: var(--font-weight-bold);
		line-height: 1.625rem;
		letter-spacing: -0.01em;
		color: var(--color-pure-white);
	}

	.language-modal__subtitle {
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
		color: var(--color-pure-white);
	}

	.language-modal__close {
		position: absolute;
		top: var(--space-3);
		right: var(--space-3);
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid rgb(255 255 255 / 0.35);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.14);
		color: var(--color-pure-white);
		transition: background-color var(--duration-base) var(--ease-out);
	}

	.language-modal__close:hover {
		background-color: rgb(255 255 255 / 0.28);
	}

	.language-modal__close:focus-visible {
		outline: 2px solid var(--color-pure-white);
		outline-offset: 2px;
	}

	/* ----- Opciones ----- */
	.language-modal__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-2);
	}

	.language-option {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		width: 100%;
		padding: var(--space-3);
		border-radius: 0.875rem;
		text-align: left;
		color: var(--language-ink);
		transition: background-color var(--duration-base) var(--ease-out);
	}

	.language-option:hover {
		background-color: #f1f5fb;
	}

	.language-option:focus-visible {
		outline: 2px solid var(--color-blue);
		outline-offset: -2px;
	}

	.language-option[aria-pressed='true'] {
		background-color: #e8f1ff;
	}

	.language-option__flag {
		flex-shrink: 0;
		width: 28px;
		height: 28px;
		border-radius: var(--radius-pill);
		box-shadow:
			0 0 0 2px var(--surface-white),
			0 0 0 3px rgb(11 31 58 / 0.1);
	}

	.language-option__text {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}

	/* Figma: Charlie Display Semibold 16/24 → Poppins SemiBold */
	.language-option__label {
		font-size: var(--font-size-md);
		font-weight: var(--font-weight-semibold);
		line-height: 1.375rem;
	}

	.language-option[aria-pressed='true'] .language-option__label {
		color: var(--color-blue-title);
	}

	/* Figma: Charlie Display Regular 14/16 → Poppins Regular */
	.language-option__region {
		font-size: var(--font-size-sm);
		line-height: 1.125rem;
		color: rgb(11 31 58 / 0.66);
	}

	/* ✓ en un círculo azul: solo en la opción elegida */
	.language-option__check {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-blue);
		color: var(--color-pure-white);
		opacity: 0;
		scale: 0.6;
		transition:
			opacity var(--duration-base) var(--ease-out),
			scale var(--duration-base) var(--ease-out);
	}

	.language-option[aria-pressed='true'] .language-option__check {
		opacity: 1;
		scale: 1;
	}

	/* ----- Móvil: centrado en la pantalla ----- */
	@media (max-width: 640px) {
		.language-modal {
			inset: 0;
			height: fit-content;
			margin: auto;
		}
	}
</style>
