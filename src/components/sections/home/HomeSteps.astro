---
/**
 * HomeSteps — "¿Qué tengo que hacer?"
 * --------------------------------------------------------------------------
 * Figma: Home › "Frame 627948" (547:96)
 *   · Encabezado (547:93): título + bajada.
 *   · 5 tarjetas numeradas (fondo #F4F6FA, 422 × 419) con su ilustración.
 * Móvil: UI Mobile › "Frame 627948" (1407:1315): encabezado centrado y la
 * misma tarjeta escalada (321 px de ancho).
 *
 * Las tarjetas avanzan UNA POR UNA con el scroll: la sección queda fija en
 * pantalla mientras el scroll vertical desplaza el riel en horizontal; cada
 * tarjeta se detiene un momento, la activa se resalta y la barra muestra el
 * avance (src/scripts/motion.ts › sliders con scroll, data-scroll-slider).
 * Sin JavaScript o con "reducir movimiento" es un deslizador táctil normal.
 *
 * Cada tarjeta se dibuja en "píxeles de diseño" (--u = ancho de la tarjeta
 * / 422), así la ilustración, los textos y los espacios mantienen las
 * proporciones de Figma en cualquier tamaño.
 *
 * Los pasos vienen de src/data/steps.ts.
 *
 * Uso: <HomeSteps /> (página de inicio).
 */
import { processSteps } from '@data/steps';

// ----- Contenido de la sección -----
const content = {
	title: '¿Qué tengo que hacer?',
	text: 'Te acompañamos en cada paso para ganar tu beca y vivir la experiencia que transformará tu vida.',
	listLabel: 'Pasos del proceso para estudiar en Rusia',
};

/** 1 → "01" */
const stepNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<section class="home-steps section" id="proceso" aria-labelledby="home-steps-title" data-scroll-slider="pin">
	<div class="home-steps__sticky">
		<header class="home-steps__header container">
			<h2 id="home-steps-title" class="home-steps__title">
				{content.title}
			</h2>
			<p class="home-steps__text">{content.text}</p>
		</header>

		<div class="home-steps__viewport" data-slider-viewport>
			<ol class="home-steps__track" role="list" aria-label={content.listLabel} data-slider-track>
				{processSteps.map((step, index) => (
					<li class="home-steps__item" data-slider-item>
						<article class="step-card" aria-labelledby={`home-step-${index + 1}`}>
							<div class="step-card__inner">
								<img
									src={step.illustration.src}
									width={step.illustration.width}
									height={step.illustration.height}
									alt=""
									loading="lazy"
									decoding="async"
									class="step-card__art"
								/>
								<h3 id={`home-step-${index + 1}`} class="step-card__title">
									<span class="step-card__number">
										<span class="visually-hidden">Paso </span>
										{stepNumber(index)}
									</span>
									<span>{step.title}</span>
								</h3>
								<p class="step-card__text">{step.text}</p>
							</div>
						</article>
					</li>
				))}
			</ol>
		</div>

		<!-- Avance (solo con el slider activo): paso actual y barra -->
		<div class="home-steps__progress container" aria-hidden="true">
			<span class="home-steps__count">
				<span data-slider-current>01</span>
				<span class="home-steps__total">/ {stepNumber(processSteps.length - 1)}</span>
			</span>
			<span class="home-steps__bar">
				<span class="home-steps__bar-fill" data-slider-bar></span>
			</span>
		</div>
	</div>
</section>

<style>
	.home-steps {
		/* Margen del riel: alinea la primera tarjeta con el contenido de la página */
		--steps-inset: max(var(--gutter), calc((100% - var(--container-max)) / 2));
		--steps-gap: 1.5rem; /* 24px */

		background-color: var(--surface-white);
		color: var(--text-on-light);
	}

	.home-steps__sticky {
		display: flex;
		flex-direction: column;
		gap: var(--space-8); /* 48px */
	}

	/* ----- Encabezado (848px) ----- */
	.home-steps__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.home-steps__header > * {
		max-width: 53rem; /* 848px */
	}

	/* Figma: Poppins Bold 48/64 */
	.home-steps__title {
		font-size: var(--font-size-h1);
		line-height: 1.333;
		color: var(--text-heading-light);
	}

	/* Figma: Poppins Regular 20/32 */
	.home-steps__text {
		font-size: 1.25rem;
		line-height: 2rem;
	}

	/* ----- Riel de tarjetas ----- */
	/* Sin slider (sin JavaScript o con "reducir movimiento"): se desliza con el dedo */
	.home-steps__viewport {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--steps-inset);
		scrollbar-width: none;
	}

	.home-steps__viewport::-webkit-scrollbar {
		display: none;
	}

	.home-steps__track {
		display: flex;
		gap: var(--steps-gap);
		width: max-content;
		padding: var(--space-3) var(--steps-inset) var(--space-6);
	}

	.home-steps__item {
		flex-shrink: 0;
		scroll-snap-align: start;
	}

	/* ----- Tarjeta (422 × 419 px de diseño) ----- */
	.step-card {
		width: 26.375rem; /* 422px */
		container-type: inline-size;
	}

	.step-card__inner {
		/* 1 "px de diseño" = ancho de la tarjeta / 422 */
		--u: calc(100cqw / 422);

		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: calc(24 * var(--u));
		min-height: calc(419 * var(--u));
		padding: calc(28 * var(--u)) calc(24 * var(--u));
		overflow: clip;
		border-radius: calc(24 * var(--u));
		background-color: #f4f6fa;
		transition:
			opacity 0.5s var(--ease-out),
			scale 0.5s var(--ease-out),
			background-color 0.5s var(--ease-out),
			box-shadow 0.5s var(--ease-out);
	}

	/* Ilustración: cubre la tarjeta (lienzo de 422 × 419) */
	.step-card__art {
		position: absolute;
		top: 0;
		left: 0;
		z-index: -1;
		width: 100%;
		max-width: none;
		height: auto;
		pointer-events: none;
	}

	/* Figma: número Poppins Medium 30.5 (rojo) + título Poppins Bold 24 (azul), alto de línea 35 */
	.step-card__title {
		display: flex;
		align-items: baseline;
		gap: calc(12 * var(--u));
		font-size: max(1.125rem, calc(24 * var(--u)));
		line-height: calc(35 * var(--u));
		color: var(--text-heading-light);
		text-wrap: wrap;
	}

	.step-card__number {
		flex-shrink: 0;
		font-size: calc(30.545 * var(--u));
		font-weight: var(--font-weight-medium);
		color: var(--color-red);
	}

	/* Figma: Poppins Regular 16/26, #363636 */
	.step-card__text {
		font-size: max(0.8125rem, calc(16 * var(--u)));
		line-height: 1.625;
		color: #363636;
	}

	/* ----- Avance: "01 / 05" + barra ----- */
	.home-steps__progress {
		display: none;
		align-items: center;
		gap: var(--space-4);
	}

	.home-steps__count {
		display: inline-flex;
		gap: 0.375rem;
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
		font-variant-numeric: tabular-nums;
		color: var(--text-heading-light);
	}

	.home-steps__total {
		font-weight: var(--font-weight-medium);
		color: rgb(18 91 168 / 0.5);
	}

	.home-steps__bar {
		flex: 1;
		max-width: 22rem;
		height: 4px;
		overflow: hidden;
		border-radius: var(--radius-pill);
		background-color: rgb(18 91 168 / 0.14);
	}

	.home-steps__bar-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background-color: var(--color-blue);
		transform: scaleX(var(--slider-progress, 0));
		transform-origin: left center;
	}

	/* =====================================================================
	   Slider con scroll (lo activa src/scripts/motion.ts)
	   La sección mide lo que dura el recorrido: mientras tanto, el bloque queda
	   fijo bajo el header y el riel se desplaza en horizontal.
	   ===================================================================== */
	.home-steps:global(.is-scroll-slider) {
		height: calc(100svh - var(--header-height) + var(--slider-length, 0px));
		padding-block: 0;
	}

	.home-steps:global(.is-scroll-slider) .home-steps__sticky {
		position: sticky;
		top: var(--header-height);
		justify-content: center;
		gap: var(--space-6);
		height: calc(100svh - var(--header-height));
		padding-block: var(--space-6);
		overflow: hidden;
	}

	.home-steps:global(.is-scroll-slider) .home-steps__viewport {
		overflow: visible;
		scroll-snap-type: none;
	}

	.home-steps:global(.is-scroll-slider) .home-steps__track {
		transform: translate3d(var(--slider-x, 0px), 0, 0);
		will-change: transform;
	}

	.home-steps:global(.is-scroll-slider) .home-steps__progress {
		display: flex;
	}

	/* Tarjeta activa resaltada; las demás, en segundo plano */
	.home-steps:global(.is-scroll-slider) .home-steps__item:not(:global(.is-active)) .step-card__inner {
		opacity: 0.5;
		scale: 0.96;
	}

	.home-steps:global(.is-scroll-slider) .home-steps__item:global(.is-active) .step-card__inner {
		background-color: var(--surface-white);
		box-shadow:
			0 0 0 1px rgb(0 122 252 / 0.12),
			0 1.5rem 3rem -1.5rem rgb(18 91 168 / 0.45);
	}

	/* Pantallas bajas (.is-slider-compact, lo decide src/scripts/motion.ts):
	   menos aire y sin la bajada para que todo quepa mientras está fija */
	.home-steps:global(.is-scroll-slider.is-slider-compact) .home-steps__sticky {
		gap: var(--space-4);
		padding-block: var(--space-4);
	}

	.home-steps:global(.is-scroll-slider.is-slider-compact) .home-steps__text {
		display: none;
	}

	/* ===== Móvil (Figma 1407:1315): encabezado centrado y tarjetas de 321px ===== */
	@media (max-width: 640px) {
		.home-steps {
			--steps-gap: 0.75rem; /* 12px */

			padding-block: var(--space-9); /* 64px */
		}

		.home-steps__header {
			text-align: center;
		}

		/* Escala móvil del sitio: título 28px y texto 16/24 */
		.home-steps__title {
			font-size: var(--font-size-title-mobile);
			line-height: var(--line-height-title-mobile);
		}

		.home-steps__text {
			font-size: var(--font-size-md);
			line-height: 1.5rem;
		}

		.step-card {
			width: min(20.0838rem, 100vw - 2.5rem); /* 321.34px */
		}

		.home-steps__progress {
			justify-content: center;
		}
	}
</style>
