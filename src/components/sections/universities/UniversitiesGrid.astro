---
/**
 * UniversitiesGrid — Listado de universidades
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "MacBook Pro 14 - 13" (3260:83) › "Frame 628319" (3260:309).
 *
 * Tarjetas UniversityCard (el mismo diseño de "Universidades destacadas" del
 * Home) con todas las universidades de src/data/universities.ts (o
 * WordPress): 3 columnas en desktop, 2 en tablet y 1 en móvil. Los colores
 * de marca de las tarjetas se alternan.
 *
 * Filtro por ciudad: píldoras "Todas · Moscú · San Petersburgo…" (con la
 * cantidad de cada una). Sin JavaScript no se muestran y se ven todas las
 * tarjetas.
 *
 * Botón "Ver más universidades": se muestran 9 tarjetas y cada clic muestra
 * 9 más (solo si hay más de 9 en la vista actual).
 *
 * Uso: <UniversitiesGrid universities={universities} /> (debajo de UniversitiesHero)
 */
import UniversityCard from '@components/cards/UniversityCard.astro';
import Button from '@components/ui/Button.astro';
import type { University, UniversityAccent } from '@data/universities';

interface Props {
	universities: University[];
}

const { universities } = Astro.props;

// ----- Contenido de la sección -----
const content = {
	label: 'Listado de universidades',
	filterLabel: 'Filtrar por ciudad',
	all: 'Todas',
	more: 'Ver más universidades',
	/** {count} y {city} se reemplazan al filtrar (lo anuncian los lectores de pantalla) */
	status: 'Mostrando {count} de {total} universidades',
	statusCity: 'Mostrando {count} universidades en {city}',
};

/** Colores de marca de las tarjetas, en orden (se repiten si hay más) */
const accents: UniversityAccent[] = ['skyblue', 'green', 'yellow', 'blue'];

/** Ciudades con su cantidad de universidades, de la que tiene más a la que tiene menos */
const cities = Object.entries(
	universities.reduce<Record<string, number>>((counts, university) => {
		counts[university.city] = (counts[university.city] ?? 0) + 1;
		return counts;
	}, {}),
).sort(([cityA, countA], [cityB, countB]) => countB - countA || cityA.localeCompare(cityB, 'es'));

/** Tarjetas visibles al cargar la página y en cada clic de "Ver más" */
const pageSize = 9;
const hasMore = universities.length > pageSize;
---

<section class="universities-grid" aria-label={content.label} data-universities>
	<div class="container">
		{cities.length > 1 && (
			<div class="universities-grid__toolbar" data-universities-filters hidden>
				<div class="universities-grid__filters" role="group" aria-label={content.filterLabel}>
					<button type="button" class="universities-grid__filter" aria-pressed="true" data-city="">
						{content.all}
						<span class="universities-grid__filter-count">{universities.length}</span>
					</button>
					{cities.map(([city, count]) => (
						<button
							type="button"
							class="universities-grid__filter"
							aria-pressed="false"
							data-city={city}
						>
							{city}
							<span class="universities-grid__filter-count">{count}</span>
						</button>
					))}
				</div>
				<p
					class="universities-grid__status"
					role="status"
					data-universities-status
					data-message={content.status}
					data-message-city={content.statusCity}
				/>
			</div>
		)}

		<ul class="universities-grid__list" role="list" data-universities-list data-page-size={pageSize}>
			{universities.map((university, index) => (
				<li class="universities-grid__item" data-city={university.city}>
					<UniversityCard
						university={university}
						accent={accents[index % accents.length]}
						index={index}
						headingLevel="h2"
					/>
				</li>
			))}
		</ul>

		{hasMore && (
			<div class="universities-grid__more" data-universities-more hidden>
				<Button size="lg" class="universities-grid__more-button">
					{content.more}
				</Button>
			</div>
		)}
	</div>
</section>

<script>
	/**
	 * Filtro por ciudad y "Ver más universidades": muestra las tarjetas de la
	 * ciudad elegida (o todas) de a `data-page-size` por vez.
	 */
	document.querySelectorAll<HTMLElement>('[data-universities]').forEach((root) => {
		const list = root.querySelector<HTMLElement>('[data-universities-list]');
		if (!list) return;

		const pageSize = Number(list.dataset.pageSize) || 9;
		const items = Array.from(list.children) as HTMLElement[];
		const filters = root.querySelector<HTMLElement>('[data-universities-filters]');
		const buttons = Array.from(filters?.querySelectorAll<HTMLButtonElement>('button[data-city]') ?? []);
		const status = root.querySelector<HTMLElement>('[data-universities-status]');
		const more = root.querySelector<HTMLElement>('[data-universities-more]');
		const moreButton = more?.querySelector('button');

		let city = '';
		let visibleCount = pageSize;

		const matches = () => items.filter((item) => !city || item.dataset.city === city);

		const render = (announce = false) => {
			const matching = matches();
			items.forEach((item) => (item.hidden = true));
			matching.forEach((item, index) => (item.hidden = index >= visibleCount));
			if (more) more.hidden = visibleCount >= matching.length;

			if (announce && status) {
				const template = city ? status.dataset.messageCity : status.dataset.message;
				status.textContent = (template ?? '')
					.replace('{count}', String(Math.min(matching.length, visibleCount)))
					.replace('{total}', String(items.length))
					.replace('{city}', city);
			}
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				city = button.dataset.city ?? '';
				visibleCount = pageSize;
				buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
				render(true);
			});
		});

		moreButton?.addEventListener('click', () => {
			const firstNewItem = matches()[visibleCount];
			visibleCount += pageSize;
			render(true);
			// Accesibilidad: el foco pasa a la primera tarjeta nueva
			firstNewItem?.querySelector<HTMLElement>('a')?.focus();
		});

		if (filters) filters.hidden = false;
		render();
	});
</script>

<style>
	.universities-grid {
		position: relative;
		z-index: 1;
		padding-block: var(--space-5) var(--space-10);
		background-color: var(--surface-dark);
	}

	/* ===== Filtros por ciudad ===== */
	.universities-grid__toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-7);
	}

	.universities-grid__toolbar[hidden] {
		display: none;
	}

	.universities-grid__filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.universities-grid__filter {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.75rem;
		padding: 0.375rem 0.5rem 0.375rem 1rem;
		border: 1px solid rgb(255 255 255 / 0.18);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.04);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		color: var(--color-pure-white);
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out);
	}

	.universities-grid__filter-count {
		display: grid;
		place-items: center;
		min-width: 1.75rem;
		height: 1.75rem;
		padding-inline: 0.375rem;
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.12);
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
	}

	.universities-grid__filter:hover {
		border-color: rgb(255 255 255 / 0.45);
		background-color: rgb(255 255 255 / 0.08);
	}

	.universities-grid__filter[aria-pressed='true'] {
		border-color: var(--color-pure-white);
		background-color: var(--color-pure-white);
		color: #0b1f3a;
	}

	.universities-grid__filter[aria-pressed='true'] .universities-grid__filter-count {
		background-color: var(--color-blue);
		color: var(--color-pure-white);
	}

	.universities-grid__filter:focus-visible {
		outline: 2px solid var(--color-yellow);
		outline-offset: 3px;
	}

	.universities-grid__status {
		font-size: var(--font-size-sm);
		color: var(--text-on-dark-muted);
	}

	/* ===== Grilla ===== */
	.universities-grid__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-5);
	}

	.universities-grid__item[hidden] {
		display: none;
	}

	/* ----- Botón "Ver más universidades" ----- */
	.universities-grid__more {
		display: flex;
		justify-content: center;
		margin-top: var(--space-8);
	}

	.universities-grid__more[hidden] {
		display: none;
	}

	.universities-grid :global(.universities-grid__more-button) {
		min-width: 17.625rem; /* 282px */
	}

	@media (max-width: 1100px) {
		.universities-grid__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.universities-grid {
			padding-block: var(--space-4) var(--space-9);
		}

		.universities-grid__toolbar {
			margin-bottom: var(--space-5);
		}

		/* Las píldoras en una fila que se desliza con el dedo */
		.universities-grid__filters {
			flex-wrap: nowrap;
			width: calc(100% + 2 * var(--gutter));
			margin-inline: calc(-1 * var(--gutter));
			padding-inline: var(--gutter);
			overflow-x: auto;
			scrollbar-width: none;
		}

		.universities-grid__filters::-webkit-scrollbar {
			display: none;
		}

		.universities-grid__filter {
			flex-shrink: 0;
		}

		.universities-grid__list {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-4);
		}

		.universities-grid :global(.universities-grid__more-button) {
			width: 100%;
		}
	}
</style>
