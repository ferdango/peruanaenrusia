---
/**
 * HomeContactSplit — "Reserva tu llamada gratuita" + "Resuelve tus dudas con nosotros"
 * --------------------------------------------------------------------------
 * Figma: Home › "Frame 628075" (1388:5181) → filas 1388:5182 y 1388:5198.
 * Móvil: UI Mobile › Home › 1735:2821… ("Reserva tu llamada") y 1735:2842…
 * ("Resuelve tus dudas con nosotros").
 *
 * Dos bloques partidos en mitades: un panel de color (antetítulo, título,
 * texto, lo que incluye y el botón, que abre WhatsApp) y una foto cruzada por
 * una onda plana de la marca. En móvil la foto va arriba y el panel debajo.
 *
 * Movimiento: con el scroll (--draw, src/scripts/scroll-draw.ts) la onda se
 * dibuja alrededor de la persona y la foto se acerca suavemente; los textos
 * aparecen en cascada (src/scripts/motion.ts).
 *
 * La onda pasa POR DETRÁS de las personas: igual que en Figma, la foto se
 * repite encima de la onda, recortada con una máscara con la silueta
 * (`.contact-split__front` + src/assets/graphics/shapes/cutout-*.svg).
 *
 * Todas las capas de la foto se ubican en % de un "lienzo" con la proporción
 * del diseño (756 × 840 en desktop) que cubre la mitad de la fila; así foto,
 * onda y recorte siguen alineados en cualquier ancho de pantalla.
 *
 * Uso: <HomeContactSplit /> (anclas #reserva-tu-llamada y #resuelve-tus-dudas)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { whatsappUrl } from '@data/site';
import Star from '@assets/graphics/stars/star-4-point.svg';
import bookCallPhoto from '@assets/images/home/contact-book-call.jpg';
import solveDoubtsPhoto from '@assets/images/home/contact-solve-doubts.jpg';
import WaveBookCall from '@assets/graphics/waves/wave-blue-book-call.svg';
import WaveSolveDoubts from '@assets/graphics/waves/wave-red-solve-doubts.svg';
import WaveMobile from '@assets/graphics/waves/wave-contact-mobile.svg';

// ----- Contenido de la sección -----
const content = {
	bookCall: {
		eyebrow: 'Asesoría gratuita',
		title: 'Reserva tu llamada gratuita',
		/** En móvil el diseño usa un título más corto */
		mobileTitle: 'Reserva tu llamada',
		text: 'Conversemos sobre tu caso: revisamos tu perfil, te contamos a qué becas puedes postular y armamos juntos tu plan.',
		points: [
			'Evaluamos tu perfil académico',
			'Te explicamos la beca paso a paso',
			'Sin costo ni compromiso',
		],
		cta: 'Reservar mi llamada',
		photoAlt: 'Estudiante revisando su celular en el pasillo de la universidad',
	},
	solveDoubts: {
		eyebrow: 'Atención por WhatsApp',
		title: 'Resuelve tus dudas con nosotros',
		text: '¿Documentos, visa, idioma o vida en Rusia? Escríbenos: somos estudiantes becados que ya pasamos por el proceso.',
		points: ['Documentos y legalizaciones', 'Visa, pasajes y llegada', 'Vida y estudios en Rusia'],
		cta: 'Escribir por WhatsApp',
		photoAlt: 'Estudiante conversando con una asesora en una oficina',
	},
	/** Texto extra para lectores de pantalla en los botones */
	ctaHint: ' por WhatsApp (se abre en una pestaña nueva)',
};

interface ContactRow {
	id: string;
	/** Modificador BEM: define colores y la composición de la foto (ver estilos) */
	modifier: 'book' | 'doubts';
	eyebrow: string;
	title: string;
	mobileTitle?: string;
	text: string;
	/** Lo que incluye (lista con ✓) */
	points: string[];
	cta: string;
	photo: ImageMetadata;
	photoAlt: string;
	/** Ancho con el que se dibuja la foto (es más ancha que su recuadro) */
	photoSizes: string;
	Wave: typeof WaveBookCall;
}

const rows: ContactRow[] = [
	{
		id: 'reserva-tu-llamada',
		modifier: 'book',
		...content.bookCall,
		photo: bookCallPhoto,
		photoSizes: '(max-width: 640px) 165vw, 1548px',
		Wave: WaveBookCall,
	},
	{
		id: 'resuelve-tus-dudas',
		modifier: 'doubts',
		...content.solveDoubts,
		photo: solveDoubtsPhoto,
		photoSizes: '(max-width: 640px) 284vw, 1598px',
		Wave: WaveSolveDoubts,
	},
];

const photoWidths = [600, 1000, 1600, 2000];
---

<div class="contact-split">
	{rows.map((row) => {
		const { Wave } = row;
		return (
			<section
				class:list={['contact-split__row', `contact-split__row--${row.modifier}`]}
				id={row.id}
				aria-labelledby={`${row.id}-title`}
				data-scroll-draw="0.95 0.35"
			>
				<!-- Panel de color con el texto -->
				<div class="contact-split__panel">
					<Star class="contact-split__star" aria-hidden="true" />

					<p class="contact-split__eyebrow">
						<Icon name="whatsapp" size={16} />
						{row.eyebrow}
					</p>

					<h2 id={`${row.id}-title`} class="contact-split__title">
						{row.mobileTitle ? (
							<>
								<span class="contact-split__title-full">{row.title}</span>
								<span class="contact-split__title-short">{row.mobileTitle}</span>
							</>
						) : (
							row.title
						)}
					</h2>

					<div class="contact-split__body">
						<p class="contact-split__text">{row.text}</p>
						<ul class="contact-split__list" role="list">
							{row.points.map((point) => (
								<li class="contact-split__point">
									<span class="contact-split__check" aria-hidden="true">
										<Icon name="check" size={12} />
									</span>
									{point}
								</li>
							))}
						</ul>
						<Button
							href={whatsappUrl}
							target="_blank"
							rel="noopener"
							icon="whatsapp"
							class="contact-split__cta"
						>
							{row.cta}
							<span class="visually-hidden">{content.ctaHint}</span>
						</Button>
					</div>
				</div>

				<!-- Foto + onda de la marca -->
				<div class="contact-split__media">
					<div class="contact-split__art">
						<Image
							src={row.photo}
							alt={row.photoAlt}
							widths={photoWidths}
							sizes={row.photoSizes}
							class="contact-split__photo"
						/>
						<Wave class="contact-split__wave contact-split__wave--desktop" aria-hidden="true" />
						<WaveMobile
							class="contact-split__wave contact-split__wave--mobile"
							aria-hidden="true"
						/>

						<!-- Copia de la foto recortada con la silueta: tapa la onda donde pasa por detrás -->
						<div class="contact-split__front" aria-hidden="true">
							<Image
								src={row.photo}
								alt=""
								widths={photoWidths}
								sizes={row.photoSizes}
								class="contact-split__photo"
							/>
						</div>
					</div>
				</div>
			</section>
		);
	})}
</div>

<style>
	/* ==========================================================================
	   Fila: panel de texto + foto (dos mitades de 756 × 840px en desktop)
	   ========================================================================== */
	.contact-split__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		height: 52.5rem; /* 840px */
	}

	/* ----- Panel de color ----- */
	.contact-split__panel {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: var(--space-6);
		padding: var(--space-10);
		overflow: clip;
		color: var(--color-white);
	}

	/* Brillo suave arriba a la derecha */
	.contact-split__panel::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(circle at 92% 8%, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0) 55%);
	}

	/* Estrella grande de la marca (decorativa), gira muy despacio */
	.contact-split__star {
		position: absolute;
		top: -4rem;
		right: -4.5rem;
		z-index: -1;
		width: 18rem;
		height: 18rem;
		color: rgb(255 255 255 / 0.1);
	}

	.contact-split__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border: 1px solid rgb(255 255 255 / 0.35);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.14);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
	}

	.contact-split__row--book .contact-split__panel {
		/* En pantallas más anchas que el diseño, alinea el texto con el resto de la página */
		padding-inline-start: max(var(--space-10), calc((100vw - var(--container-max)) / 2));
		/* Azul de la marca un poco más profundo abajo: el texto blanco cumple el contraste AA */
		background: linear-gradient(170deg, #1584f5 0%, #0a6be0 62%);
	}

	.contact-split__row--doubts .contact-split__panel {
		background: linear-gradient(170deg, #ff2a3d 0%, #dc1226 62%);
	}

	.contact-split__title {
		font-size: clamp(2.5rem, 1rem + 4.3vw, 4rem); /* 64px en desktop */
		line-height: 1;
		color: var(--color-pure-white);
	}

	.contact-split__row--book .contact-split__title {
		max-width: 23.125rem; /* 370px */
	}

	.contact-split__title-short {
		display: none;
	}

	.contact-split__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-6);
	}

	.contact-split__text {
		max-width: 30rem;
		font-size: var(--font-size-lg);
		line-height: 1.875rem;
		color: rgb(255 255 255 / 0.92);
	}

	/* Lo que incluye: ✓ en un círculo translúcido */
	.contact-split__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.contact-split__point {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		font-size: var(--font-size-md);
		font-weight: var(--font-weight-semibold);
		line-height: 1.5rem;
	}

	.contact-split__check {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		color: var(--panel-color);
	}

	.contact-split__row--book {
		--panel-color: #0a6be0;
	}

	.contact-split__row--doubts {
		--panel-color: #dc1226;
	}

	/* Botón: blanco, con el color del panel al rellenarse */
	.contact-split :global(.contact-split__cta) {
		--btn-contrast: var(--panel-color);

		margin-top: var(--space-2);
		min-width: 17rem;
	}

	/* ----- Movimiento con el scroll (--draw): la onda se dibuja y la foto se acerca ----- */
	.contact-split__wave :global(.brand-line) {
		stroke-dasharray: 100 100;
		stroke-dashoffset: calc(100 - 100 * clamp(0, (var(--draw, 1) - 0.1) / 0.75, 1));
	}

	@media (prefers-reduced-motion: no-preference) {
		.contact-split__star {
			animation: contact-split-spin 40s linear infinite;
		}
	}

	@keyframes contact-split-spin {
		to {
			rotate: 360deg;
		}
	}

	/* ==========================================================================
	   Foto: lienzo con la proporción del diseño que cubre la mitad de la fila.
	   Las capas usan variables (en %) definidas por fila y por tamaño de pantalla.
	   ========================================================================== */
	.contact-split__row--doubts .contact-split__media {
		order: -1; /* foto a la izquierda */
	}

	.contact-split__media {
		position: relative;
		overflow: clip;
		container-type: size;
	}

	.contact-split__art {
		/* Proporción del lienzo (ancho / alto): 756 / 840 en desktop */
		--art-ratio: 0.9;

		position: absolute;
		top: 0;
		left: 50%;
		/* "cover": llena el recuadro sin deformarse (recorta los lados o la parte de abajo) */
		width: max(100cqw, 100cqh * var(--art-ratio));
		aspect-ratio: var(--art-ratio);
		transform: translateX(-50%);
		/* Se acerca suavemente al entrar (el origen es su centro visual) */
		scale: calc(1.08 - 0.08 * var(--draw, 1));
		transform-origin: 0% 35%;
	}

	.contact-split__photo {
		position: absolute;
		top: var(--photo-y);
		left: var(--photo-x);
		width: var(--photo-w);
		max-width: none;
		height: var(--photo-h);
		object-fit: cover;
		transform: var(--photo-transform, none);
	}

	.contact-split__wave {
		position: absolute;
		max-width: none;
		pointer-events: none;
	}

	.contact-split__wave--mobile {
		display: none;
	}

	/* Copia de la foto recortada con la silueta (encima de la onda) */
	.contact-split__front {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	/* ----- Fila 1: "Reserva tu llamada gratuita" (foto espejada, Figma 1388:5191) ----- */
	.contact-split__row--book {
		--photo-x: -40.476%; /* -306px */
		--photo-y: -23.69%; /* -199px */
		--photo-w: 204.77%; /* 1548px */
		--photo-h: 135.936%; /* 1142px */
		--photo-transform: scaleX(-1);
	}

	.contact-split__row--book .contact-split__wave--desktop {
		top: 4.532%;
		left: -37.184%;
		width: 153.429%; /* 1160px */
		height: 87.753%; /* 737px */
		/* Matriz de Figma: rotación + espejo + inclinación (columnas de largo 1) */
		transform: rotate(-142.95deg) scale(-1, 0.9099) skewX(-22.53deg);
	}

	.contact-split__row--book .contact-split__front {
		-webkit-mask: url('../../../assets/graphics/shapes/cutout-book-call.svg') 12.59% 64.012% / 54.299%
			42.44% no-repeat;
		mask: url('../../../assets/graphics/shapes/cutout-book-call.svg') 12.59% 64.012% / 54.299% 42.44%
			no-repeat;
	}

	/* ----- Fila 2: "Resuelve tus dudas con nosotros" (Figma 1388:5199) ----- */
	.contact-split__row--doubts {
		--photo-x: -51.19%; /* -387px */
		--photo-y: -11.071%; /* -93px */
		--photo-w: 211.376%; /* 1598px */
		--photo-h: 117.262%; /* 985px */
	}

	.contact-split__row--doubts .contact-split__wave--desktop {
		top: 7.126%;
		left: -22.477%;
		width: 143.488%; /* 1085px */
		height: 71.438%; /* 600px */
		transform: rotate(21.2deg) scale(1, 0.99) skewX(8.54deg);
	}

	.contact-split__row--doubts .contact-split__front {
		-webkit-mask: url('../../../assets/graphics/shapes/cutout-solve-doubts.svg') 0% 52.224% / 40.476%
			27.738% no-repeat;
		mask: url('../../../assets/graphics/shapes/cutout-solve-doubts.svg') 0% 52.224% / 40.476% 27.738%
			no-repeat;
	}

	/* ==========================================================================
	   Tablet
	   ========================================================================== */
	@media (max-width: 1100px) {
		.contact-split__row {
			height: auto;
			min-height: 40rem; /* 640px */
		}

		.contact-split__panel,
		.contact-split__row--book .contact-split__panel {
			gap: var(--space-6);
			padding: var(--space-8);
		}
	}

	/* ==========================================================================
	   Móvil (Figma móvil): foto arriba y panel centrado debajo
	   ========================================================================== */
	@media (max-width: 640px) {
		.contact-split__text {
			font-size: var(--font-size-md);
			line-height: 1.625rem;
		}

		.contact-split__row {
			grid-template-columns: 100%;
			min-height: 0;
		}

		.contact-split__media,
		.contact-split__row--doubts .contact-split__media {
			order: -1;
		}

		/* ----- Panel ----- */
		.contact-split__panel,
		.contact-split__row--book .contact-split__panel {
			gap: 1.25rem; /* 20px */
			padding: var(--space-8) var(--gutter);
		}

		.contact-split__star {
			top: -3rem;
			right: -3rem;
			width: 11rem;
			height: 11rem;
		}

		.contact-split__point {
			font-size: var(--font-size-sm);
		}

		.contact-split :global(.contact-split__cta) {
			width: 100%;
			min-width: 0;
		}

		.contact-split__title,
		.contact-split__row--book .contact-split__title {
			max-width: none;
			font-size: var(--font-size-title-mobile);
			line-height: var(--line-height-title-mobile);
		}

		.contact-split__row--doubts .contact-split__title {
			line-height: 1.4;
		}

		.contact-split__title-full {
			display: none;
		}

		.contact-split__title-short {
			display: inline;
		}

		.contact-split__body {
			align-self: stretch;
			gap: var(--space-5);
		}

		.contact-split__row--doubts .contact-split__text {
			font-size: var(--font-size-md);
			line-height: 1.75rem; /* 28px */
		}

		/* ----- Foto: el lienzo es el propio recuadro (360 × 437 y 360 × 404) ----- */
		.contact-split__wave--desktop {
			display: none;
		}

		.contact-split__wave--mobile {
			display: block;
			width: 189.833%; /* 683px */
		}

		.contact-split__row--book .contact-split__media {
			aspect-ratio: 360 / 437;
		}

		.contact-split__row--book .contact-split__art {
			--art-ratio: 0.8238;
		}

		.contact-split__row--book {
			--photo-x: -32.286%;
			--photo-y: 0%;
			--photo-w: 164.572%;
			--photo-h: 100%;
		}

		.contact-split__row--book .contact-split__wave--mobile {
			top: 52.939%;
			left: -6.028%;
			height: 55.221%; /* 241px */
			color: var(--color-blue);
			transform: rotate(121.2deg) scale(0.98);
		}

		/* En móvil la onda azul no pasa por detrás de la persona */
		.contact-split__row--book .contact-split__front {
			display: none;
		}

		.contact-split__row--doubts .contact-split__media {
			aspect-ratio: 360 / 404;
		}

		.contact-split__row--doubts .contact-split__art {
			--art-ratio: 0.8911;
		}

		.contact-split__row--doubts {
			--photo-x: -46.369%; /* -167px */
			--photo-y: -31.436%; /* -127px */
			--photo-w: 283.889%; /* 1022px */
			--photo-h: 155.941%; /* 630px */
		}

		.contact-split__row--doubts .contact-split__wave--mobile {
			top: 71.533%;
			left: -8.269%;
			height: 59.731%; /* 241px */
			color: var(--color-red);
			transform: rotate(-157.36deg) scale(-1, 1) skewX(-0.72deg);
		}

		.contact-split__row--doubts .contact-split__front {
			-webkit-mask: url('../../../assets/graphics/shapes/cutout-solve-doubts-mobile.svg') 28.303%
				55.237% / 64.393% 18.892% no-repeat;
			mask: url('../../../assets/graphics/shapes/cutout-solve-doubts-mobile.svg') 28.303% 55.237% /
				64.393% 18.892% no-repeat;
		}
	}
</style>
