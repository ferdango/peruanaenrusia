---
/**
 * HomeFounder — "Soy Grecia Kristal, la peruana más conocida en Rusia."
 * --------------------------------------------------------------------------
 * Figma: Home › fondo verde "Rectangle 124" (1342:924) + fotos apiladas
 * "Mask group" (1319:31, 1319:34, 1319:38) + onda amarilla (1319:37) +
 * texto "Frame 627960" (584:50, con la estrella 1321:42).
 * Móvil: Figma UI Mobile › 1399:1242 (fondo), 1399:1229/1232/1235 (fotos)
 * y 1399:1238 (texto).
 *
 * Capas (de atrás hacia adelante, como en Figma):
 *   foto de atrás → foto del medio → onda amarilla → foto de adelante → texto
 *
 * Uso: <HomeFounder /> (página de inicio).
 */
import { Image } from 'astro:assets';

import photoBack from '@assets/images/home/founder-photo-red-square.jpg';
import photoMiddle from '@assets/images/home/founder-photo-forum.jpg';
import photoFront from '@assets/images/home/founder-photo-podium.jpg';
import WaveYellow from '@assets/graphics/waves/wave-yellow-founder.svg';
import Star from '@assets/graphics/stars/star-4-point.svg';

// ----- Contenido de la sección -----
const content = {
	title: 'Soy Grecia Kristal, la peruana más conocida en Rusia.',
	paragraphs: [
		'Como tú, también soñé con estudiar fuera del país, y lo logré',
		'Hoy acompaño a cientos de peruanos en su camino académico, ayudándolos a postular a becas reales, sin falsas promesas, sin agencias que te abandonan.',
	],
	photoAlt: 'Grecia Kristal durante una conferencia Rusia – América Latina',
};

/**
 * Fotos apiladas (de atrás hacia adelante). Las dos de atrás son decorativas:
 * quedan casi ocultas detrás de la principal.
 */
const photos = [
	{ key: 'back', src: photoBack, alt: '', widths: [600, 1200], sizes: '(max-width: 640px) 380px, 572px' },
	{
		key: 'middle',
		src: photoMiddle,
		alt: '',
		widths: [600, 1080],
		sizes: '(max-width: 640px) 380px, 571px',
	},
	{
		key: 'front',
		src: photoFront,
		alt: content.photoAlt,
		widths: [480, 720, 1080],
		sizes: '(max-width: 640px) 470px, 711px',
	},
];
---

<section class="home-founder" id="sobre-nosotros" aria-labelledby="home-founder-title">
	<!-- Onda plana amarilla (decorativa), en un lienzo de 1512px centrado -->
	<div class="home-founder__decor" aria-hidden="true">
		<WaveYellow class="home-founder__wave" />
	</div>

	<div class="home-founder__inner container">
		<div class="home-founder__photos">
			{photos.map((photo) => (
				<div class:list={['founder-photo', `founder-photo--${photo.key}`]}>
					<Image
						src={photo.src}
						alt={photo.alt}
						widths={photo.widths}
						sizes={photo.sizes}
						class="founder-photo__image"
					/>
				</div>
			))}
		</div>

		<div class="home-founder__content">
			<Star class="home-founder__star" aria-hidden="true" />
			<h2 id="home-founder-title" class="home-founder__title">
				{content.title}
			</h2>
			<div class="home-founder__text">
				{content.paragraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.home-founder {
		position: relative;
		isolation: isolate;
		min-height: 52.5rem; /* 840px */
		padding-block: 5.5625rem var(--space-9); /* 89px arriba (texto), 64px abajo */
		overflow: clip;
		background-color: var(--color-green);
		color: var(--text-on-dark);
	}

	/* ----- Onda: lienzo de 1512px centrado (ancho de Figma) ----- */
	.home-founder__decor {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: 1; /* entre las fotos de atrás y la de adelante */
		width: 1512px;
		height: 100%;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.home-founder__wave {
		position: absolute;
		top: 265.17px;
		left: 0;
		max-width: none;
	}

	/* ----- Desktop: fotos (488.8px) + espacio (107.2px) + texto (483px) ----- */
	.home-founder__inner {
		display: grid;
		/*
		 * Las columnas laterales reparten el sobrante como en Figma (158 : 115).
		 * En pantallas algo menores a 1200px el espacio y el texto se encogen.
		 */
		grid-template-columns:
			minmax(0, 158fr) 30.55rem minmax(var(--space-6), 6.7rem) minmax(0, 30.1875rem)
			minmax(0, 115fr);
		align-items: start;
	}

	.home-founder__photos {
		position: relative;
		grid-column: 2;
		width: 30.55rem; /* 488.8px */
		height: 32.6388rem; /* 522.22px */
		margin-top: 4.5625rem; /* 73px: las fotos empiezan 73px más abajo que el texto */
	}

	.home-founder__content {
		position: relative;
		z-index: 2; /* el texto queda sobre la onda */
		grid-column: 4;
		display: flex;
		flex-direction: column;
		gap: var(--space-6); /* 32px */
	}

	/* ----- Fotos apiladas (tarjetas de 425.4 × 481.22 px, radio 40px) ----- */
	.founder-photo {
		position: absolute;
		width: 26.5874rem; /* 425.399px */
		aspect-ratio: 425.399 / 481.22;
		border-radius: var(--radius-2xl);
		overflow: clip;
	}

	.founder-photo__image {
		position: absolute;
		max-width: none;
		height: auto;
	}

	.founder-photo--back {
		top: 0;
		left: 3.9625rem; /* 63.4px */
	}

	.founder-photo--back .founder-photo__image {
		left: -11.312%;
		top: -29.867%;
		width: 134.48%;
	}

	.founder-photo--middle {
		top: 1.0625rem; /* 17px */
		left: 2rem; /* 32px */
	}

	.founder-photo--middle .founder-photo__image {
		left: -5.407%;
		top: -48.096%;
		width: 134.23%;
	}

	.founder-photo--front {
		z-index: 2; /* sobre la onda */
		top: 2.5625rem; /* 41px */
		left: 0;
	}

	.founder-photo--front .founder-photo__image {
		left: 0;
		top: -51.733%;
		width: 167.06%;
	}

	/* ----- Texto ----- */
	.home-founder__star {
		flex-shrink: 0;
		width: 2.3125rem; /* 37px */
		height: 2.3125rem;
		color: var(--color-skyblue);
	}

	.home-founder__title {
		font-size: var(--font-size-h1);
		line-height: 1.1667; /* 56px */
	}

	.home-founder__text {
		font-size: var(--font-size-lg);
		line-height: 1.75rem; /* 28px */
		color: var(--text-on-dark-soft);
	}

	/* Una línea en blanco entre párrafos, como en el diseño */
	.home-founder__text p + p {
		margin-top: 1.75rem;
	}

	/* ===== Tablet y móvil: fotos arriba, texto debajo (Figma móvil) ===== */
	@media (max-width: 1100px) {
		.home-founder {
			min-height: 0;
			padding-block: var(--section-padding-y);
		}

		.home-founder__decor {
			display: none;
		}

		.home-founder__inner {
			grid-template-columns: 100%;
			justify-items: center;
			row-gap: var(--space-9);
		}

		.home-founder__photos,
		.home-founder__content {
			grid-column: 1;
		}

		.home-founder__photos {
			margin-top: 0;
		}

		.home-founder__content {
			width: min(100%, 30.1875rem);
		}
	}

	/* ===== Móvil (Figma 1399:1229/1232/1235 y 1399:1238) ===== */
	@media (max-width: 640px) {
		.home-founder {
			padding-block: 5.6875rem 3.3125rem; /* 91px · 53px */
		}

		.home-founder__inner {
			justify-items: start;
			row-gap: 4.3125rem; /* 69px entre las fotos y el texto */
		}

		/* Lienzo de 360px (ancho de Figma móvil), centrado */
		.home-founder__photos {
			justify-self: center;
			width: 22.5rem; /* 360px */
			height: 22.1875rem; /* 355px */
		}

		.founder-photo {
			width: 17.2619rem; /* 276.19px */
			aspect-ratio: 276.19 / 330.1;
		}

		.founder-photo--back {
			left: 4.4456rem; /* 71.13px */
		}

		.founder-photo--back .founder-photo__image {
			left: -13.187%;
			top: -27.852%;
			width: 138.23%;
		}

		.founder-photo--middle {
			top: 0.4906rem; /* 7.85px */
			left: 3.4556rem; /* 55.29px */
		}

		.founder-photo--middle .founder-photo__image {
			left: -7.278%;
			top: -46.086%;
			width: 137.9%;
		}

		/* La foto principal está girada 4.59° (antihorario) en el diseño */
		.founder-photo--front {
			top: 1.6156rem; /* 25.85px */
			left: 0.25rem; /* 4px */
			width: 17.2675rem; /* 276.28px */
			aspect-ratio: 276.28 / 330;
			transform: rotate(-4.59deg);
			transform-origin: top left;
		}

		.founder-photo--front .founder-photo__image {
			left: -2.74%;
			top: -49.564%;
			width: 171.67%;
			transform: rotate(0.24deg);
			transform-origin: top left;
		}

		.home-founder__content {
			width: 100%;
			gap: var(--space-5); /* 24px */
		}

		.home-founder__title {
			line-height: 1.125; /* 36px */
		}

		.home-founder__text {
			font-size: var(--font-size-md);
		}
	}
</style>
