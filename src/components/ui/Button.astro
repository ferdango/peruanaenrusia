---
/**
 * Button
 * --------------------------------------------------------------------------
 * Botón o enlace con los estilos del sistema de diseño.
 * Si recibe `href` se renderiza como <a>; si no, como <button>.
 *
 * Variantes (variant):
 *   "outline"   → botón de las secciones: píldora translúcida con borde y texto
 *                 del color `tone` y una burbuja con flecha a la derecha. Al
 *                 pasar el cursor, la burbuja crece y rellena el botón.
 *   "primary"   → fondo amarillo de marca y texto oscuro (ej. "Continuar").
 *   "secondary" → fondo gris translúcido y texto claro (ej. "Iniciar proceso").
 *   "light"     → fondo claro y texto azul oscuro (ej. "Contáctate ahora").
 *
 * Tonos (tone) — solo afectan a la variante "outline":
 *   "light" (defecto) → blanco, para fondos oscuros o de color.
 *   "blue"            → azul de títulos, para fondos claros.
 *   "dark"            → negro, para fondos claros.
 * Para otros colores, define desde la sección --btn-color (borde, burbuja y
 * relleno) y --btn-contrast (texto sobre el relleno y flecha).
 *
 * Tamaños (size): "sm" = 48px · "md" = 56px (60px fuera de outline) · "lg" = 64px (70px).
 *
 * Uso:
 *   <Button href="/universidades/">Ver universidades</Button>
 *   <Button variant="primary" type="submit" block>Enviar reclamación</Button>
 *   <Button tone="blue" size="md" href="#contacto">Quiero empezar ahora</Button>
 */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

type Variant = 'outline' | 'primary' | 'secondary' | 'light';
type Tone = 'light' | 'blue' | 'dark';
type Size = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'> {
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	variant?: Variant;
	tone?: Tone;
	size?: Size;
	/** Ícono a la derecha del texto. Por defecto la flecha (en su burbuja) en outline. `null` = sin ícono */
	icon?: IconName | null;
	/** Ocupa todo el ancho disponible */
	block?: boolean;
	class?: string;
}

const {
	href,
	type = 'button',
	variant = 'outline',
	tone = 'light',
	size = 'lg',
	icon = variant === 'outline' ? 'arrow-right' : null,
	block = false,
	class: className,
	...attrs
} = Astro.props;

const Tag = href ? 'a' : 'button';
const isOutline = variant === 'outline';
const iconSize = isOutline ? (size === 'sm' ? 16 : 20) : size === 'sm' ? 16 : 32;
---

<Tag
	href={href}
	type={href ? undefined : type}
	class:list={[
		'btn',
		`btn--${variant}`,
		`btn--tone-${tone}`,
		`btn--${size}`,
		{ 'btn--block': block },
		className,
	]}
	{...attrs}
>
	<span class="btn__label">
		<slot />
	</span>
	{icon &&
		(isOutline ? (
			<span class="btn__bubble" aria-hidden="true">
				<Icon name={icon} size={iconSize} class="btn__icon" />
			</span>
		) : (
			<Icon name={icon} size={iconSize} class="btn__icon" />
		))}
</Tag>

<style>
	/* ----- Base ----- */
	.btn {
		--btn-color: var(--color-white);

		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-4);
		padding: var(--space-3) var(--space-5);
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		font-size: var(--font-size-md);
		font-weight: var(--font-weight-bold);
		line-height: 1.2;
		text-align: center;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out),
			opacity var(--duration-base) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.btn:active {
		transform: scale(0.98);
	}

	.btn:disabled,
	.btn[aria-disabled='true'] {
		opacity: 0.5;
		pointer-events: none;
	}

	.btn__icon {
		flex-shrink: 0;
		transition: transform var(--duration-base) var(--ease-out);
	}

	/* ----- Tamaños ----- */
	.btn--sm {
		min-height: 3rem; /* 48px */
		font-size: var(--font-size-sm);
	}

	.btn--md {
		min-height: 3.75rem; /* 60px */
		padding-inline: var(--space-4);
	}

	.btn--lg {
		min-height: 4.375rem; /* 70px */
		min-width: 15rem; /* 240px */
	}

	.btn--block {
		width: 100%;
	}

	/* =====================================================================
	   Variante: outline → píldora con burbuja y flecha (botón de las secciones)
	   ---------------------------------------------------------------------
	   La burbuja es un círculo del color del botón (::before) con la flecha
	   encima. Al pasar el cursor (o con el foco) el círculo crece hasta
	   rellenar la píldora, el texto cambia a --btn-contrast y la flecha avanza.
	   ===================================================================== */
	.btn--outline {
		--btn-bubble: 2.625rem; /* 42px */
		--btn-inset: 0.3125rem; /* 5px: aire entre la burbuja y el borde */
		--btn-fill-scale: 16;
		--btn-motion: calc(var(--duration-slow) * 1.4);

		position: relative;
		isolation: isolate;
		justify-content: space-between;
		gap: var(--space-4);
		padding: var(--btn-inset) var(--btn-inset) var(--btn-inset) 1.5rem;
		overflow: hidden;
		border: 1.5px solid color-mix(in srgb, var(--btn-color) 55%, transparent);
		border-radius: var(--radius-pill);
		background-color: color-mix(in srgb, var(--btn-color) 9%, transparent);
		box-shadow: 0 0.75rem 1.75rem -1.25rem color-mix(in srgb, var(--btn-color) 60%, transparent);
		color: var(--btn-color);
		letter-spacing: 0.005em;
		transition:
			color var(--btn-motion) var(--ease-out),
			border-color var(--btn-motion) var(--ease-out),
			box-shadow var(--btn-motion) var(--ease-out),
			translate var(--duration-base) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	/* Círculo de la burbuja: crece y rellena el botón */
	.btn--outline::before {
		content: '';
		position: absolute;
		z-index: -1;
		top: 50%;
		right: calc(var(--btn-inset) + var(--btn-bubble) / 2);
		width: var(--btn-bubble);
		aspect-ratio: 1;
		border-radius: 50%;
		background-color: var(--btn-color);
		translate: 50% -50%;
		transition: scale var(--btn-motion) cubic-bezier(0.65, 0, 0.35, 1);
	}

	.btn--outline .btn__bubble {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: var(--btn-bubble);
		height: var(--btn-bubble);
		overflow: hidden;
		border-radius: 50%;
		color: var(--btn-contrast);
	}

	.btn--outline .btn__icon {
		transition: translate var(--btn-motion) var(--ease-out);
	}

	@media (hover: hover) {
		.btn--outline:hover {
			border-color: var(--btn-color);
			box-shadow: 0 1.25rem 2.5rem -1.25rem color-mix(in srgb, var(--btn-color) 75%, transparent);
			color: var(--btn-contrast);
			translate: 0 -2px;
		}

		.btn--outline:hover::before {
			scale: var(--btn-fill-scale);
		}

		.btn--outline:hover .btn__icon {
			translate: 0.1875rem 0;
		}
	}

	.btn--outline:focus-visible {
		outline: 2px solid var(--btn-color);
		outline-offset: 3px;
	}

	.btn--outline.btn--sm {
		--btn-bubble: 2.25rem; /* 36px */

		min-height: 3rem;
		padding-left: 1.125rem;
	}

	.btn--outline.btn--md {
		min-height: 3.5rem; /* 56px */
		padding-left: 1.375rem;
	}

	.btn--outline.btn--lg {
		--btn-bubble: 3rem; /* 48px */
		--btn-inset: 0.375rem;

		min-height: 4rem; /* 64px */
		padding-left: 1.75rem;
		font-size: 1.0625rem;
	}

	.btn--outline.btn--block {
		--btn-fill-scale: 32;
	}

	/* Tonos: --btn-color (borde, burbuja y relleno) y --btn-contrast (texto sobre el relleno) */
	.btn--tone-light {
		--btn-color: var(--color-white);
		--btn-contrast: var(--color-blue-title);
	}

	.btn--tone-blue {
		--btn-color: var(--color-blue-title);
		--btn-contrast: var(--color-pure-white);
	}

	.btn--tone-dark {
		--btn-color: var(--color-black);
		--btn-contrast: var(--color-pure-white);
	}

	/* ----- Variante: primary (amarillo de marca) ----- */
	.btn--primary {
		color: var(--color-black);
		background-color: var(--color-yellow);
	}

	.btn--primary:hover {
		background-color: color-mix(in srgb, var(--color-yellow) 88%, var(--color-black));
	}

	/* ----- Variante: secondary (gris translúcido) ----- */
	.btn--secondary {
		color: var(--color-white);
		background-color: rgb(244 244 244 / 0.2);
		border-color: rgb(244 244 244 / 0.6);
		backdrop-filter: blur(8px);
	}

	.btn--secondary:hover {
		background-color: rgb(244 244 244 / 0.3);
	}

	/* ----- Variante: light (fondo claro) ----- */
	.btn--light {
		color: #002546;
		background-color: #e5f4f2;
		border-radius: var(--radius-md);
	}

	.btn--light:hover {
		background-color: var(--color-pure-white);
	}
</style>
