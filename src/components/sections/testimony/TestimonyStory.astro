---
/**
 * TestimonyStory — "Cómo lo logré: el paso a paso"
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "My testimony" (1616:222) › "Group 134" (1732:2003):
 * fondo celeste (#DEF7FF) y un mosaico de bloques. Cada bloque tiene una foto
 * grande (632 × 580) y 4 casillas de 356 × 278 (textos o fotos) en 2 filas.
 * La foto grande va a la derecha en el primer bloque y a la izquierda en el
 * segundo (se alternan).
 *
 * Mejorado: encabezado con etiqueta y bajada, las casillas de texto llevan su
 * número de paso (01, 02…) y las fotos se acercan al pasar el cursor. Las
 * casillas aparecen en cascada al hacer scroll (src/scripts/motion.ts).
 * Tablet: la foto grande arriba y las casillas en 2 columnas. Móvil: una
 * columna de tarjetas con margen (textos y fotos intercalados).
 *
 * Los bloques vienen de `testimonial.story` (src/data/testimonials.ts o
 * WordPress).
 *
 * Uso: <TestimonyStory id="mi-historia" testimonial={testimonial} />
 */
import MediaImage from '@components/ui/MediaImage.astro';
import type { Testimonial, TestimonialStoryTile } from '@data/testimonials';
import Star from '@assets/graphics/stars/star-4-point.svg';

interface Props {
	id: string;
	testimonial: Testimonial;
}

const { id, testimonial } = Astro.props;

// ----- Contenido de la sección -----
const content = {
	eyebrow: 'Paso a paso',
	title: 'Cómo lo logré: el paso a paso',
	text: `Así fue el camino de ${testimonial.name} para estudiar en Rusia.`,
};

const isPhotoTile = (tile: TestimonialStoryTile): tile is Extract<TestimonialStoryTile, { photo: unknown }> =>
	'photo' in tile;

/** 0 → "01" */
const stepNumber = (index: number) => String(index + 1).padStart(2, '0');

// Las casillas de texto se numeran en orden de lectura, de bloque en bloque
let textCount = 0;
const blocks = (testimonial.story ?? []).map((block) => ({
	...block,
	tiles: block.tiles.map((tile) =>
		isPhotoTile(tile) ? tile : { ...tile, number: stepNumber(textCount++) },
	),
}));
---

{blocks.length > 0 && (
	<section id={id} class="testimony-story" aria-labelledby={`${id}-title`}>
		<div class="testimony-story__inner">
			<header class="testimony-story__header">
				<p class="testimony-story__eyebrow">
					<Star class="testimony-story__eyebrow-star" aria-hidden="true" />
					{content.eyebrow}
				</p>
				<h2 id={`${id}-title`} class="testimony-story__title">
					{content.title}
				</h2>
				<p class="testimony-story__text">{content.text}</p>
			</header>

			{blocks.map((block, blockIndex) => (
				<div class:list={['story-block', { 'story-block--reverse': blockIndex % 2 === 1 }]}>
					<div class="story-block__photo">
						<MediaImage
							image={block.photo.src}
							alt={block.photo.alt}
							widths={[480, 632, 1264]}
							sizes="(max-width: 640px) 92vw, (max-width: 1512px) 42vw, 632px"
							class="story-block__image"
						/>
					</div>

					{block.tiles.map((tile) =>
						isPhotoTile(tile) ? (
							<div class="story-tile story-tile--photo">
								<MediaImage
									image={tile.photo.src}
									alt={tile.photo.alt}
									widths={[360, 712]}
									sizes="(max-width: 640px) 92vw, 356px"
									class="story-block__image"
								/>
							</div>
						) : (
							<div class="story-tile story-tile--text">
								<span class="story-tile__number" aria-hidden="true">
									{tile.number}
								</span>
								<h3 class="story-tile__title">{tile.title}</h3>
								<p class="story-tile__text">{tile.text}</p>
							</div>
						),
					)}
				</div>
			))}
		</div>
	</section>
)}

<style>
	.testimony-story {
		position: relative;
		isolation: isolate;
		overflow: clip;
		/* Figma: "Rectangle" 1732:2004 (#DEF7FF), con un brillo celeste arriba */
		background: radial-gradient(50rem 26rem at 90% 0%, rgb(0 192 252 / 0.2), transparent 70%), #def7ff;
		color: var(--text-on-light);
		scroll-margin-top: var(--header-height);
	}

	/* Lienzo de 1392px (65px de margen en Figma) */
	.testimony-story__inner {
		display: flex;
		flex-direction: column;
		gap: 1.5rem; /* 24px entre bloques */
		max-width: calc(87rem + 2 * var(--gutter)); /* 1392px */
		margin-inline: auto;
		/* Figma: 65px a los lados (el mosaico mide 1392px en una pantalla de 1512px) */
		padding: clamp(var(--space-9), 6vw, 6rem) clamp(1rem, 4.3vw, 4.0625rem)
			clamp(var(--space-9), 7vw, 6.5rem);
	}

	/* ===== Encabezado ===== */
	.testimony-story__header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		margin-bottom: var(--space-6);
	}

	.testimony-story__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.8);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
		color: var(--color-blue-title);
	}

	.testimony-story__eyebrow-star {
		width: 1rem;
		height: 1rem;
		color: var(--color-red);
	}

	/* Figma: Poppins Bold 48/56 */
	.testimony-story__title {
		font-size: var(--font-size-h1);
		line-height: 1.1667;
		color: var(--color-blue-title);
	}

	.testimony-story__text {
		max-width: 38rem;
		font-size: var(--font-size-lg);
		line-height: 1.75rem;
		color: #363636;
	}

	/* ===== Bloque: 2 casillas + 2 casillas + foto grande ===== */
	.story-block {
		display: grid;
		grid-template-columns: 356fr 356fr 632fr;
		grid-template-areas:
			'a b photo'
			'c d photo';
		gap: 1.5rem; /* 24px */
	}

	.story-block--reverse {
		grid-template-columns: 632fr 356fr 356fr;
		grid-template-areas:
			'photo a b'
			'photo c d';
	}

	.story-block > :nth-child(2) {
		grid-area: a;
	}

	.story-block > :nth-child(3) {
		grid-area: b;
	}

	.story-block > :nth-child(4) {
		grid-area: c;
	}

	.story-block > :nth-child(5) {
		grid-area: d;
	}

	.story-block__photo {
		grid-area: photo;
		overflow: clip;
		border-radius: 1.75rem; /* 28px */
		box-shadow: 0 1.5rem 3rem -2rem rgb(18 91 168 / 0.5);
	}

	.story-tile {
		position: relative;
		aspect-ratio: 356 / 277.72;
		overflow: clip;
		border-radius: 1.75rem;
	}

	.story-block__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.9s var(--ease-out);
	}

	.story-block__photo:hover .story-block__image,
	.story-tile--photo:hover .story-block__image {
		scale: 1.05;
	}

	/* Casilla de texto: tarjeta blanca con el número del paso */
	.story-tile--text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-end;
		gap: var(--space-3);
		padding: var(--space-6);
		border: 1px solid rgb(255 255 255 / 0.9);
		background: linear-gradient(160deg, rgb(255 255 255 / 0.98), rgb(255 255 255 / 0.82));
		box-shadow: 0 1.5rem 3rem -2.25rem rgb(18 91 168 / 0.55);
		transition:
			translate var(--duration-slow) var(--ease-out),
			box-shadow var(--duration-slow) var(--ease-out);
	}

	.story-tile--text:hover {
		box-shadow: 0 2rem 3.5rem -2rem rgb(18 91 168 / 0.6);
		translate: 0 -4px;
	}

	/* Número grande del paso, con el degradé azul de la marca */
	.story-tile__number {
		position: absolute;
		top: var(--space-5);
		left: var(--space-6);
		font-size: 2.5rem;
		font-weight: var(--font-weight-bold);
		line-height: 1;
		font-variant-numeric: tabular-nums;
		background: linear-gradient(135deg, var(--color-skyblue), var(--color-blue));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	/* Figma: Poppins Bold 18.5 */
	.story-tile__title {
		font-size: var(--font-size-lg);
		line-height: 1.3;
		color: var(--color-blue-title);
	}

	/* Figma: Poppins Regular 13.5/17, #363636 */
	.story-tile__text {
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
		color: #363636;
	}

	/* ===== Tablet: la foto grande arriba y las casillas en 2 columnas ===== */
	@media (max-width: 1100px) {
		.story-block,
		.story-block--reverse {
			grid-template-columns: 1fr 1fr;
			grid-template-areas:
				'photo photo'
				'a b'
				'c d';
		}

		.story-block__photo {
			aspect-ratio: 632 / 400;
		}

		.story-tile--text {
			aspect-ratio: auto;
			min-height: 15rem;
		}
	}

	/* ===== Móvil: una columna de tarjetas con margen ===== */
	@media (max-width: 640px) {
		.testimony-story__inner {
			gap: var(--space-3);
			padding: var(--space-9) var(--space-3) var(--space-9);
		}

		.testimony-story__header {
			align-items: center;
			margin-bottom: var(--space-4);
			padding-inline: var(--space-2);
			text-align: center;
		}

		.testimony-story__title {
			font-size: var(--font-size-title-mobile);
			line-height: var(--line-height-title-mobile);
		}

		.testimony-story__text {
			font-size: var(--font-size-md);
			line-height: 1.5rem;
		}

		.story-block,
		.story-block--reverse {
			display: flex;
			flex-direction: column;
			gap: var(--space-3);
		}

		/* Orden de lectura: textos y fotos intercalados, la foto grande al final */
		.story-block__photo {
			order: 1;
			aspect-ratio: 4 / 3;
			border-radius: var(--radius-lg);
		}

		.story-tile {
			border-radius: var(--radius-lg);
		}

		.story-tile--photo {
			aspect-ratio: 4 / 3;
		}

		.story-tile--text {
			min-height: 0;
			padding: 4.25rem var(--space-5) var(--space-5);
		}

		.story-tile__number {
			top: var(--space-5);
			left: var(--space-5);
			font-size: 2rem;
		}
	}
</style>
