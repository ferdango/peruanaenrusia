---
/**
 * HomeFaq — "Preguntas frecuentes"
 * --------------------------------------------------------------------------
 * Figma: Home › "Frame 628331" (1820:185)
 *   · Izquierda (1369:2288): título, video "¿Por qué elegir Peruana en
 *     Rusia?" (miniatura con la onda azul de la marca) y botón "Reserva llamada".
 *   · Derecha (1371:2306): acordeón de preguntas (la primera abierta).
 *   · Ondas planas: roja arriba a la izquierda (1820:202) y azul abajo a la
 *     derecha (1820:194).
 * Móvil: UI Mobile › Home: todo en una columna, sin ondas ni botón.
 *
 * El acordeón usa <details>/<summary> nativos (accesible y sin JavaScript);
 * con el atributo `name` solo una pregunta queda abierta a la vez.
 *
 * Las preguntas vienen del gestor de contenidos (WordPress) o, si no está
 * configurado, de src/data/faqs.ts (ver src/lib/content/).
 *
 * Uso: <HomeFaq /> (página de inicio, antes del footer).
 */
import { Image } from 'astro:assets';

import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { getFaqs } from '@lib/content';
import { site, whatsappUrl } from '@data/site';
import thumbnail from '@assets/images/home/faq-video-thumb.jpg';
import WaveRed from '@assets/graphics/waves/wave-red-faq.svg';
import WaveBlue from '@assets/graphics/waves/wave-blue-faq.svg';
import WaveThumb from '@assets/graphics/waves/wave-blue-faq-thumb.svg';

const faqs = await getFaqs();

// ----- Contenido de la sección -----
const youtubeChannel = site.socials.find((social) => social.icon === 'youtube')?.href ?? '#';

const content = {
	title: 'Preguntas frecuentes',
	video: {
		title: '¿Por qué elegir Peruana en Rusia?',
		duration: '2:35 min',
		/** Enlace del video (mientras no exista, el canal de YouTube de la marca) */
		href: youtubeChannel,
	},
	cta: 'Reserva llamada',
	ctaHint: ' por WhatsApp (se abre en una pestaña nueva)',
};
---

<section class="home-faq section" id="preguntas-frecuentes" aria-labelledby="home-faq-title">
	<!-- Ondas planas de la marca (decorativas), en un lienzo de 1512px centrado -->
	<div class="home-faq__decor" aria-hidden="true">
		<div class="home-faq__wave home-faq__wave--red">
			<WaveRed />
		</div>
		<div class="home-faq__wave home-faq__wave--blue">
			<WaveBlue />
		</div>
	</div>

	<div class="home-faq__inner container">
		<div class="home-faq__aside">
			<h2 id="home-faq-title" class="home-faq__title">
				{content.title}
			</h2>

			<a href={content.video.href} class="faq-video" target="_blank" rel="noopener noreferrer">
				<span class="faq-video__frame" aria-hidden="true">
					<span class="faq-video__media">
						<Image
							src={thumbnail}
							alt=""
							widths={[140, 280]}
							sizes="140px"
							class="faq-video__image"
						/>
						<span class="faq-video__wave">
							<WaveThumb />
						</span>
						<Image
							src={thumbnail}
							alt=""
							widths={[140, 280]}
							sizes="140px"
							class="faq-video__image faq-video__image--front"
						/>
					</span>
					<span class="faq-video__play">
						<Icon name="play" size={16} />
					</span>
				</span>
				<span class="faq-video__text">
					<span class="faq-video__title">{content.video.title}</span>
					<span class="faq-video__duration">
						<span class="visually-hidden">Duración: </span>
						{content.video.duration}
					</span>
				</span>
			</a>

			<Button href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="home-faq__cta">
				{content.cta}
				<span class="visually-hidden">{content.ctaHint}</span>
			</Button>
		</div>

		<div class="home-faq__list">
			{faqs.map((faq, index) => (
				<details class="faq-item" name="preguntas-frecuentes" open={index === 0}>
					<summary class="faq-item__summary">
						<span class="faq-item__question">{faq.question}</span>
						<span class="faq-item__toggle" aria-hidden="true">
							<Icon name="plus-solid" size={24} class="faq-item__icon faq-item__icon--plus" />
							<Icon name="minus-solid" size={28} class="faq-item__icon faq-item__icon--minus" />
						</span>
					</summary>
					{faq.answerHtml ? (
						<div class="faq-item__answer" set:html={faq.answerHtml} />
					) : (
						<div class="faq-item__answer">
							<p>{faq.answer}</p>
						</div>
					)}
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.home-faq {
		/* Colores de Figma sin token propio */
		--faq-toggle-bg: #052029;
		--faq-border: rgb(244 244 244 / 0.4);

		display: grid;
		align-content: center;
		/* Figma: 840px de alto con el contenido centrado (las ondas usan esa altura) */
		min-height: 52.5rem;
		isolation: isolate;
		overflow: clip;
		background-color: var(--surface-dark);
		color: var(--text-on-dark);
	}

	/* ----- Ondas: lienzo de 1512px centrado (ancho de Figma) ----- */
	.home-faq__decor {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: -1;
		width: 1512px;
		height: 100%;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.home-faq__wave {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.home-faq__wave :global(svg) {
		flex: none;
		width: 1064px;
		height: 256px;
		max-width: none;
	}

	/* Figma 1820:202: girada -165° y reflejada */
	.home-faq__wave--red {
		left: -448px;
		top: -138px;
		width: 1094px;
		height: 522.66px;
	}

	.home-faq__wave--red :global(svg) {
		color: var(--color-red);
		transform: rotate(-165deg) scaleY(-1);
	}

	/* Figma 1820:194: reflejada y girada 26.49° */
	.home-faq__wave--blue {
		left: 795px;
		top: 472px;
		width: 1066.49px;
		height: 703.69px;
	}

	.home-faq__wave--blue :global(svg) {
		transform: rotate(26.49deg) scaleY(-1);
	}

	/* ----- Dos columnas: 404px + 884px, separadas 64px ----- */
	.home-faq__inner {
		display: grid;
		grid-template-columns: minmax(0, 25.25rem) minmax(0, 55.25rem);
		justify-content: space-between;
		align-items: center;
		gap: var(--space-9); /* 64px */
	}

	.home-faq__aside {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-7); /* 40px */
	}

	/* Figma: Poppins Bold 64/64 */
	.home-faq__title {
		max-width: 24.1875rem; /* 387px */
		font-size: clamp(2rem, 1rem + 3.4vw, 4rem);
		line-height: 1;
		text-wrap: wrap;
	}

	/* ----- Video: miniatura de 160 × 115 (imagen de 140 × 95) + texto ----- */
	.faq-video {
		display: flex;
		align-items: center;
		gap: var(--space-5); /* 24px */
		width: 100%;
		border-radius: var(--radius-lg);
	}

	.faq-video__frame {
		position: relative;
		flex-shrink: 0;
		width: 10rem; /* 160px */
		height: 7.1875rem; /* 115px */
		padding: 0.625rem; /* 10px */
	}

	.faq-video__media {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		overflow: clip;
		border-radius: 1rem; /* 16px */
	}

	.faq-video__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Onda azul recortada por la miniatura (Figma 1321:52) */
	.faq-video__wave {
		position: absolute;
		left: -24px;
		top: -27px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 192.37px;
		height: 126.73px;
	}

	.faq-video__wave :global(svg) {
		flex: none;
		width: 181.72px;
		height: 63.03px;
		max-width: none;
		transform: rotate(22.13deg) scaleY(-1) skewX(-0.29deg);
	}

	/* Copia recortada de la foto: las manos y el libro tapan la onda (Figma 1321:55) */
	.faq-video__image--front {
		-webkit-mask: url('../../../assets/graphics/shapes/cutout-faq-thumb.svg') no-repeat 17px 42px / 73.5px
			17.5px;
		mask: url('../../../assets/graphics/shapes/cutout-faq-thumb.svg') no-repeat 17px 42px / 73.5px 17.5px;
	}

	/* Botón ▶: círculo blanco de 36px + anillo translúcido de 12px */
	.faq-video__play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 2.25rem; /* 36px */
		height: 2.25rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		box-shadow: 0 0 0 12px rgb(244 244 244 / 0.32);
		color: var(--color-blue);
		transform: translate(-50%, -50%);
		transition: transform var(--duration-base) var(--ease-out);
	}

	.faq-video:hover .faq-video__play {
		transform: translate(-50%, -50%) scale(1.08);
	}

	.faq-video__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		max-width: 13.3125rem; /* 213px */
	}

	/* Figma: Poppins SemiBold 16/20 */
	.faq-video__title {
		font-weight: var(--font-weight-semibold);
		line-height: 1.25rem;
	}

	/* Figma: Poppins Regular 16/28, 64 % */
	.faq-video__duration {
		line-height: 1.75rem;
		color: var(--text-on-dark-muted);
	}

	/* Botón "Reserva llamada": 260px, texto e ícono en los extremos */
	.home-faq :global(.home-faq__cta) {
		width: 16.25rem;
		justify-content: space-between;
	}

	/* ----- Acordeón ----- */
	.home-faq__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-2); /* 8px */
	}

	.faq-item {
		border: 1px solid var(--faq-border);
		border-radius: 2.5rem; /* 40px cerrada */
		background-color: var(--surface-dark);
		transition: border-color var(--duration-base) var(--ease-out);
	}

	.faq-item[open] {
		border-radius: 2.25rem; /* 36px abierta */
	}

	.faq-item:hover {
		border-color: rgb(244 244 244 / 0.64);
	}

	.faq-item__summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 4.875rem; /* 80px con el borde */
		padding: var(--space-4) var(--space-6); /* 16px 32px */
		border-radius: inherit;
		list-style: none;
		cursor: pointer;
	}

	.faq-item__summary::-webkit-details-marker {
		display: none;
	}

	.faq-item[open] .faq-item__summary {
		min-height: 0;
	}

	/* Figma: Avenir Heavy 18/32 → Poppins SemiBold 18/32; amarillo si está abierta */
	.faq-item__question {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-semibold);
		line-height: 2rem;
		color: var(--color-pure-white);
		transition: color var(--duration-base) var(--ease-out);
	}

	.faq-item[open] .faq-item__question {
		color: var(--color-yellow);
	}

	/* Botón +/− de 36px */
	.faq-item__toggle {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--color-white);
		border-radius: var(--radius-pill);
		background-color: var(--faq-toggle-bg);
		color: var(--color-white);
	}

	.faq-item__icon {
		grid-area: 1 / 1;
	}

	.faq-item__icon--minus,
	.faq-item[open] .faq-item__icon--plus {
		display: none;
	}

	.faq-item[open] .faq-item__icon--minus {
		display: block;
	}

	/* Figma: Avenir Roman 16/24, 80 % */
	.faq-item__answer {
		max-width: 46.125rem; /* 738px */
		padding: 0 var(--space-6) var(--space-5); /* 0 32px 24px */
		margin-top: var(--space-2);
		line-height: 1.5rem;
		color: var(--text-on-dark-soft);
	}

	.faq-item__answer :global(p + p),
	.faq-item__answer :global(ul),
	.faq-item__answer :global(ol) {
		margin-top: var(--space-3);
	}

	.faq-item__answer :global(a) {
		color: var(--color-skyblue);
		text-decoration: underline;
	}

	/* ===== Tablet: una columna ===== */
	@media (max-width: 1100px) {
		.home-faq {
			min-height: 0;
		}

		.home-faq__inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-faq__decor {
			display: none;
		}
	}

	/* ===== Móvil: título centrado, sin botón (Figma UI Mobile) ===== */
	@media (max-width: 640px) {
		.home-faq__inner {
			gap: var(--space-7);
		}

		.home-faq__aside {
			align-items: stretch;
			gap: var(--space-6);
		}

		.home-faq__title {
			max-width: none;
			font-size: var(--font-size-title-mobile);
			line-height: var(--line-height-title-mobile);
			text-align: center;
		}

		.home-faq :global(.home-faq__cta) {
			display: none;
		}

		.faq-video__frame {
			width: 8.75rem;
			height: 6.25rem;
			padding: 0;
		}

		.faq-item__summary {
			padding: var(--space-3) var(--space-4);
			min-height: 3.75rem;
		}

		.faq-item__question {
			font-size: var(--font-size-md);
			line-height: 1.25rem;
		}

		.faq-item__toggle {
			width: 1.75rem;
			height: 1.75rem;
		}

		.faq-item__answer {
			padding: 0 var(--space-4) var(--space-5);
		}
	}
</style>
