---
/**
 * HomeWhyUs — "¿Por qué elegir Peruana en Rusia?"
 * --------------------------------------------------------------------------
 * Figma: Home › "Frame 628098" (1321:46)
 *   · Izquierda (1004:954): título + fotos de estudiantes y "+100 estudiantes
 *     cambiaron sus vidas".
 *   · Derecha (1316:29): tarjetas de beneficios (foto con la composición de
 *     la marca + título + texto).
 * Móvil: UI Mobile › "Frame 628098" (1407:1243): título centrado arriba y
 * las tarjetas debajo (asoma la siguiente).
 *
 * Las tarjetas se deslizan en horizontal con el scroll mientras la sección
 * cruza la pantalla (src/scripts/home-motion.ts › sliders con scroll,
 * data-scroll-slider="drift"); no hay flechas ni puntos. Sin JavaScript o con
 * "reducir movimiento" se deslizan con el dedo.
 *
 * Los beneficios y las fotos de estudiantes vienen de src/data/benefits.ts.
 * La fila empieza alineada con la columna derecha y "sangra" hacia el borde
 * derecho de la pantalla, como en el diseño.
 *
 * Uso: <HomeWhyUs /> (página de inicio, después de HomeFounder).
 */
import { Image } from 'astro:assets';

import { benefits, studentAvatars } from '@data/benefits';

// ----- Contenido de la sección -----
const content = {
	title: '¿Por qué elegir Peruana en Rusia?',
	socialProof: '+100 estudiantes cambiaron sus vidas',
	listLabel: 'Beneficios de Peruana en Rusia',
};
---

<section
	class="home-why section"
	id="por-que-elegirnos"
	aria-labelledby="home-why-title"
	data-scroll-slider="drift"
>
	<div class="home-why__inner">
		<header class="home-why__intro">
			<h2 id="home-why-title" class="home-why__title">
				{content.title}
			</h2>

			<div class="home-why__proof">
				<ul class="home-why__avatars" role="list" aria-hidden="true">
					{studentAvatars.map((avatar) => (
						<li>
							<Image src={avatar} alt="" width={48} height={48} class="home-why__avatar" />
						</li>
					))}
				</ul>
				<p class="home-why__proof-text">{content.socialProof}</p>
			</div>
		</header>

		<div class="home-why__cards" data-slider-viewport>
			<ul class="home-why__track" role="list" aria-label={content.listLabel} data-slider-track>
				{benefits.map((benefit) => (
					<li class="home-why__item" data-slider-item>
						<article class="benefit-card">
							<Image
								src={benefit.image}
								alt=""
								widths={[340, 680]}
								sizes="(max-width: 640px) 300px, 340px"
								class="benefit-card__image"
							/>
							<div class="benefit-card__body">
								<h3 class="benefit-card__title">
									{benefit.title.split('\n').map((line, index) => (
										<Fragment>
											{index > 0 && <br />}
											{line}
										</Fragment>
									))}
								</h3>
								<p class="benefit-card__text">{benefit.text}</p>
							</div>
						</article>
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.home-why {
		/* Margen interno de la fila: ahí se desvanecen las tarjetas que salen */
		--why-fade: 2.5rem;

		display: grid;
		align-content: center;
		/* Figma: 840px de alto con el contenido centrado */
		min-height: 52.5rem;
		overflow: clip;
		background-color: var(--surface-light);
		color: var(--text-on-light);
	}

	/* ----- Dos columnas: texto (503px) + carrusel que sangra a la derecha ----- */
	.home-why__inner {
		display: grid;
		grid-template-columns: minmax(0, 31.4375rem) minmax(0, 1fr); /* 503px */
		align-items: center;
		/* 120px entre columnas: 80px + 40px de margen interno de la fila (zona de desvanecido) */
		column-gap: 5rem;
		/* Margen izquierdo del contenedor estándar; a la derecha no hay margen */
		padding-left: max(var(--gutter), calc((100% - var(--container-max)) / 2));
	}

	.home-why__intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-7); /* 40px */
	}

	/* Figma: Poppins Bold 64/64 */
	.home-why__title {
		font-size: clamp(2rem, 1rem + 3.4vw, 4rem);
		line-height: 1;
		color: var(--text-heading-light);
		text-wrap: wrap;
	}

	/* ----- "+100 estudiantes": fotos superpuestas 12px ----- */
	.home-why__proof {
		display: flex;
		align-items: center;
		gap: var(--space-5); /* 24px */
	}

	.home-why__avatars {
		display: flex;
		flex-shrink: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.home-why__avatars li + li {
		margin-left: calc(-1 * var(--space-3)); /* -12px */
	}

	.home-why__avatar {
		width: 3rem; /* 48px */
		height: 3rem;
		border-radius: var(--radius-pill);
	}

	/* Figma: Poppins SemiBold 18/24 */
	.home-why__proof-text {
		max-width: 16.875rem; /* 270px */
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-semibold);
		line-height: 1.5rem;
	}

	/* ----- Tarjetas ----- */
	/* Sin slider (sin JavaScript o con "reducir movimiento"): se deslizan con el dedo */
	.home-why__cards {
		min-width: 0;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		/* Espacio para que la sombra y la elevación de las tarjetas no se recorten */
		padding-block: var(--space-3) var(--space-6);
		padding-left: var(--why-fade);
		margin-block: calc(-1 * var(--space-3)) calc(-1 * var(--space-6));
	}

	.home-why__cards::-webkit-scrollbar {
		display: none;
	}

	.home-why__track {
		display: flex;
		gap: var(--space-5); /* 24px */
		width: max-content;
		padding-right: var(--gutter);
	}

	.home-why__item {
		display: flex;
		flex-shrink: 0;
		scroll-snap-align: start;
	}

	/* Con el slider activo, la fila se desplaza con el scroll (--slider-x) */
	/* Las tarjetas se desvanecen al salir por la izquierda (sin cortes bruscos) */
	.home-why:global(.is-scroll-slider) .home-why__cards {
		overflow: hidden;
		scroll-snap-type: none;
		mask-image: linear-gradient(to right, transparent 0, #000 var(--why-fade));
	}

	.home-why:global(.is-scroll-slider) .home-why__track {
		transform: translate3d(var(--slider-x, 0px), 0, 0);
		will-change: transform;
	}

	/* ----- Tarjeta de beneficio (340px) ----- */
	.benefit-card {
		display: flex;
		flex-direction: column;
		width: 21.25rem; /* 340px */
		overflow: clip;
		border-radius: var(--radius-xl); /* 32px */
		background-color: var(--surface-white);
		/* Figma: drop-shadow 0 4px 13px rgba(38,38,38,0.1) */
		box-shadow: 0 4px 13px rgb(38 38 38 / 0.1);
	}

	.benefit-card__image {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.benefit-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-3); /* 12px */
		padding: var(--space-5) var(--space-5) var(--space-6); /* 24px 24px 32px */
	}

	/* Figma: Poppins Bold 24/28 (algo más compacto) */
	.benefit-card__title {
		font-size: 1.375rem;
		line-height: 1.625rem;
		color: var(--text-heading-light);
		text-wrap: wrap;
	}

	/* Figma: Poppins Regular 16/24, #363636 */
	.benefit-card__text {
		font-size: var(--font-size-md);
		line-height: 1.5rem;
		color: #363636;
	}

	/* ===== Tablet: título arriba y carrusel a todo el ancho ===== */
	@media (max-width: 1100px) {
		.home-why {
			min-height: 0;
		}

		.home-why__inner {
			grid-template-columns: minmax(0, 1fr);
			row-gap: var(--space-8);
		}
	}

	/* ===== Móvil (Figma 1407:1243): título centrado y una tarjeta por vista ===== */
	@media (max-width: 640px) {
		.home-why {
			padding-block: var(--space-8); /* 48px */
		}

		.home-why__inner {
			row-gap: var(--space-7); /* 40px */
			padding-left: 0;
		}

		.home-why__intro {
			align-items: center;
			padding-inline: var(--gutter);
			text-align: center;
		}

		/* Figma móvil: Poppins Bold 32/36 centrado */
		.home-why__title {
			font-size: 2rem;
			line-height: 1.125;
		}

		.home-why__proof {
			display: none;
		}

		.home-why {
			--why-fade: var(--gutter);
		}

		.home-why__track {
			gap: var(--space-3); /* 12px */
		}

		/* Tarjetas más compactas: asoma la siguiente e invita a seguir */
		.benefit-card {
			width: min(18.75rem, 80vw); /* 300px */
			border-radius: var(--radius-lg);
		}

		.benefit-card__body {
			padding: var(--space-4) var(--space-4) var(--space-5);
		}

		.benefit-card__title {
			font-size: 1.25rem;
			line-height: 1.5rem;
		}

		.benefit-card__text {
			font-size: 0.9375rem;
			line-height: 1.4375rem;
		}
	}
</style>
