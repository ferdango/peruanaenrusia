---
/**
 * UniversityOverview — "De un vistazo"
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Universidad Single" (3333:276) › "Frame 628426"
 * (3322:144, fotos) y "Frame 628444" (3333:268, descripción + "La
 * universidad cuenta con:").
 *
 * Desktop: el texto (descripción y la lista "La universidad cuenta con:" en
 * una tarjeta) a la izquierda y las fotos a la derecha, superpuestas, con la
 * ilustración del edificio de la Figma y una estrella de la marca. Móvil:
 * todo en una columna.
 *
 * Si la universidad todavía no tiene contenido de ficha, muestra qué te
 * podemos contar (carreras, becas, requisitos, vida en la ciudad) y el botón
 * de WhatsApp.
 *
 * Uso: <UniversityOverview id="de-un-vistazo" university={university} />
 */
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import UniversityStarList from './UniversityStarList.astro';
import { whatsappUrl } from '@data/site';
import type { University } from '@data/universities';
import Building from '@assets/graphics/illustrations/university-building.svg';
import Star from '@assets/graphics/stars/star-4-point.svg';

interface Props {
	/** id del ancla (lo usa la píldora de navegación) */
	id: string;
	university: University;
}

const { id, university } = Astro.props;
const { gallery = [], description = [], highlights = [] } = university;

// ----- Contenido de la sección -----
const content = {
	eyebrow: 'De un vistazo',
	title: `Conoce la ${university.name}`,
	highlightsLead: 'La universidad cuenta con:',
	pending: {
		title: 'Estamos preparando la ficha completa',
		text: 'Mientras tanto, escríbenos y te contamos todo lo que necesitas saber sobre esta universidad:',
		topics: [
			'Carreras y programas disponibles',
			'Becas del Gobierno de Rusia y requisitos',
			'Año preparatorio de idioma ruso',
			'Vida estudiantil y costo de vida en la ciudad',
		],
		cta: 'Escríbenos por WhatsApp',
		ctaHint: ' (se abre en una pestaña nueva)',
	},
};

const hasBody = description.length > 0 || highlights.length > 0;
/** Fotos de la columna derecha: la galería o, si no hay, la foto principal */
const photos = gallery.length > 0 ? gallery.slice(0, 2) : [{ src: university.image, alt: '' }];
---

<section id={id} class="university-overview section" aria-labelledby={`${id}-title`}>
	<div class="university-overview__inner container">
		<div class="university-overview__text">
			<p class="university-overview__eyebrow">
				<Star class="university-overview__eyebrow-star" aria-hidden="true" />
				{content.eyebrow}
			</p>
			<h2 id={`${id}-title`} class="university-overview__title">
				{content.title}
			</h2>

			{hasBody ? (
				<Fragment>
					{description.map((paragraph) => (
						<p class="university-overview__paragraph">{paragraph}</p>
					))}

					{highlights.length > 0 && (
						<div class="university-overview__highlights">
							<p class="university-overview__lead">{content.highlightsLead}</p>
							<UniversityStarList items={highlights} />
						</div>
					)}
				</Fragment>
			) : (
				<div class="university-overview__pending">
					<p class="university-overview__pending-title">{content.pending.title}</p>
					<p class="university-overview__paragraph">{content.pending.text}</p>
					<UniversityStarList items={content.pending.topics} />
					<Button
						href={whatsappUrl}
						tone="blue"
						size="md"
						icon="whatsapp"
						target="_blank"
						rel="noopener"
					>
						{content.pending.cta}
						<span class="visually-hidden">{content.pending.ctaHint}</span>
					</Button>
				</div>
			)}
		</div>

		<div class:list={['university-overview__media', { 'is-single': photos.length === 1 }]}>
			{photos.map((photo, index) => (
				<div class:list={['university-overview__photo', `university-overview__photo--${index + 1}`]}>
					<MediaImage
						image={photo.src}
						alt={photo.alt}
						widths={[480, 800, 1200]}
						sizes="(max-width: 1100px) 92vw, 36rem"
						class="university-overview__image"
					/>
				</div>
			))}

			<span class="university-overview__building" aria-hidden="true">
				<Building />
			</span>
			<span class="university-overview__badge" aria-hidden="true">
				<Icon name="landmark" size={22} />
			</span>
		</div>
	</div>
</section>

<style>
	.university-overview {
		position: relative;
		overflow: clip;
		background-color: var(--surface-white);
		color: var(--text-on-light);
		scroll-margin-top: var(--header-height);
	}

	.university-overview__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: center;
		gap: clamp(var(--space-8), 5vw, var(--space-10));
	}

	/* ===== Texto ===== */
	.university-overview__text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-5);
	}

	.university-overview__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border-radius: var(--radius-pill);
		background-color: rgb(0 122 252 / 0.1);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
		color: var(--color-blue-title);
	}

	.university-overview__eyebrow-star {
		width: 1rem;
		height: 1rem;
		color: var(--color-red);
	}

	.university-overview__title {
		font-size: var(--font-size-h1);
		line-height: 1.1;
		color: var(--text-heading-light);
		text-wrap: balance;
	}

	/* Figma: Poppins Regular 24/36 */
	.university-overview__paragraph {
		font-size: var(--font-size-lg);
		line-height: 1.8rem;
		color: #2c3030;
	}

	/* "La universidad cuenta con:" en una tarjeta celeste */
	.university-overview__highlights {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		width: 100%;
		padding: var(--space-6);
		border-radius: var(--radius-xl);
		background-color: #eef7fc;
	}

	.university-overview__lead {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
		color: var(--color-blue-title);
	}

	.university-overview__highlights :global(.star-list),
	.university-overview__pending :global(.star-list) {
		padding-left: 0;
	}

	.university-overview__highlights :global(.star-list__item),
	.university-overview__pending :global(.star-list__item) {
		align-items: flex-start;
		font-size: var(--font-size-md);
		line-height: 1.6rem;
	}

	.university-overview__highlights :global(.star-list__icon),
	.university-overview__pending :global(.star-list__icon) {
		width: 1.25rem;
		height: auto;
		margin-top: 0.2em;
	}

	/* Universidad sin ficha completa */
	.university-overview__pending {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		width: 100%;
		padding: var(--space-7);
		border: 1px solid rgb(0 122 252 / 0.16);
		border-radius: var(--radius-xl);
		background: radial-gradient(28rem 14rem at 100% 0%, rgb(0 192 252 / 0.14), transparent 70%), #f6fbfe;
	}

	.university-overview__pending-title {
		font-size: var(--font-size-h4);
		font-weight: var(--font-weight-bold);
		line-height: 1.3;
		color: var(--color-blue-title);
	}

	.university-overview__pending :global(.btn) {
		margin-top: var(--space-2);
	}

	/* ===== Fotos superpuestas + figuras de la marca ===== */
	.university-overview__media {
		position: relative;
		aspect-ratio: 1 / 1.05;
	}

	.university-overview__photo {
		position: absolute;
		overflow: clip;
		border-radius: var(--radius-xl);
		box-shadow: 0 2rem 4rem -2rem rgb(18 91 168 / 0.55);
	}

	.university-overview__photo--1 {
		top: 0;
		right: 0;
		width: 78%;
		height: 70%;
	}

	.university-overview__photo--2 {
		bottom: 0;
		left: 0;
		width: 58%;
		height: 52%;
		border: 6px solid var(--surface-white);
	}

	.university-overview__media.is-single .university-overview__photo--1 {
		inset: 6% 0 0 8%;
		width: auto;
		height: auto;
	}

	.university-overview__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 1s var(--ease-out);
	}

	.university-overview__photo:hover .university-overview__image {
		scale: 1.05;
	}

	/* Ilustración del edificio (cabecera de la ficha en Figma) */
	.university-overview__building {
		position: absolute;
		right: -2%;
		bottom: 2%;
		width: 34%;
		pointer-events: none;
	}

	.university-overview__building :global(svg) {
		width: 100%;
		height: auto;
	}

	.university-overview__media.is-single .university-overview__building {
		right: auto;
		left: -4%;
		bottom: -4%;
	}

	.university-overview__badge {
		position: absolute;
		top: 8%;
		left: 10%;
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-yellow);
		box-shadow: 0 1rem 2rem -0.75rem rgb(0 0 0 / 0.35);
		color: #002546;
	}

	.university-overview__media.is-single .university-overview__badge {
		top: 0;
		left: 0;
	}

	/* ===== Tablet y móvil: una columna ===== */
	@media (max-width: 1100px) {
		.university-overview__inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.university-overview__media {
			width: min(100%, 36rem);
			margin-inline: auto;
		}
	}

	@media (max-width: 640px) {
		.university-overview__title {
			font-size: var(--font-size-title-mobile);
			line-height: var(--line-height-title-mobile);
		}

		.university-overview__paragraph {
			font-size: var(--font-size-md);
			line-height: 1.6rem;
		}

		.university-overview__highlights,
		.university-overview__pending {
			padding: var(--space-5);
			border-radius: var(--radius-lg);
		}

		.university-overview__photo {
			border-radius: var(--radius-lg);
		}

		.university-overview__badge {
			width: 3.25rem;
			height: 3.25rem;
		}
	}
</style>
