---
/**
 * AuthModal — inicio de sesión / registro (modal de varios pasos)
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Modal Login" y "Modal Registrate" (867 × 680):
 *   Login 1    → 1797:4340  "Inicia sesión o regístrate en segundos"
 *   Login 2    → 1807:4433  "Usar mi correo personal"
 *   Login 3    → 1809:4532  "Termina de iniciar sesión" (código)
 *   Registro 1 → 1809:4573  "Crear mi cuenta" (correo)
 *   Registro 2 → 1809:4622  "Crear mi cuenta" (nombre)
 *   Registro 3 → 1809:4671  "Solo un paso más" (código)
 *   Botón cerrar → 1803:4396 (fuera del panel, arriba a la derecha)
 *
 * Estructura: imagen lateral (AuthArt, igual en todos los pasos) + panel con
 * los 6 pasos; solo uno visible a la vez. El comportamiento (navegación entre
 * pasos, validación, foco, reenvío del código…) vive en src/scripts/auth-flow.ts.
 *
 * Cómo se abre:
 *   <button data-dialog-open="auth-modal">Inicia sesión</button>
 *   <button data-dialog-open="auth-modal" data-auth-view="register">Regístrate</button>
 *   <a href="#" data-auth-view="register">Crear cuenta</a>   ← también funciona sin data-dialog-open
 *
 * Responsive: en tablet la imagen se angosta y la X pasa dentro del panel;
 * en móvil (sin diseño en Figma) es una hoja a pantalla completa sin imagen.
 *
 * Los textos de cada paso están en `steps` y `fields` (abajo).
 *
 * Backend: el botón de Google lleva a /api/auth/google/ y los formularios
 * llaman a /api/auth/email/* (ver src/scripts/auth-flow.ts y src/pages/api/auth/).
 * Para abrir el modal desde cualquier página con un aviso: /?login=1
 * (opcional: &auth_error=… y &next=/ruta/ a la que volver).
 */
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import AuthArt from './AuthArt.astro';
import AuthField from './AuthField.astro';
import AuthGoogleButton from './AuthGoogleButton.astro';
import { routes } from '@data/navigation';
import type { AuthStep } from '@scripts/auth-flow';

// ----- Textos comunes -----
const content = {
	close: 'Cerrar',
	back: 'Volver al paso anterior',
	continue: 'Continuar',
	manual: 'Continuar manualmente',
	or: 'O bien',
	noAccount: '¿No tienes una cuenta?',
	register: 'Regístrate aquí',
	noCode: '¿No recibiste el código?',
	resend: 'Volver a enviarlo',
	/** {email} se reemplaza por el correo ingresado */
	resent: 'Listo, te enviamos un nuevo código a {email}.',
	legal: {
		before: 'He leído y acepto la ',
		link: 'Política de Privacidad',
		after: ' y protección de datos de Peruana en Rusia',
	},
};

// ----- Campos de formulario -----
const fields = {
	email: {
		label: 'Correo (personal o del trabajo)',
		name: 'email',
		type: 'email',
		inputmode: 'email',
		autocomplete: 'email',
		autocapitalize: 'off',
		spellcheck: false,
		placeholder: 'tucorreo@gmail.com',
		required: true,
		// Exige un dominio con punto (ej. gmail.com), además del formato nativo de email
		pattern: '[^@\\s]+@[^@\\s]+\\.[^@\\s]+',
		messages: {
			required: 'Ingresa tu correo.',
			invalid: 'Ingresa un correo válido, por ejemplo: tucorreo@gmail.com.',
		},
	},
	name: {
		label: 'Nombre',
		name: 'name',
		type: 'text',
		autocomplete: 'given-name',
		placeholder: 'Tu nombre',
		required: true,
		maxlength: 60,
		messages: { required: 'Ingresa tu nombre.' },
	},
	code: {
		label: 'Código',
		name: 'code',
		type: 'text',
		inputmode: 'numeric',
		autocomplete: 'one-time-code',
		placeholder: 'Ingresa el código',
		required: true,
		pattern: '[0-9]{6}',
		messages: {
			required: 'Ingresa el código que te enviamos a tu correo.',
			invalid: 'El código tiene 6 números.',
		},
	},
} as const;

// ----- Pasos del flujo (el orden y los enlaces "‹" / Continuar) -----
interface StepConfig {
	id: AuthStep;
	/** intro = elegir método; email / name / code = formulario con ese campo */
	kind: 'intro' | 'email' | 'name' | 'code';
	title: string;
	text: string;
	/** Si existe, después de `text` se muestra el correo ingresado y luego este texto */
	textAfterEmail?: string;
	/** Paso al que lleva la flecha "‹" */
	back?: AuthStep;
	/** Paso siguiente al enviar el formulario (si no hay, se entra al portal) */
	next?: AuthStep;
}

const steps: StepConfig[] = [
	{
		id: 'login',
		kind: 'intro',
		title: 'Inicia sesión o regístrate en segundos',
		text: 'Para acceder al proceso, usa tu correo o tu cuenta de Google',
	},
	{
		id: 'login-email',
		kind: 'email',
		title: 'Usar mi correo personal',
		text: 'Verificaremos si tienes una cuenta. Si no tienes una, te ayudaremos a crearla.',
		back: 'login',
		next: 'login-code',
	},
	{
		id: 'login-code',
		kind: 'code',
		title: 'Termina de iniciar sesión',
		text: 'Podrás iniciar sesión una vez que escribas el código que te enviamos a ',
		textAfterEmail: '.',
		back: 'login-email',
	},
	{
		id: 'register-email',
		kind: 'email',
		title: 'Crear mi cuenta',
		text: 'Verificaremos si tienes una cuenta. Si no tienes una, te ayudaremos a crearla.',
		back: 'login',
		next: 'register-name',
	},
	{
		id: 'register-name',
		kind: 'name',
		title: 'Crear mi cuenta',
		text: 'Vas a crear una cuenta de Peruana en Rusia con ',
		textAfterEmail: '',
		back: 'register-email',
		next: 'register-code',
	},
	{
		id: 'register-code',
		kind: 'code',
		title: 'Solo un paso más',
		text: 'Para terminar de registrarte, escribe el código que te enviamos a ',
		textAfterEmail: '.',
		back: 'register-name',
	},
];

const titleId = (step: StepConfig) => `auth-${step.id}-title`;
---

<dialog
	id="auth-modal"
	class="auth-modal"
	aria-labelledby={titleId(steps[0])}
	data-auth-redirect={routes.portal}
>
	<div class="auth-modal__card">
		<div class="auth-modal__media">
			<AuthArt />
		</div>

		<div class="auth-modal__panel" data-auth-panel>
			<!-- Anuncia el paso actual a lectores de pantalla -->
			<p class="visually-hidden" aria-live="polite" data-auth-announcer></p>

			{steps.map((step, index) => (
				<div class="auth-step" data-auth-step={step.id} hidden={index > 0}>
					<div class="auth-step__header">
						<div class="auth-step__heading">
							{step.back && (
								<button type="button" class="auth-step__back" data-auth-goto={step.back}>
									<Icon name="chevron-left" size={24} title={content.back} />
								</button>
							)}
							<h2 id={titleId(step)} class="auth-step__title" tabindex="-1" data-auth-title>
								{step.title}
							</h2>
						</div>

						<p
							class:list={[
								'auth-step__text',
								{ 'auth-step__text--intro': step.kind === 'intro' },
							]}
						>
							{step.text}
							{step.textAfterEmail !== undefined && (
								<Fragment>
									<span class="auth-step__email" data-auth-email />
									{step.textAfterEmail}
								</Fragment>
							)}
						</p>
					</div>

					<!-- Avisos de error (Google cancelado, correo no disponible…) -->
					<p class="auth-step__alert" role="alert" data-auth-alert />

					{step.kind === 'intro' ? (
						<div class="auth-step__body">
							<div class="auth-step__group">
								<AuthGoogleButton />
								<button type="button" class="auth-step__option" data-auth-goto="login-email">
									{content.manual}
								</button>
								<p class="auth-step__legal">
									{content.legal.before}
									<a href={routes.legal}>{content.legal.link}</a>
									{content.legal.after}
								</p>
							</div>

							<p class="auth-step__switch">
								{content.noAccount}
								<button
									type="button"
									class="auth-step__link auth-step__link--strong"
									data-auth-goto="register-email"
								>
									{content.register}
								</button>
							</p>
						</div>
					) : (
						<form
							class="auth-step__form"
							data-auth-form={step.id}
							data-auth-next={step.next}
							data-auth-complete={step.next ? undefined : ''}
							novalidate
						>
							<div class="auth-step__group">
								<AuthField id={`auth-${step.id}-input`} {...fields[step.kind]} />
								<Button type="submit" variant="primary" size="sm" block>
									{content.continue}
								</Button>
								{step.kind !== 'code' && (
									<p class="auth-step__legal">
										{content.legal.before}
										<a href={routes.legal}>{content.legal.link}</a>
										{content.legal.after}
									</p>
								)}
							</div>

							{step.kind === 'code' && (
								<Fragment>
									<p class="auth-step__divider">{content.or}</p>
									<AuthGoogleButton />
									<p class="auth-step__switch auth-step__switch--center">
										{content.noCode}
										<button type="button" class="auth-step__link" data-auth-resend>
											{content.resend}
										</button>
									</p>
									<p
										class="auth-step__status"
										role="status"
										data-auth-status
										data-message={content.resent}
									/>
								</Fragment>
							)}
						</form>
					)}
				</div>
			))}
		</div>
	</div>

	<button type="button" class="auth-modal__close" data-dialog-close>
		<Icon name="close-circle" size={40} title={content.close} />
	</button>
</dialog>

<script>
	import { initAuthFlow } from '@scripts/auth-flow';
	initAuthFlow();
</script>

<style>
	/* ----- <dialog>: centrado, sin estilos del navegador ----- */
	.auth-modal {
		/* Colores de Figma sin token propio */
		--auth-option-bg: #ebecec; /* Botón "Continuar manualmente" */
		--auth-button-text: #002546; /* Texto del botón amarillo "Continuar" */

		position: fixed;
		inset: 0;
		width: fit-content;
		height: fit-content;
		max-width: none;
		max-height: none;
		margin: auto;
		padding: 0;
		border: 0;
		overflow: visible;
		background: transparent;
		color: var(--text-on-light);
	}

	.auth-modal::backdrop {
		background: rgb(0 0 0 / 0.55);
		backdrop-filter: blur(2px);
	}

	.auth-modal[open] .auth-modal__card,
	.auth-modal[open] .auth-modal__close {
		animation: auth-modal-in var(--duration-slow) var(--ease-out);
	}

	@keyframes auth-modal-in {
		from {
			opacity: 0;
			transform: translateY(16px) scale(0.98);
		}
	}

	/* ----- Tarjeta: imagen (419px) + panel del formulario (400px) ----- */
	.auth-modal__card {
		display: flex;
		width: 51.1875rem; /* 819px */
		max-width: calc(100vw - 2 * var(--space-4));
		height: 42.5rem; /* 680px */
		max-height: calc(100dvh - 2 * var(--space-4));
		overflow: clip;
		border-radius: var(--radius-xl);
		background-color: var(--surface-light);
	}

	.auth-modal__media {
		flex: 1 1 26.1875rem; /* 419px; en pantallas medianas se angosta */
		min-width: 0;
	}

	.auth-modal__panel {
		flex: 0 0 25rem; /* 400px */
		padding: var(--space-7) var(--space-8); /* 40px 48px */
		overflow-y: auto;
		overscroll-behavior: contain;
		background-color: var(--surface-light);
	}

	/* ----- Botón cerrar: círculo de 40px fuera de la tarjeta, arriba a la derecha ----- */
	.auth-modal__close {
		position: absolute;
		top: 0;
		left: calc(100% + var(--space-2));
		display: grid;
		place-items: center;
		width: 2.5rem; /* 40px */
		height: 2.5rem;
		border-radius: var(--radius-pill);
		transition: filter var(--duration-base) var(--ease-out);
	}

	.auth-modal__close :global(svg) {
		width: 100%;
		height: 100%;
	}

	.auth-modal__close:hover {
		filter: brightness(1.3);
	}

	/* ----- Paso ----- */
	.auth-step {
		display: flex;
		flex-direction: column;
		gap: var(--space-7); /* 40px */
		animation: auth-step-in var(--duration-base) var(--ease-out);
	}

	.auth-step[hidden] {
		display: none;
	}

	@keyframes auth-step-in {
		from {
			opacity: 0;
			transform: translateX(12px);
		}
	}

	.auth-step__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-4); /* 16px */
	}

	.auth-step__heading {
		display: flex;
		align-items: center;
		gap: var(--space-1); /* 4px */
	}

	/* Flecha "‹" (Figma: ep:arrow-up-bold rotado = ícono chevron-left) */
	.auth-step__back {
		position: relative;
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 24px;
		height: 24px;
		color: var(--text-on-light);
		transition: color var(--duration-base) var(--ease-out);
	}

	/* Área táctil de 44px sin cambiar el diseño */
	.auth-step__back::before {
		content: '';
		position: absolute;
		inset: -10px;
	}

	.auth-step__back:hover {
		color: var(--color-blue-title);
	}

	/* Figma: Poppins Bold 28/32 */
	.auth-step__title {
		flex: 1;
		min-width: 0;
		font-size: var(--font-size-h3);
		font-weight: var(--font-weight-bold);
		line-height: 1.143;
		color: var(--text-on-light);
		/* Cortes de línea como en Figma (sin el "balance" global de los títulos) */
		text-wrap: wrap;
	}

	/* El título recibe el foco al cambiar de paso (solo para lectores de pantalla) */
	.auth-step__title:focus,
	.auth-step__title:focus-visible {
		outline: none;
		box-shadow: none;
	}

	/* Figma: Poppins Regular 15/20 (14/20 en el primer paso) */
	.auth-step__text {
		font-size: var(--font-size-nav);
		line-height: 1.25rem;
	}

	.auth-step__text--intro {
		font-size: var(--font-size-sm);
	}

	.auth-step__email {
		overflow-wrap: anywhere;
	}

	/* ----- Cuerpo del paso ----- */
	.auth-step__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-7); /* 40px */
	}

	.auth-step__form {
		display: flex;
		flex-direction: column;
		gap: var(--space-4); /* 16px */
	}

	.auth-step__group {
		display: flex;
		flex-direction: column;
		gap: var(--space-3); /* 12px */
	}

	/* Botón amarillo "Continuar" (Button primary): alto 52px, radio 12px, texto 16px */
	.auth-step :global(.btn--primary) {
		min-height: 3.25rem;
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		font-size: var(--font-size-md);
		color: var(--auth-button-text);
	}

	/* "Continuar manualmente" — Figma: fondo gris, alto 52px, Circular Std Medium 15/20 */
	.auth-step__option {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 3.25rem;
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		background-color: var(--auth-option-bg);
		font-size: var(--font-size-nav);
		font-weight: var(--font-weight-medium);
		line-height: 1.25rem;
		color: var(--text-on-light);
		transition: background-color var(--duration-base) var(--ease-out);
	}

	.auth-step__option:hover {
		background-color: color-mix(in srgb, var(--auth-option-bg) 90%, var(--color-black));
	}

	/* Nota de privacidad — Figma: Circular Std Book 12/14 */
	.auth-step__legal {
		font-size: var(--font-size-xs);
		line-height: 0.875rem;
	}

	.auth-step__legal a {
		color: var(--text-heading-light);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
		text-underline-offset: 2px;
		transition: text-decoration-color var(--duration-base) var(--ease-out);
	}

	.auth-step__legal a:hover {
		text-decoration-color: currentColor;
	}

	/* "¿No tienes una cuenta? Regístrate aquí" / "¿No recibiste el código? Volver a enviarlo" */
	.auth-step__switch {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 var(--space-2);
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
	}

	.auth-step__switch--center {
		justify-content: center;
		text-align: center;
	}

	.auth-step__link {
		color: var(--text-heading-light);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
		text-underline-offset: 2px;
		transition: text-decoration-color var(--duration-base) var(--ease-out);
	}

	.auth-step__link:hover {
		text-decoration-color: currentColor;
	}

	.auth-step__link[aria-disabled='true'] {
		cursor: default;
		opacity: 0.6;
	}

	/* "Regístrate aquí" va en seminegrita y sin subrayado (Figma) */
	.auth-step__link--strong {
		font-weight: var(--font-weight-semibold);
		text-decoration-color: transparent;
	}

	/* "O bien" — Figma: Circular Std Medium 14/20, negro 74 % */
	.auth-step__divider {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-medium);
		line-height: 1.25rem;
		color: color-mix(in srgb, var(--color-black) 74%, transparent);
		text-align: center;
	}

	/* Aviso de error del paso (vacío no ocupa espacio) */
	.auth-step__alert {
		margin-block: calc(-1 * var(--space-4)) calc(-1 * var(--space-2));
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		background-color: rgb(255 26 48 / 0.08);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-medium);
		line-height: 1.25rem;
		color: color-mix(in srgb, var(--color-red) 75%, var(--color-black));
	}

	.auth-step__alert:empty {
		display: none;
	}

	/* Botón "Continuar" mientras se espera la respuesta del servidor */
	.auth-step :global(.btn[aria-disabled='true']) {
		opacity: 0.7;
		cursor: progress;
		pointer-events: none;
	}

	/* Confirmación de "Volver a enviarlo" (vacía no ocupa espacio) */
	.auth-step__status {
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-medium);
		line-height: 1rem;
		color: var(--color-green);
		text-align: center;
	}

	/* ----- Tablet: la imagen se angosta y la X entra al panel ----- */
	@media (max-width: 1100px) {
		.auth-modal__close {
			top: var(--space-3);
			right: var(--space-3);
			left: auto;
			z-index: 1;
			width: var(--space-6); /* 32px */
			height: var(--space-6);
		}
	}

	/* ----- Móvil (sin diseño en Figma): hoja a pantalla completa, sin imagen ----- */
	@media (max-width: 640px) {
		.auth-modal {
			width: 100%;
			height: 100dvh;
		}

		.auth-modal[open] .auth-modal__card {
			animation-name: auth-sheet-in;
		}

		@keyframes auth-sheet-in {
			from {
				transform: translateY(24px);
				opacity: 0;
			}
		}

		.auth-modal__card {
			width: 100%;
			max-width: none;
			height: 100%;
			max-height: none;
			border-radius: 0;
		}

		.auth-modal__media {
			display: none;
		}

		.auth-modal__panel {
			flex: 1 1 auto;
			padding: var(--space-9) var(--space-5) var(--space-6); /* 64px 24px 32px */
		}

		.auth-step {
			max-width: 25rem;
			margin-inline: auto;
		}
	}
</style>
