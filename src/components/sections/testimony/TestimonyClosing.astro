---
/**
 * TestimonyClosing — Video + cita final del estudiante
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "My testimony" (1616:222) › "Frame 628321" (1734:2246)
 * + onda roja (1732:2116). Móvil: UI Mobile › 1758:3915 / 1758:3662.
 *
 * Izquierda: miniatura vertical del video con botón ▶. Derecha: el símbolo
 * de la marca, la cita (`closing.quote`), un párrafo (`closing.text`) y la
 * firma del estudiante. La onda roja de la marca cruza la sección por detrás
 * del video y se dibuja con el scroll (src/scripts/scroll-draw.ts).
 *
 * VIDEO: en el modal del sitio, como "Conoce mi historia": el de
 * `testimonial.video.url` o, si el caso no tiene video propio, el testimonio
 * de TikTok del Home (vertical, como la miniatura; src/data/testimonials.ts ›
 * testimonialVideo).
 *
 * Uso: <TestimonyClosing testimonial={testimonial} />
 */
import { Image } from 'astro:assets';

import Logo from '@components/brand/Logo.astro';
import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import { countries } from '@data/countries';
import { testimonialVideo, type Testimonial } from '@data/testimonials';
import WaveRed from '@assets/graphics/waves/wave-red-closing.svg';

interface Props {
	testimonial: Testimonial;
}

const { testimonial } = Astro.props;
const { closing } = testimonial;
const country = countries[testimonial.country];

// ----- Contenido de la sección -----
const content = {
	watch: 'Ver video',
	playLabel: `Ver el video de ${testimonial.name}`,
};

const poster = testimonial.video?.poster;
const video = testimonialVideo(testimonial, 'tiktok');

/** Nombre del video: el del caso o, si no tiene video propio, el del video del Home */
const videoTitle = video.title ?? content.playLabel;
const videoLabel = video.title ? `Ver el video: ${video.title}` : content.playLabel;

/** Enlace del video: en el modal del sitio (sin JavaScript, en una pestaña nueva) */
const videoLink = {
	href: video.href,
	target: '_blank',
	rel: 'noopener',
	...(video.youtubeId || video.tiktokId
		? {
				'data-video-open': '',
				'data-video-title': videoTitle,
				...(video.youtubeId
					? { 'data-video-youtube': video.youtubeId }
					: { 'data-video-tiktok': video.tiktokId }),
			}
		: {}),
};
---

{closing && (
	<section
		class="testimony-closing"
		aria-label={`Mensaje final de ${testimonial.name}`}
		data-scroll-draw="0.95 0.35"
	>
		<div class="testimony-closing__decor" aria-hidden="true">
			<div class="testimony-closing__wave">
				<WaveRed />
			</div>
		</div>

		<div class="testimony-closing__inner container">
			{poster && (
				<a class="testimony-closing__media" aria-label={videoLabel} {...videoLink}>
					<MediaImage
						image={poster.src}
						alt=""
						widths={[640, 1100, 1600]}
						sizes="(max-width: 640px) 92vw, 36rem"
						class="testimony-closing__image"
					/>
					<span class="testimony-closing__shade" aria-hidden="true"></span>
					<span class="testimony-closing__play" aria-hidden="true">
						<Icon name="play" size={30} />
					</span>
					<span class="testimony-closing__chip" aria-hidden="true">
						<Icon name="play" size={12} />
						{content.watch}
					</span>
				</a>
			)}

			<figure class="testimony-closing__text">
				<Logo variant="symbol" color="brand" width={58} class="testimony-closing__symbol" />
				<blockquote class="testimony-closing__quote">
					<p>“{closing.quote}”</p>
				</blockquote>
				<p class="testimony-closing__paragraph">{closing.text}</p>

				<figcaption class="testimony-closing__author">
					<span class="testimony-closing__avatar-ring">
						<MediaImage
							image={testimonial.avatar}
							alt=""
							width={48}
							height={48}
							class="testimony-closing__avatar"
						/>
						<Image
							src={country.flag}
							alt={country.name}
							width={20}
							height={20}
							densities={[1, 2]}
							class="testimony-closing__flag"
						/>
					</span>
					<span class="testimony-closing__who">
						<strong class="testimony-closing__name">{testimonial.name}</strong>
						<span>{testimonial.role}</span>
					</span>
				</figcaption>
			</figure>
		</div>
	</section>
)}

<style>
	.testimony-closing {
		position: relative;
		isolation: isolate;
		overflow: clip;
		padding-block: clamp(var(--space-9), 6vw, 6rem);
		background-color: var(--color-white);
		color: var(--text-on-light);
	}

	/* ----- Onda roja: lienzo de 1512px centrado (coordenadas de Figma) ----- */
	.testimony-closing__decor {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: -1;
		width: 1512px;
		height: 100%;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.testimony-closing__wave {
		position: absolute;
		top: 33.875rem; /* 542px */
		left: -129px;
	}

	.testimony-closing__wave :global(svg) {
		max-width: none;
	}

	/* Se dibuja con el scroll (--draw); sin JavaScript, completa */
	.testimony-closing__wave :global(.brand-line) {
		stroke-dasharray: 100 100;
		stroke-dashoffset: calc(100 - 100 * clamp(0, (var(--draw, 1) - 0.15) / 0.7, 1));
	}

	/* ----- Video (580 × 640) + texto (537px) ----- */
	.testimony-closing__inner {
		display: grid;
		grid-template-columns: minmax(0, 36.25rem) minmax(0, 33.5625rem);
		align-items: center;
		justify-content: center;
		gap: clamp(var(--space-7), 6vw, var(--space-10));
	}

	.testimony-closing__media {
		position: relative;
		isolation: isolate;
		display: block;
		aspect-ratio: 580 / 640;
		overflow: clip;
		border-radius: var(--radius-xl); /* 32px */
		background-color: #1d2a3a;
		box-shadow: 0 2rem 4rem -2rem rgb(23 26 26 / 0.45);
		color: var(--color-pure-white);
	}

	.testimony-closing__image {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 35% center;
		transition: scale 1s var(--ease-out);
	}

	.testimony-closing__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(to top, rgb(6 10 20 / 0.4), transparent 40%);
	}

	/* Botón ▶: círculo blanco con anillo translúcido */
	.testimony-closing__play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 4.75rem;
		height: 4.75rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		box-shadow:
			0 0 0 1rem rgb(255 255 255 / 0.26),
			0 1rem 2rem -0.75rem rgb(0 0 0 / 0.55);
		color: var(--color-blue);
		translate: -50% -50%;
		transition: scale var(--duration-slow) var(--ease-out);
	}

	.testimony-closing__play :global(svg) {
		margin-left: 0.25rem;
	}

	.testimony-closing__chip {
		position: absolute;
		top: var(--space-5);
		left: var(--space-5);
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem;
		border-radius: var(--radius-pill);
		background-color: rgb(0 0 0 / 0.5);
		backdrop-filter: blur(8px);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
	}

	.testimony-closing__media:hover .testimony-closing__image {
		scale: 1.04;
	}

	.testimony-closing__media:hover .testimony-closing__play {
		scale: 1.08;
	}

	.testimony-closing__media:focus-visible {
		outline: 3px solid var(--color-blue);
		outline-offset: 4px;
	}

	/* ----- Texto ----- */
	.testimony-closing__text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-6);
		margin: 0;
	}

	.testimony-closing__quote {
		font-size: var(--font-size-h2); /* 40px */
		font-weight: var(--font-weight-bold);
		line-height: 1.2; /* 48px */
		color: var(--color-blue-title);
		text-wrap: balance;
	}

	.testimony-closing__paragraph {
		font-size: var(--font-size-lg);
		line-height: 1.75rem;
		color: color-mix(in srgb, var(--text-on-light) 82%, transparent);
	}

	/* Firma: foto con anillo degradé y bandera + nombre y carrera */
	.testimony-closing__author {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding-top: var(--space-5);
		border-top: 1px solid rgb(23 26 26 / 0.12);
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
		color: #363636;
	}

	.testimony-closing__avatar-ring {
		position: relative;
		flex-shrink: 0;
		padding: 2px;
		border-radius: var(--radius-pill);
		background: linear-gradient(135deg, var(--color-skyblue), var(--color-red));
	}

	.testimony-closing__avatar {
		display: block;
		width: 3rem;
		height: 3rem;
		border: 2px solid var(--color-white);
		border-radius: var(--radius-pill);
		object-fit: cover;
	}

	.testimony-closing__flag {
		position: absolute;
		right: -0.25rem;
		bottom: -0.125rem;
		width: 1.25rem;
		height: 1.25rem;
		border: 2px solid var(--color-white);
		border-radius: var(--radius-pill);
		object-fit: cover;
	}

	.testimony-closing__who {
		display: flex;
		flex-direction: column;
	}

	.testimony-closing__name {
		font-size: var(--font-size-md);
		color: var(--color-blue-title);
	}

	/* ----- Tablet ----- */
	@media (max-width: 1100px) {
		.testimony-closing__inner {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		}

		.testimony-closing__quote {
			font-size: var(--font-size-h3);
		}

		.testimony-closing__paragraph {
			font-size: var(--font-size-md);
			line-height: 1.625rem;
		}
	}

	/* ----- Móvil: video arriba, luego símbolo + cita + párrafo + firma ----- */
	@media (max-width: 640px) {
		.testimony-closing {
			padding-block: var(--space-9);
		}

		.testimony-closing__inner {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-7);
			padding-inline: var(--space-3);
		}

		.testimony-closing__media {
			aspect-ratio: 4 / 5;
			border-radius: var(--radius-lg);
		}

		/* La onda roja cruza la parte baja del video */
		.testimony-closing__decor {
			top: var(--space-9);
			left: 0;
			z-index: 1;
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 5;
			transform: none;
		}

		.testimony-closing__wave {
			top: 78%;
			left: -60%;
			width: 200%;
		}

		.testimony-closing__wave :global(svg) {
			width: 100%;
			height: auto;
		}

		.testimony-closing__text {
			gap: var(--space-5);
			padding-inline: var(--space-2);
		}

		.testimony-closing__quote {
			font-size: 1.75rem;
			line-height: 1.2;
		}

		.testimony-closing__paragraph {
			font-size: var(--font-size-md);
			line-height: 1.5rem;
		}
	}
</style>
