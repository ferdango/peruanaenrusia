---
/**
 * SiteHeader
 * --------------------------------------------------------------------------
 * Barra superior fija del sitio público (Figma: "Frame 9").
 *
 *   [Logo] [🇪🇸 ES]      Sobre nosotros · Casos de éxito · …      [👤] [☰]
 *
 * - El ítem de la página actual se resalta en celeste (--text-link-active).
 * - En pantallas medianas/pequeñas el menú central se oculta y se accede a
 *   todas las páginas desde el botón ☰ (menú lateral).
 * - 👤 abre el modal de inicio de sesión (id "auth-modal"); con sesión
 *   iniciada lleva al portal (src/scripts/session-ui.ts y auth-flow.ts).
 * - 🇪🇸 ES abre el selector de idioma (id "language-modal").
 */
import { Image } from 'astro:assets';

import Logo from '@components/brand/Logo.astro';
import Icon from '@components/ui/Icon.astro';
import { mainNav, isActiveLink, routes } from '@data/navigation';
import flagEs from '@assets/images/flags/es.png';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="site-header__inner">
		<!-- Izquierda: logo + idioma -->
		<div class="site-header__brand">
			<a href={routes.home} class="site-header__logo" aria-label="Peruana en Rusia — Inicio">
				<Logo variant="vertical" color="mono" width={50} />
			</a>

			<button
				type="button"
				class="language-pill"
				data-dialog-open="language-modal"
				aria-label="Cambiar idioma (actual: Español)"
			>
				<Image src={flagEs} alt="" width={24} height={24} class="language-pill__flag" />
				<span>ES</span>
				<Icon name="chevron-down" size={12} class="language-pill__chevron" />
			</button>
		</div>

		<!-- Centro: navegación principal (solo desktop) -->
		<nav class="site-header__nav" aria-label="Navegación principal">
			<ul role="list">
				{mainNav.map((link) => {
					const active = isActiveLink(link, currentPath);
					return (
						<li>
							<a
								href={link.href}
								class:list={['site-header__link', { 'is-active': active }]}
								aria-current={active ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>

		<!-- Derecha: cuenta + menú -->
		<div class="site-header__actions">
			<button
				type="button"
				class="site-header__icon-button"
				data-dialog-open="auth-modal"
				aria-label="Iniciar sesión"
				title="Iniciar sesión"
				data-session-label="Ir a mi proceso"
			>
				<Icon name="account" size={28} />
			</button>

			<button
				type="button"
				class="site-header__icon-button"
				data-dialog-open="side-menu"
				aria-haspopup="dialog"
				aria-controls="side-menu"
			>
				<Icon name="menu" size={36} title="Abrir menú" />
			</button>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		background-color: var(--surface-dark);
		color: var(--text-on-dark);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		min-height: var(--header-height);
		padding: var(--space-2) var(--gutter);
	}

	/* ----- Logo + selector de idioma ----- */
	.site-header__brand {
		display: flex;
		align-items: center;
		gap: var(--space-7);
	}

	.site-header__logo {
		display: block;
		color: var(--color-white);
	}

	/* Píldora translúcida: se ve bien sobre el header oscuro y sobre el hero azul */
	.language-pill {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		height: 2.25rem; /* 36px */
		padding: 0 var(--space-3) 0 0.3125rem;
		border: 1px solid rgb(255 255 255 / 0.24);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.1);
		backdrop-filter: blur(8px);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.04em;
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out);
	}

	.language-pill:hover {
		border-color: rgb(255 255 255 / 0.45);
		background-color: rgb(255 255 255 / 0.18);
	}

	.language-pill:focus-visible {
		outline: 2px solid var(--color-skyblue);
		outline-offset: 2px;
	}

	.language-pill__flag {
		width: 22px;
		height: 22px;
		border-radius: var(--radius-pill);
		box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.5);
	}

	.language-pill__chevron {
		opacity: 0.8;
		transition: translate var(--duration-base) var(--ease-out);
	}

	.language-pill:hover .language-pill__chevron {
		translate: 0 1px;
	}

	/* ----- Navegación principal ----- */
	.site-header__nav ul {
		display: flex;
		align-items: center;
	}

	.site-header__link {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 6.25rem; /* 100px */
		padding: var(--space-3) var(--space-4);
		font-size: var(--font-size-nav);
		font-weight: var(--font-weight-medium);
		line-height: 1.75rem;
		white-space: nowrap;
		transition: color var(--duration-base) var(--ease-out);
	}

	.site-header__link:hover,
	.site-header__link.is-active {
		color: var(--text-link-active);
	}

	/* ----- Botones de cuenta y menú ----- */
	.site-header__actions {
		display: flex;
		align-items: center;
		gap: var(--space-7);
	}

	.site-header__icon-button {
		display: grid;
		place-items: center;
		color: var(--color-white);
		transition: color var(--duration-base) var(--ease-out);
	}

	.site-header__icon-button:hover {
		color: var(--text-link-active);
	}

	/* ----- Responsive ----- */
	@media (max-width: 1100px) {
		.site-header__nav {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.site-header__brand,
		.site-header__actions {
			gap: var(--space-4);
		}

		.site-header__logo :global(.logo) {
			width: 40px;
			height: auto;
		}

		.site-header__icon-button :global(svg) {
			width: 28px;
			height: 28px;
		}
	}
</style>
