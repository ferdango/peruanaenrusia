---
/**
 * /portal/pago/enviado/ — solicitud de pago enviada
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "MacBook Pro 14' - 9" (2045:358).
 * Se llega aquí después de "Ya transferí" en /portal/pago/.
 */
import PortalLayout from '@layouts/PortalLayout.astro';
import PaymentStatusCard from '@components/portal/PaymentStatusCard.astro';
import { formatDateTime, paymentRequest } from '@data/portal';

// Página bajo demanda: el middleware verifica la sesión antes de mostrarla
export const prerender = false;

const content = {
	heading: 'Estado de tu pago',
	lead: 'Recibimos tu solicitud. Estamos validando que el pago haya ingresado a nuestra cuenta.',
	title: 'Solicitud de pago enviada',
	action: 'Descargar mi constancia',
};
---

<PortalLayout
	title={content.title}
	description="Recibimos tu solicitud de pago y estamos validando los fondos."
	heading={content.heading}
	lead={content.lead}
	currentStep="payment"
>
	<PaymentStatusCard
		variant="sent"
		title={content.title}
		status={paymentRequest.status}
		detail={formatDateTime(paymentRequest.submittedAt)}
		action={{ label: content.action, href: paymentRequest.receiptHref, download: true }}
	/>
</PortalLayout>
