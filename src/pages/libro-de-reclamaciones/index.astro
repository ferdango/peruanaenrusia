---
/**
 * Libro de reclamaciones ( /libro-de-reclamaciones/ )
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Libro de reclamaciones" (1001:818). El archivo de
 * Figma no tiene versión móvil: en móvil todo va en una columna.
 *
 * Con el lenguaje del Home y del Blog: el header es transparente sobre el
 * hero oscuro (body.hero-overlay, estilos en src/styles/motion.css).
 *
 * Libro de reclamaciones virtual exigido por el Código de Protección y
 * Defensa del Consumidor (Ley N° 29571). El hero, el formulario, su envío y
 * la constancia viven en src/components/sections/complaints/ComplaintsForm.astro.
 */
import '@styles/motion.css';

import SiteLayout from '@layouts/SiteLayout.astro';

import ComplaintsForm from '@components/sections/complaints/ComplaintsForm.astro';
import { routes } from '@data/navigation';
import { site } from '@data/site';
import { breadcrumbSchema } from '@lib/seo/schema';

const meta = {
	title: 'Libro de reclamaciones',
	description: `Libro de reclamaciones virtual de ${site.legal.companyName} (RUC ${site.legal.ruc}). Registra tu reclamo o queja y recibe una constancia con tu código de seguimiento.`,
};
---

<SiteLayout
	title={meta.title}
	description={meta.description}
	bodyClass="complaints-page hero-overlay"
	jsonLd={[
		breadcrumbSchema(
			[
				{ name: 'Inicio', path: routes.home },
				{ name: meta.title, path: routes.complaintsBook },
			],
			Astro.site,
		),
	]}
>
	<ComplaintsForm />
</SiteLayout>

<style>
	/* Fondo celeste de la página (Figma: #DAEEF5) */
	:global(body.complaints-page) {
		background-color: #daeef5;
	}
</style>
