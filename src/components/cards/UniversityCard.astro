---
/**
 * UniversityCard
 * --------------------------------------------------------------------------
 * Tarjeta de universidad con el mismo diseño de "Universidades destacadas"
 * del Home (src/components/sections/home/HomeUniversities.astro): foto a
 * sangre, degradé con el color de la marca de la tarjeta, la ciudad y el
 * número arriba, y abajo el nombre, el resumen y la píldora "Conocer más".
 * Toda la tarjeta es clicable; al pasar el cursor la foto se acerca y la
 * flecha gira.
 *
 * Se usa en el listado /universidades/ y en "Otras universidades" de cada
 * ficha. El ancho lo da la celda que la contiene (proporción 4:5).
 *
 * Uso:
 *   <UniversityCard university={university} accent="yellow" index={0} />
 */
import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import { detailRoutes } from '@data/navigation';
import type { University, UniversityAccent } from '@data/universities';

interface Props {
	university: University;
	accent?: UniversityAccent;
	/** Posición en la lista (se muestra como "01", "02"…); si no se pasa, no hay número */
	index?: number;
	/** Texto del enlace */
	linkLabel?: string;
	/** Nivel del título según la jerarquía de la página */
	headingLevel?: 'h2' | 'h3';
	class?: string;
}

const {
	university,
	accent = 'skyblue',
	index,
	linkLabel = 'Conocer más',
	headingLevel: Heading = 'h3',
	class: className,
} = Astro.props;

const href = detailRoutes.university(university.slug);

// ----- Textos -----
const content = {
	/** Si la universidad no tiene resumen */
	summaryFallback: 'Carreras, requisitos, vida estudiantil y cómo postular con beca.',
	founded: 'Desde',
};
---

<article class:list={['university-card', `university-card--${accent}`, className]}>
	<MediaImage
		image={university.image}
		alt=""
		widths={[420, 840]}
		sizes="(max-width: 640px) 88vw, (max-width: 1100px) 46vw, 420px"
		class="university-card__photo"
	/>
	<span class="university-card__shade" aria-hidden="true"></span>

	<div class="university-card__top">
		<span class="university-card__city">{university.city}</span>
		{index !== undefined && (
			<span class="university-card__index" aria-hidden="true">
				{String(index + 1).padStart(2, '0')}
			</span>
		)}
	</div>

	<div class="university-card__body">
		{university.founded && (
			<p class="university-card__founded">
				{content.founded} {university.founded}
			</p>
		)}
		<Heading class="university-card__name">{university.name}</Heading>
		<p class="university-card__summary">{university.summary ?? content.summaryFallback}</p>
		<a href={href} class="university-card__link">
			<span>{linkLabel}</span>
			<span class="visually-hidden"> sobre {university.name}</span>
			<span class="university-card__arrow" aria-hidden="true">
				<Icon name="arrow-right" size={18} />
			</span>
		</a>
	</div>
</article>

<style>
	.university-card {
		/* Color de marca de la tarjeta */
		--accent: var(--color-skyblue);

		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		aspect-ratio: 4 / 5;
		padding: var(--space-5);
		overflow: clip;
		border-radius: var(--radius-xl);
		background-color: var(--surface-dark-raised);
		color: var(--color-pure-white);
	}

	.university-card--green {
		--accent: var(--color-green);
	}

	.university-card--yellow {
		--accent: var(--color-yellow);
	}

	.university-card--blue {
		--accent: var(--color-blue);
	}

	.university-card__photo {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 1.2s var(--ease-out);
	}

	/* Degradé con el color de la marca: el texto se lee sobre cualquier foto */
	.university-card__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(
				to top,
				color-mix(in srgb, var(--accent) 55%, rgb(8 12 20)) 0%,
				color-mix(in srgb, var(--accent) 22%, rgb(8 12 20 / 0.55)) 42%,
				rgb(8 12 20 / 0.08) 72%
			),
			linear-gradient(to bottom, rgb(8 12 20 / 0.45), transparent 26%);
	}

	/* ----- Arriba: ciudad + número ----- */
	.university-card__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.university-card__city {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-width: 0;
		padding: 0.3125rem 0.75rem;
		overflow: hidden;
		border-radius: var(--radius-pill);
		background-color: rgb(0 0 0 / 0.38);
		backdrop-filter: blur(8px);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.university-card__city::before {
		content: '';
		flex-shrink: 0;
		width: 0.4375rem;
		height: 0.4375rem;
		border-radius: var(--radius-pill);
		background-color: var(--accent);
	}

	.university-card__index {
		flex-shrink: 0;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		font-variant-numeric: tabular-nums;
		color: rgb(255 255 255 / 0.75);
	}

	/* ----- Abajo: año, nombre, resumen y enlace ----- */
	.university-card__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.university-card__founded {
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.8);
	}

	.university-card__name {
		font-size: clamp(1.25rem, 1rem + 0.6vw, 1.625rem);
		font-weight: var(--font-weight-bold);
		line-height: 1.2;
		text-wrap: balance;
	}

	.university-card__summary {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		font-size: var(--font-size-sm);
		line-height: 1.375rem;
		color: rgb(255 255 255 / 0.86);
	}

	/* "Conocer más": píldora blanca con flecha (toda la tarjeta es clicable) */
	.university-card__link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-2);
		padding: 0.3125rem 0.3125rem 0.3125rem 1rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		color: #0b1f3a;
		transition: gap var(--duration-slow) var(--ease-out);
	}

	.university-card__arrow {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius-pill);
		background-color: var(--accent);
		color: var(--color-pure-white);
		transition: rotate var(--duration-slow) var(--ease-out);
	}

	.university-card--yellow .university-card__arrow {
		color: #111;
	}

	.university-card__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: var(--radius-xl);
	}

	.university-card:hover .university-card__photo {
		scale: 1.06;
	}

	.university-card:hover .university-card__link {
		gap: var(--space-4);
	}

	.university-card:hover .university-card__arrow {
		rotate: -45deg;
	}

	.university-card__link:focus-visible {
		outline: none;
	}

	.university-card:has(.university-card__link:focus-visible) {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.university-card {
			padding: var(--space-4);
			border-radius: var(--radius-lg);
		}

		.university-card__link::after {
			border-radius: var(--radius-lg);
		}
	}
</style>
