---
/**
 * PortalTour — menú "Pantallas del portal" (solo en la versión estática)
 * --------------------------------------------------------------------------
 * Botón flotante abajo a la derecha que abre la lista de todas las pantallas
 * del portal, en el orden del flujo (inicio de sesión → pago → mi proceso),
 * para revisarlas sin completar cada paso. La pantalla actual queda marcada.
 *
 * Es un <details>: funciona sin JavaScript; el script solo lo cierra al
 * hacer clic fuera o con Escape.
 *
 * PortalLayout lo agrega cuando DEPLOY_TARGET=static (GitHub Pages). En el
 * servidor real no se muestra: cada estudiante ve solo su paso actual.
 *
 * Uso (ya lo incluye PortalLayout):
 *   <PortalTour />
 */
import Icon from '@components/ui/Icon.astro';
import { routes } from '@data/navigation';
import { portalRoutes } from '@data/portal';

const currentPath = Astro.url.pathname;

// ----- Textos -----
const content = {
	toggle: 'Pantallas del portal',
	title: 'Pantallas del portal',
	text: 'Recorre cada pantalla del flujo del estudiante.',
};

const groups = [
	{
		label: 'Acceso',
		screens: [{ label: 'Inicio de sesión', hint: 'Modal del sitio', href: `${routes.home}?login=1` }],
	},
	{
		label: 'Pago',
		screens: [
			{
				label: 'Pago de la inscripción',
				hint: 'Transferencia y constancia',
				href: portalRoutes.payment,
			},
			{ label: 'Pago enviado', hint: 'En validación de fondos', href: portalRoutes.paymentSent },
			{ label: 'Pago rechazado', hint: 'Volver a intentar', href: portalRoutes.paymentRejected },
		],
	},
	{
		label: 'Mi proceso',
		screens: [
			{ label: 'Mi proceso', hint: 'Resumen de los 5 pasos', href: portalRoutes.process },
			{
				label: 'Detalle de cada paso',
				hint: 'Formularios y estados',
				href: portalRoutes.processDetail,
			},
		],
	},
];
---

<details class="portal-tour" data-portal-tour>
	<summary class="portal-tour__toggle">
		<Icon name="menu" size={20} />
		<span class="portal-tour__toggle-text">{content.toggle}</span>
	</summary>

	<nav class="portal-tour__panel" aria-labelledby="portal-tour-title">
		<p id="portal-tour-title" class="portal-tour__title">
			{content.title}
		</p>
		<p class="portal-tour__text">{content.text}</p>

		{groups.map((group) => (
			<div class="portal-tour__group">
				<p class="portal-tour__group-label">{group.label}</p>
				<ul class="portal-tour__list" role="list">
					{group.screens.map((screen) => {
						const current = screen.href === currentPath;
						return (
							<li>
								<a
									class="portal-tour__link"
									href={screen.href}
									aria-current={current ? 'page' : undefined}
								>
									<span class="portal-tour__label">{screen.label}</span>
									<span class="portal-tour__hint">{screen.hint}</span>
									<Icon
										name={current ? 'check' : 'chevron-right'}
										size={16}
										class="portal-tour__icon"
									/>
								</a>
							</li>
						);
					})}
				</ul>
			</div>
		))}
	</nav>
</details>

<script>
	/** Cierra el menú al hacer clic fuera o con Escape */
	function initPortalTour() {
		const tour = document.querySelector<HTMLDetailsElement>('[data-portal-tour]');
		if (!tour) return;

		document.addEventListener('click', (event) => {
			if (tour.open && !tour.contains(event.target as Node)) tour.open = false;
		});

		tour.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !tour.open) return;
			tour.open = false;
			tour.querySelector('summary')?.focus();
		});
	}

	initPortalTour();
</script>

<style>
	.portal-tour {
		position: fixed;
		right: max(var(--space-4), env(safe-area-inset-right));
		bottom: max(var(--space-4), env(safe-area-inset-bottom));
		z-index: 40;
		color: var(--text-on-light);
	}

	/* ----- Botón ----- */
	.portal-tour__toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 3rem;
		padding: 0 1.125rem 0 1rem;
		border-radius: var(--radius-pill);
		background-color: #002546;
		box-shadow: 0 1rem 2rem -1rem rgb(0 37 70 / 0.8);
		color: var(--color-pure-white);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		list-style: none;
		cursor: pointer;
		user-select: none;
		transition:
			background-color var(--duration-base) var(--ease-out),
			translate var(--duration-base) var(--ease-out);
	}

	.portal-tour__toggle::-webkit-details-marker {
		display: none;
	}

	.portal-tour__toggle :global(svg) {
		color: var(--color-yellow);
	}

	.portal-tour__toggle:hover {
		background-color: var(--color-blue-title);
		translate: 0 -1px;
	}

	.portal-tour__toggle:focus-visible {
		outline: 3px solid var(--color-yellow);
		outline-offset: 3px;
	}

	.portal-tour[open] .portal-tour__toggle {
		background-color: var(--color-blue-title);
	}

	/* ----- Panel ----- */
	.portal-tour__panel {
		position: absolute;
		right: 0;
		bottom: calc(100% + var(--space-3));
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: min(21rem, calc(100vw - 2 * var(--space-4)));
		max-height: calc(100svh - 6rem);
		padding: var(--space-5);
		overflow-y: auto;
		border: 1px solid rgb(18 91 168 / 0.1);
		border-radius: 1.5rem;
		background-color: var(--surface-white);
		box-shadow: 0 2rem 4rem -1.5rem rgb(0 37 70 / 0.45);
	}

	@media (prefers-reduced-motion: no-preference) {
		.portal-tour[open] .portal-tour__panel {
			animation: portal-tour-in 0.28s var(--ease-out) both;
		}
	}

	@keyframes portal-tour-in {
		from {
			opacity: 0;
			translate: 0 0.5rem;
		}
	}

	.portal-tour__title {
		color: var(--color-blue-title);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
		line-height: 1.5rem;
	}

	.portal-tour__text {
		margin-top: calc(-1 * var(--space-2));
		color: var(--portal-text-soft);
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
	}

	.portal-tour__group {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.portal-tour__group-label {
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--portal-text-help);
	}

	.portal-tour__list {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.portal-tour__link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		column-gap: var(--space-3);
		padding: 0.625rem var(--space-3);
		border-radius: var(--radius-md);
		background-color: var(--portal-row);
		transition: background-color var(--duration-base) var(--ease-out);
	}

	.portal-tour__link:hover {
		background-color: var(--portal-tint);
	}

	.portal-tour__link:focus-visible {
		outline: 2px solid var(--color-blue);
		outline-offset: 2px;
	}

	.portal-tour__link[aria-current='page'] {
		background-color: var(--color-blue-title);
		color: var(--color-pure-white);
	}

	.portal-tour__label {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		line-height: 1.25rem;
	}

	.portal-tour__hint {
		grid-row: 2;
		font-size: var(--font-size-xs);
		line-height: 1rem;
		color: var(--portal-text-soft);
	}

	.portal-tour__link[aria-current='page'] .portal-tour__hint {
		color: rgb(255 255 255 / 0.75);
	}

	.portal-tour__link :global(.portal-tour__icon) {
		grid-row: 1 / 3;
		grid-column: 2;
		color: var(--color-blue-title);
	}

	.portal-tour__link[aria-current='page'] :global(.portal-tour__icon) {
		color: var(--color-yellow);
	}

	@media (max-width: 640px) {
		.portal-tour {
			right: var(--space-3);
			bottom: var(--space-3);
		}

		.portal-tour__toggle {
			min-height: 2.75rem;
			padding-inline: 0.875rem 1rem;
		}

		.portal-tour__panel {
			width: calc(100vw - 2 * var(--space-3));
		}
	}

	@media print {
		.portal-tour {
			display: none;
		}
	}
</style>
