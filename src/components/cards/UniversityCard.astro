---
/**
 * UniversityCard
 * --------------------------------------------------------------------------
 * Tarjeta de universidad: foto de fondo, forma de color de la marca, logo,
 * nombre y enlace "Conocer más" (Figma: "Universidades destacadas" y
 * "Casas de estudio"). Toda la tarjeta es clicable.
 *
 * El color de la forma (accent) se elige por tarjeta para alternar colores
 * de la marca. El acento "green" usa la forma diagonal; el resto, la curva.
 *
 * Uso:
 *   <UniversityCard university={university} accent="yellow" />
 */
import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import CardBlob from '@assets/graphics/shapes/card-blob.svg';
import CardSlope from '@assets/graphics/shapes/card-slope.svg';
import { detailRoutes } from '@data/navigation';
import type { University, UniversityAccent } from '@data/universities';

interface Props {
	university: University;
	accent?: UniversityAccent;
	/** Texto del enlace (en móvil el diseño usa "Más información") */
	linkLabel?: string;
	/** Nivel del título según la jerarquía de la página */
	headingLevel?: 'h2' | 'h3';
	class?: string;
}

const {
	university,
	accent = 'skyblue',
	linkLabel = 'Conocer más',
	headingLevel: Heading = 'h3',
	class: className,
} = Astro.props;

const Shape = accent === 'green' ? CardSlope : CardBlob;
const href = detailRoutes.university(university.slug);
---

<article class:list={['university-card', `university-card--${accent}`, className]}>
	<!-- Fondo: foto + forma de color -->
	<MediaImage
		image={university.image}
		alt=""
		class="university-card__photo"
		widths={[420, 840]}
		sizes="(max-width: 640px) 80vw, 420px"
	/>
	<Shape
		class:list={['university-card__shape', accent === 'green' ? 'is-slope' : 'is-blob']}
		aria-hidden="true"
	/>

	<!-- Contenido -->
	<div class="university-card__content">
		<div class="university-card__logo">
			<MediaImage image={university.logo} alt={`Logo de ${university.name}`} width={344} />
		</div>

		<div class="university-card__info">
			<Heading class="university-card__name">{university.name}</Heading>
			<a href={href} class="university-card__link">
				{linkLabel}
				<Icon name="arrow-right" size={20} />
			</a>
		</div>
	</div>
</article>

<style>
	.university-card {
		--accent: var(--color-skyblue);

		position: relative;
		isolation: isolate;
		display: flex;
		width: var(--university-card-width, 26.25rem); /* 420px */
		aspect-ratio: 420 / 381;
		padding: var(--space-4) var(--space-5);
		border-radius: var(--radius-2xl);
		overflow: clip;
		color: var(--color-white);
	}

	/* Colores de acento disponibles */
	.university-card--green {
		--accent: var(--color-green);
	}

	.university-card--yellow {
		--accent: var(--color-yellow);
	}

	.university-card--blue {
		--accent: var(--color-blue-title);
	}

	/* ----- Fondo ----- */
	.university-card__photo {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--duration-slow) var(--ease-out);
	}

	.university-card:hover .university-card__photo {
		transform: scale(1.04);
	}

	/* La forma se posiciona en % para escalar junto con la tarjeta */
	.university-card__shape {
		position: absolute;
		z-index: -1;
		max-width: none;
		color: var(--accent);
	}

	.university-card__shape.is-blob {
		left: -30.5%;
		top: 73.5%;
		width: 90.75%;
		height: auto;
	}

	.university-card__shape.is-slope {
		left: -27%;
		top: 41%;
		width: 158.25%;
		height: auto;
	}

	/* ----- Contenido ----- */
	.university-card__content {
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
	}

	/* El logo del diseño se muestra recortado en una caja de 126 × 61 px */
	.university-card__logo {
		width: 7.875rem; /* 126px */
		height: 3.8125rem; /* 61px */
		overflow: clip;
	}

	.university-card__logo img {
		position: relative;
		top: -7.05%;
		width: 136.5%;
		max-width: none;
		height: auto;
	}

	.university-card__info {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-block: var(--space-2);
	}

	.university-card__name {
		font-size: var(--font-size-h3);
		font-weight: var(--font-weight-bold);
		line-height: 1.15;
	}

	.university-card__link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-size: var(--font-size-md);
		line-height: 1.5rem;
	}

	/* Toda la tarjeta es clicable (el enlace se "estira" sobre ella) */
	.university-card__link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.university-card__link:focus-visible {
		box-shadow: none;
	}

	.university-card__link:focus-visible::after {
		box-shadow: inset 0 0 0 3px var(--color-skyblue);
	}

	@media (max-width: 640px) {
		.university-card {
			--university-card-width: min(80vw, 18rem);
		}

		.university-card__name {
			font-size: var(--font-size-card-title-mobile);
		}
	}
</style>
