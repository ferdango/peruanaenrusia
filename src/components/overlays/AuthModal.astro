---
/**
 * AuthModal — inicio de sesión / registro (modal de varios pasos)
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Modal Login" y "Modal Registrate" (867 × 680):
 *   Login 1    → 1797:4340  "Inicia sesión o regístrate en segundos"
 *   Login 2    → 1807:4433  "Usar mi correo personal"
 *   Login 3    → 1809:4532  "Termina de iniciar sesión" (código)
 *   Registro 1 → 1809:4573  "Crear mi cuenta" (correo)
 *   Registro 2 → 1809:4622  "Crear mi cuenta" (nombre)
 *   Registro 3 → 1809:4671  "Solo un paso más" (código)
 *   Botón cerrar → 1803:4396 (fuera del panel, arriba a la derecha)
 *
 * Estructura: imagen lateral (AuthArt, igual en todos los pasos) + panel con
 * el logo, los 6 pasos (solo uno visible a la vez) y una nota al pie. Sobre
 * el diseño de Figma se agregó:
 *   - Arriba de cada paso del flujo: "‹ Volver" y el avance ("Paso 1 de 3").
 *   - Campos con ícono y el código de 6 números grande y separado (AuthField).
 *   - Opciones con el mismo estilo: Google y "Continuar con mi correo".
 *   - Al abrir, la foto se acerca y las ondas de la marca se dibujan (AuthArt).
 *
 * El comportamiento (navegación entre pasos, validación, foco, reenvío del
 * código…) vive en src/scripts/auth-flow.ts y depende de los atributos
 * data-auth-* de este marcado: si cambias la estructura, consérvalos.
 *
 * Cómo se abre:
 *   <button data-dialog-open="auth-modal">Inicia sesión</button>
 *   <button data-dialog-open="auth-modal" data-auth-view="register">Regístrate</button>
 *   <a href="#" data-auth-view="register">Crear cuenta</a>   ← también funciona sin data-dialog-open
 *
 * Responsive: en tablet la imagen se angosta y la X pasa dentro del panel;
 * en móvil (sin diseño en Figma) es una hoja a pantalla completa sin imagen.
 *
 * Los textos de cada paso están en `steps` y `fields` (abajo).
 *
 * Backend: el botón de Google lleva a /api/auth/google/ y los formularios
 * llaman a /api/auth/email/* (ver src/scripts/auth-flow.ts y src/pages/api/auth/).
 * En la versión estática (GitHub Pages) el acceso es una demostración: no se
 * envía ningún dato (ver src/scripts/auth-api.ts).
 * Para abrir el modal desde cualquier página con un aviso: /?login=1
 * (opcional: &auth_error=… y &next=/ruta/ a la que volver).
 */
import Logo from '@components/brand/Logo.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import AuthArt from './AuthArt.astro';
import AuthField from './AuthField.astro';
import AuthGoogleButton from './AuthGoogleButton.astro';
import { routes } from '@data/navigation';
import type { AuthStep } from '@scripts/auth-api';

// ----- Textos comunes -----
const content = {
	close: 'Cerrar',
	back: 'Volver al paso anterior',
	backLabel: 'Volver',
	/** {current} y {total} se reemplazan por el número del paso */
	progress: 'Paso {current} de {total}',
	continue: 'Continuar',
	manual: 'Continuar con mi correo',
	or: 'o',
	noAccount: '¿No tienes una cuenta?',
	register: 'Regístrate aquí',
	hasAccount: '¿Ya tienes una cuenta?',
	login: 'Inicia sesión',
	noCode: '¿No recibiste el código?',
	resend: 'Volver a enviarlo',
	/** {email} se reemplaza por el correo ingresado */
	resent: 'Listo, te enviamos un nuevo código a {email}.',
	note: 'Sin contraseñas: entras con Google o con un código que te enviamos a tu correo.',
	legal: {
		before: 'He leído y acepto la ',
		link: 'Política de Privacidad',
		after: ' y protección de datos de Peruana en Rusia',
	},
};

// ----- Campos de formulario -----
const fields = {
	email: {
		label: 'Correo (personal o del trabajo)',
		name: 'email',
		type: 'email',
		icon: 'mail',
		inputmode: 'email',
		autocomplete: 'email',
		autocapitalize: 'off',
		spellcheck: false,
		placeholder: 'tucorreo@gmail.com',
		required: true,
		// Exige un dominio con punto (ej. gmail.com), además del formato nativo de email
		pattern: '[^@\\s]+@[^@\\s]+\\.[^@\\s]+',
		messages: {
			required: 'Ingresa tu correo.',
			invalid: 'Ingresa un correo válido, por ejemplo: tucorreo@gmail.com.',
		},
	},
	name: {
		label: 'Nombre',
		name: 'name',
		type: 'text',
		icon: 'user',
		autocomplete: 'given-name',
		placeholder: 'Tu nombre',
		required: true,
		maxlength: 60,
		messages: { required: 'Ingresa tu nombre.' },
	},
	code: {
		label: 'Código de 6 números',
		name: 'code',
		type: 'text',
		variant: 'code',
		inputmode: 'numeric',
		autocomplete: 'one-time-code',
		placeholder: 'Ingresa el código',
		required: true,
		pattern: '[0-9]{6}',
		messages: {
			required: 'Ingresa el código que te enviamos a tu correo.',
			invalid: 'El código tiene 6 números.',
		},
	},
} as const;

// ----- Pasos del flujo (el orden y los enlaces "‹" / Continuar) -----
interface StepConfig {
	id: AuthStep;
	/** intro = elegir método; email / name / code = formulario con ese campo */
	kind: 'intro' | 'email' | 'name' | 'code';
	title: string;
	text: string;
	/** Si existe, después de `text` se muestra el correo ingresado y luego este texto */
	textAfterEmail?: string;
	/** Paso al que lleva "‹ Volver" */
	back?: AuthStep;
	/** Paso siguiente al enviar el formulario (si no hay, se entra al portal) */
	next?: AuthStep;
	/** Avance dentro del flujo: [paso actual, total] */
	progress?: [number, number];
	/** Enlace al otro flujo debajo del formulario (ej. "¿Ya tienes una cuenta?") */
	switchTo?: { text: string; link: string; step: AuthStep };
}

const steps: StepConfig[] = [
	{
		id: 'login',
		kind: 'intro',
		title: 'Inicia sesión o regístrate en segundos',
		text: 'Para acceder al proceso, usa tu correo o tu cuenta de Google',
	},
	{
		id: 'login-email',
		kind: 'email',
		title: 'Usar mi correo personal',
		text: 'Verificaremos si tienes una cuenta. Si no tienes una, te ayudaremos a crearla.',
		back: 'login',
		next: 'login-code',
		progress: [1, 2],
	},
	{
		id: 'login-code',
		kind: 'code',
		title: 'Termina de iniciar sesión',
		text: 'Podrás iniciar sesión una vez que escribas el código que te enviamos a ',
		textAfterEmail: '.',
		back: 'login-email',
		progress: [2, 2],
	},
	{
		id: 'register-email',
		kind: 'email',
		title: 'Crear mi cuenta',
		text: 'Verificaremos si tienes una cuenta. Si no tienes una, te ayudaremos a crearla.',
		back: 'login',
		next: 'register-name',
		progress: [1, 3],
		switchTo: { text: content.hasAccount, link: content.login, step: 'login-email' },
	},
	{
		id: 'register-name',
		kind: 'name',
		title: 'Crear mi cuenta',
		text: 'Vas a crear una cuenta de Peruana en Rusia con ',
		textAfterEmail: '',
		back: 'register-email',
		next: 'register-code',
		progress: [2, 3],
	},
	{
		id: 'register-code',
		kind: 'code',
		title: 'Solo un paso más',
		text: 'Para terminar de registrarte, escribe el código que te enviamos a ',
		textAfterEmail: '.',
		back: 'register-name',
		progress: [3, 3],
	},
];

const titleId = (step: StepConfig) => `auth-${step.id}-title`;

const progressText = ([current, total]: [number, number]) =>
	content.progress.replace('{current}', String(current)).replace('{total}', String(total));
---

<dialog
	id="auth-modal"
	class="auth-modal"
	aria-labelledby={titleId(steps[0])}
	data-auth-redirect={routes.portal}
>
	<div class="auth-modal__card">
		<div class="auth-modal__media">
			<AuthArt />
		</div>

		<div class="auth-modal__panel" data-auth-panel>
			<!-- Anuncia el paso actual a lectores de pantalla -->
			<p class="visually-hidden" aria-live="polite" data-auth-announcer></p>

			<div class="auth-modal__brand">
				<Logo variant="horizontal" width={124} class="auth-modal__logo" />
			</div>

			<div class="auth-modal__steps">
				{steps.map((step, index) => (
					<div class="auth-step" data-auth-step={step.id} hidden={index > 0}>
						{(step.back || step.progress) && (
							<div class="auth-step__nav">
								{step.back && (
									<button
										type="button"
										class="auth-step__back"
										data-auth-goto={step.back}
										aria-label={content.back}
									>
										<Icon name="chevron-left" size={16} />
										{content.backLabel}
									</button>
								)}
								{step.progress && (
									<p class="auth-step__progress">
										<span>{progressText(step.progress)}</span>
										<span class="auth-step__progress-bars" aria-hidden="true">
											{Array.from({ length: step.progress[1] }, (_, bar) => (
												<span
													class:list={[
														'auth-step__progress-bar',
														{ 'is-done': bar < step.progress![0] },
													]}
												/>
											))}
										</span>
									</p>
								)}
							</div>
						)}

						<div class="auth-step__header">
							<h2 id={titleId(step)} class="auth-step__title" tabindex="-1" data-auth-title>
								{step.title}
							</h2>

							<p
								class:list={[
									'auth-step__text',
									{ 'auth-step__text--intro': step.kind === 'intro' },
								]}
							>
								{step.text}
								{step.textAfterEmail !== undefined && (
									<Fragment>
										<span class="auth-step__email" data-auth-email />
										{step.textAfterEmail}
									</Fragment>
								)}
							</p>
						</div>

						<!-- Avisos de error (Google cancelado, correo no disponible…) -->
						<p class="auth-step__alert" role="alert" data-auth-alert />

						{step.kind === 'intro' ? (
							<div class="auth-step__body">
								<div class="auth-step__group">
									<AuthGoogleButton />
									<p class="auth-step__divider">{content.or}</p>
									<button
										type="button"
										class="auth-step__option"
										data-auth-goto="login-email"
									>
										<span class="auth-step__option-icon" aria-hidden="true">
											<Icon name="mail" size={22} />
										</span>
										{content.manual}
									</button>
									<p class="auth-step__legal">
										{content.legal.before}
										<a href={routes.legal}>{content.legal.link}</a>
										{content.legal.after}
									</p>
								</div>

								<p class="auth-step__switch auth-step__switch--boxed">
									{content.noAccount}
									<button
										type="button"
										class="auth-step__link auth-step__link--strong"
										data-auth-goto="register-email"
									>
										{content.register}
									</button>
								</p>
							</div>
						) : (
							<form
								class="auth-step__form"
								data-auth-form={step.id}
								data-auth-next={step.next}
								data-auth-complete={step.next ? undefined : ''}
								novalidate
							>
								<div class="auth-step__group">
									<AuthField id={`auth-${step.id}-input`} {...fields[step.kind]} />
									<Button
										type="submit"
										variant="primary"
										size="sm"
										icon="arrow-right"
										block
									>
										{content.continue}
									</Button>
									{step.kind !== 'code' && (
										<p class="auth-step__legal">
											{content.legal.before}
											<a href={routes.legal}>{content.legal.link}</a>
											{content.legal.after}
										</p>
									)}
								</div>

								{step.switchTo && (
									<p class="auth-step__switch auth-step__switch--boxed">
										{step.switchTo.text}
										<button
											type="button"
											class="auth-step__link auth-step__link--strong"
											data-auth-goto={step.switchTo.step}
										>
											{step.switchTo.link}
										</button>
									</p>
								)}

								{step.kind === 'code' && (
									<Fragment>
										<p class="auth-step__divider">{content.or}</p>
										<AuthGoogleButton />
										<p class="auth-step__switch auth-step__switch--center">
											{content.noCode}
											<button type="button" class="auth-step__link" data-auth-resend>
												{content.resend}
											</button>
										</p>
										<p
											class="auth-step__status"
											role="status"
											data-auth-status
											data-message={content.resent}
										/>
									</Fragment>
								)}
							</form>
						)}
					</div>
				))}
			</div>

			<p class="auth-modal__note">
				<Icon name="shield-check" size={18} class="auth-modal__note-icon" />
				{content.note}
			</p>
		</div>
	</div>

	<button type="button" class="auth-modal__close" data-dialog-close>
		<Icon name="close" size={18} title={content.close} />
	</button>
</dialog>

<script>
	import { initAuthFlow } from '@scripts/auth-flow';
	initAuthFlow();
</script>

<style>
	/* ----- <dialog>: centrado, sin estilos del navegador ----- */
	.auth-modal {
		/* Colores de Figma sin token propio */
		--auth-button-text: #002546; /* Texto del botón amarillo "Continuar" */
		--auth-muted: color-mix(in srgb, var(--color-black) 62%, transparent);
		--auth-line: color-mix(in srgb, var(--color-black) 10%, transparent);

		position: fixed;
		inset: 0;
		width: fit-content;
		height: fit-content;
		max-width: none;
		max-height: none;
		margin: auto;
		padding: 0;
		border: 0;
		overflow: visible;
		background: transparent;
		color: var(--text-on-light);
	}

	.auth-modal::backdrop {
		background: rgb(6 12 24 / 0.6);
		backdrop-filter: blur(6px);
	}

	.auth-modal[open] .auth-modal__card,
	.auth-modal[open] .auth-modal__close {
		animation: auth-modal-in var(--duration-slow) var(--ease-out);
	}

	@keyframes auth-modal-in {
		from {
			opacity: 0;
			transform: translateY(1.25rem) scale(0.97);
		}
	}

	/* ----- Tarjeta: imagen (419px) + panel del formulario (400px) ----- */
	.auth-modal__card {
		display: flex;
		width: 51.1875rem; /* 819px */
		max-width: calc(100vw - 2 * var(--space-4));
		height: 42.5rem; /* 680px */
		max-height: calc(100dvh - 2 * var(--space-4));
		overflow: clip;
		border-radius: var(--radius-xl);
		background-color: var(--surface-light);
		box-shadow:
			0 2.5rem 6rem -2rem rgb(0 0 0 / 0.65),
			0 0 0 1px rgb(255 255 255 / 0.08);
	}

	.auth-modal__media {
		flex: 1 1 26.1875rem; /* 419px; en pantallas medianas se angosta */
		min-width: 0;
	}

	.auth-modal__panel {
		display: flex;
		flex: 0 0 25rem; /* 400px */
		flex-direction: column;
		gap: var(--space-5);
		padding: var(--space-6) var(--space-7) var(--space-5); /* 32px 40px 24px */
		overflow-y: auto;
		overscroll-behavior: contain;
		background-color: var(--surface-light);
	}

	.auth-modal__brand {
		display: flex;
		align-items: center;
		min-height: 2.25rem;
	}

	.auth-modal__brand :global(.auth-modal__logo) {
		display: block;
		height: auto;
	}

	.auth-modal__steps {
		flex: 1 0 auto;
	}

	/* Nota al pie: cómo se entra (sin contraseñas) */
	.auth-modal__note {
		display: flex;
		align-items: flex-start;
		gap: var(--space-2);
		padding-top: var(--space-4);
		border-top: 1px solid var(--auth-line);
		font-size: var(--font-size-xs);
		line-height: 1.125rem;
		color: var(--auth-muted);
	}

	.auth-modal__note-icon {
		flex-shrink: 0;
		color: var(--color-green);
	}

	/* ----- Botón cerrar: círculo de 40px fuera de la tarjeta, arriba a la derecha ----- */
	.auth-modal__close {
		position: absolute;
		top: 0;
		left: calc(100% + var(--space-3));
		display: grid;
		place-items: center;
		width: 2.5rem; /* 40px */
		height: 2.5rem;
		border: 1px solid rgb(255 255 255 / 0.24);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.14);
		backdrop-filter: blur(8px);
		color: var(--color-pure-white);
		transition:
			background-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out),
			rotate var(--duration-slow) var(--ease-out);
	}

	.auth-modal__close:hover {
		background-color: var(--color-pure-white);
		color: var(--color-black);
		rotate: 90deg;
	}

	.auth-modal__close:focus-visible {
		outline: 3px solid var(--color-skyblue);
		outline-offset: 2px;
	}

	/* ----- Paso ----- */
	.auth-step {
		display: flex;
		flex-direction: column;
		gap: var(--space-5); /* 24px */
		animation: auth-step-in var(--duration-slow) var(--ease-out);
	}

	.auth-step[hidden] {
		display: none;
	}

	@keyframes auth-step-in {
		from {
			opacity: 0;
			translate: 1rem 0;
		}
	}

	/* "‹ Volver" + "Paso 1 de 3" */
	.auth-step__nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: calc(-1 * var(--space-3));
	}

	.auth-step__back {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		min-height: 2rem;
		padding: 0 var(--space-3) 0 var(--space-2);
		border-radius: var(--radius-pill);
		background-color: color-mix(in srgb, var(--color-black) 6%, transparent);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		color: var(--text-on-light);
		transition:
			background-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out);
	}

	/* Área táctil de 44px sin cambiar el diseño */
	.auth-step__back::before {
		content: '';
		position: absolute;
		inset: -6px;
	}

	.auth-step__back :global(svg) {
		transition: translate var(--duration-base) var(--ease-out);
	}

	.auth-step__back:hover {
		background-color: rgb(0 122 252 / 0.12);
		color: var(--color-blue-title);
	}

	.auth-step__back:hover :global(svg) {
		translate: -2px 0;
	}

	.auth-step__back:focus-visible {
		outline: 3px solid var(--color-blue);
		outline-offset: 2px;
	}

	.auth-step__progress {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-left: auto;
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		color: var(--auth-muted);
	}

	.auth-step__progress-bars {
		display: flex;
		gap: 0.25rem;
	}

	.auth-step__progress-bar {
		width: 1.25rem;
		height: 0.25rem;
		border-radius: var(--radius-pill);
		background-color: color-mix(in srgb, var(--color-black) 14%, transparent);
	}

	.auth-step__progress-bar.is-done {
		background: linear-gradient(90deg, var(--color-blue), var(--color-skyblue));
	}

	.auth-step__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-3); /* 12px */
	}

	/* Figma: Poppins Bold 28/32 */
	.auth-step__title {
		font-size: var(--font-size-h3);
		font-weight: var(--font-weight-bold);
		line-height: 1.143;
		color: var(--text-on-light);
		/* Cortes de línea como en Figma (sin el "balance" global de los títulos) */
		text-wrap: wrap;
	}

	/* El título recibe el foco al cambiar de paso (solo para lectores de pantalla) */
	.auth-step__title:focus,
	.auth-step__title:focus-visible {
		outline: none;
		box-shadow: none;
	}

	/* Figma: Poppins Regular 15/20 (14/20 en el primer paso) */
	.auth-step__text {
		font-size: var(--font-size-nav);
		line-height: 1.375rem;
		color: color-mix(in srgb, var(--color-black) 78%, transparent);
	}

	.auth-step__text--intro {
		font-size: var(--font-size-sm);
	}

	.auth-step__email {
		font-weight: var(--font-weight-semibold);
		color: var(--text-on-light);
		overflow-wrap: anywhere;
	}

	/* ----- Cuerpo del paso ----- */
	.auth-step__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-6); /* 32px */
	}

	.auth-step__form {
		display: flex;
		flex-direction: column;
		gap: var(--space-4); /* 16px */
	}

	.auth-step__group {
		display: flex;
		flex-direction: column;
		gap: var(--space-3); /* 12px */
	}

	/* Botón amarillo "Continuar" (Button primary): alto 52px, radio 12px, texto 16px */
	.auth-step :global(.btn--primary) {
		min-height: 3.25rem;
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		box-shadow: 0 0.75rem 1.5rem -1rem rgb(251 189 29 / 0.9);
		font-size: var(--font-size-md);
		color: var(--auth-button-text);
		transition:
