---
/**
 * HomeFaq — "Preguntas frecuentes"
 * --------------------------------------------------------------------------
 * Figma: Home › "Frame 628331" (1820:185): título y video a la izquierda,
 * acordeón a la derecha y las ondas de la marca (roja arriba a la izquierda,
 * azul abajo a la derecha). Mejorado con el lenguaje del resto del Home:
 *
 *   - Encabezado con etiqueta, título y una línea de introducción.
 *   - Acordeón numerado (01, 02…): la pregunta abierta se resalta con el
 *     degradé de la marca y la respuesta se despliega con suavidad (en los
 *     navegadores que lo permiten; en los demás se abre al instante).
 *   - Video real del canal: "Becas rusas: la directora de la Casa Rusa nos
 *     explica todo" (src/data/videos.ts o WordPress). Se reproduce en el modal
 *     del sitio; sin JavaScript abre su página del blog.
 *   - Tarjeta "¿No encontraste tu respuesta?" con el botón a WhatsApp.
 *   - Las ondas se dibujan con el scroll (src/scripts/scroll-draw.ts) y se
 *     desplazan a distinta velocidad (src/scripts/motion.ts).
 *
 * Desktop: dos columnas. Tablet y móvil: una columna (encabezado, preguntas
 * y, al final, el video y la ayuda).
 *
 * El acordeón usa <details>/<summary> nativos (accesible y sin JavaScript);
 * con el atributo `name` solo una pregunta queda abierta a la vez.
 *
 * Las preguntas vienen del gestor de contenidos (WordPress) o, si no está
 * configurado, de src/data/faqs.ts (ver src/lib/content/).
 *
 * Uso: <HomeFaq /> (página de inicio, antes del footer).
 */
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import { getFaqs, getVideos } from '@lib/content';
import { detailRoutes } from '@data/navigation';
import type { Video } from '@data/videos';
import { whatsappUrl } from '@data/site';
import Star from '@assets/graphics/stars/star-4-point.svg';
import WaveRed from '@assets/graphics/waves/wave-red-faq.svg';
import WaveBlue from '@assets/graphics/waves/wave-blue-faq.svg';

const faqs = await getFaqs();

/** Video que acompaña las preguntas (si no está en la lista, el más reciente) */
const VIDEO_SLUG = 'becas-rusas-casa-rusa';
const videos = await getVideos();
const video = videos.find((item) => item.slug === VIDEO_SLUG) ?? videos[0];

// ----- Contenido de la sección -----
const content = {
	eyebrow: 'Resolvemos tus dudas',
	title: 'Preguntas frecuentes',
	text: 'Lo que más nos preguntan los estudiantes y sus familias antes de empezar. Si tu duda no está aquí, escríbenos.',
	video: {
		label: 'Mira el video',
		duration: 'Duración',
	},
	help: {
		title: '¿No encontraste tu respuesta?',
		text: 'Escríbenos por WhatsApp y te respondemos personalmente.',
		cta: 'Reserva llamada',
		ctaHint: ' por WhatsApp (se abre en una pestaña nueva)',
	},
};

/** 0 → "01" */
const itemNumber = (index: number) => String(index + 1).padStart(2, '0');

/** Enlace del video: abre el modal si tiene YouTube; si no, su página del blog */
const videoLink = (item: Video) => ({
	href: detailRoutes.blogPost(item.slug),
	...(item.youtubeId
		? {
				'data-video-open': '',
				'data-video-youtube': item.youtubeId,
				'data-video-title': item.title,
			}
		: {}),
});
---

<section
	class="home-faq section"
	id="preguntas-frecuentes"
	aria-labelledby="home-faq-title"
	data-scroll-draw="0.95 0.3"
>
	<!-- Ondas de la marca (decorativas), en un lienzo de 1512px centrado: se dibujan con el scroll -->
	<div class="home-faq__decor" aria-hidden="true">
		<div class="home-faq__wave home-faq__wave--red">
			<WaveRed />
		</div>
		<div class="home-faq__wave home-faq__wave--blue">
			<WaveBlue />
		</div>
	</div>

	<div class="home-faq__inner container">
		<header class="home-faq__intro">
			<p class="home-faq__eyebrow">
				<Star class="home-faq__eyebrow-star" aria-hidden="true" />
				{content.eyebrow}
			</p>
			<h2 id="home-faq-title" class="home-faq__title">
				{content.title}
			</h2>
			<p class="home-faq__text">{content.text}</p>
		</header>

		<div class="home-faq__list">
			{faqs.map((faq, index) => (
				<details class="faq-item" name="preguntas-frecuentes" open={index === 0}>
					<summary class="faq-item__summary">
						<span class="faq-item__number" aria-hidden="true">
							{itemNumber(index)}
						</span>
						<span class="faq-item__question">{faq.question}</span>
						<span class="faq-item__toggle" aria-hidden="true" />
					</summary>
					{faq.answerHtml ? (
						<div class="faq-item__answer" set:html={faq.answerHtml} />
					) : (
						<div class="faq-item__answer">
							<p>{faq.answer}</p>
						</div>
					)}
				</details>
			))}
		</div>

		<div class="home-faq__extras">
			{video && (
				<a class="faq-video" {...videoLink(video)}>
					<span class="faq-video__media">
						<MediaImage
							image={video.thumbnail}
							alt=""
							widths={[320, 640]}
							sizes="(max-width: 640px) 8rem, 10rem"
							class="faq-video__image"
						/>
						<span class="faq-video__play" aria-hidden="true">
							<Icon name="play" size={14} />
						</span>
						{video.duration && (
							<span class="faq-video__duration" aria-hidden="true">
								{video.duration}
							</span>
						)}
					</span>
					<span class="faq-video__text">
						<span class="faq-video__label">
							<Icon name="youtube-play" size={16} class="faq-video__label-icon" />
							{content.video.label}
						</span>
						<span class="faq-video__title">{video.title}</span>
						{video.duration && (
							<span class="visually-hidden">
								· {content.video.duration} {video.duration}
							</span>
						)}
					</span>
				</a>
			)}

			<div class="faq-help">
				<span class="faq-help__icon" aria-hidden="true">
					<Icon name="whatsapp" size={24} />
				</span>
				<div class="faq-help__body">
					<p class="faq-help__title">{content.help.title}</p>
					<p class="faq-help__text">{content.help.text}</p>
				</div>
				<Button
					href={whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
					size="sm"
					icon="whatsapp"
					class="home-faq__cta"
				>
					{content.help.cta}
					<span class="visually-hidden">{content.help.ctaHint}</span>
				</Button>
			</div>
		</div>
	</div>
</section>

<style>
	.home-faq {
		/* Colores propios de la sección */
		--faq-border: rgb(244 244 244 / 0.16);
		/* Fondos opacos: las ondas de la marca pasan por detrás de las tarjetas */
		--faq-surface: #1f2222;
		--faq-surface-hover: #252828;
		--faq-open-bg: #20262a; /* pregunta abierta (deja ver el borde degradé) */
		--faq-gradient: linear-gradient(
			120deg,
			var(--color-skyblue),
			var(--color-blue) 45%,
			var(--color-red)
		);

		/* Medidas del acordeón (la respuesta se alinea con la pregunta) */
		--faq-pad: var(--space-6);
		--faq-number: 2.25rem;
		--faq-gap: var(--space-4);
		--faq-toggle: 2.5rem;

		display: grid;
		align-content: center;
		/* Figma: 840px de alto con el contenido centrado (las ondas usan esa altura) */
		min-height: 52.5rem;
		isolation: isolate;
		overflow: clip;
		background:
			radial-gradient(48rem 30rem at 92% 108%, rgb(0 122 252 / 0.2), transparent 70%),
			radial-gradient(40rem 26rem at -6% -8%, rgb(255 26 48 / 0.14), transparent 70%),
			var(--surface-dark);
		color: var(--text-on-dark);
	}

	/* ----- Ondas: lienzo de 1512px centrado (ancho de Figma) ----- */
	.home-faq__decor {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: -1;
		width: 1512px;
		height: 100%;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.home-faq__wave {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.home-faq__wave :global(svg) {
		flex: none;
		width: 1064px;
		height: 256px;
		max-width: none;
	}

	/* Se dibujan una tras otra con el scroll (--draw); sin JavaScript, completas */
	.home-faq__wave :global(.brand-line) {
		stroke-dasharray: 100 100;
		stroke-dashoffset: calc(100 - 100 * clamp(0, (var(--draw, 1) - var(--line-delay, 0)) / 0.7, 1));
	}

	/* Figma 1820:202: girada -165° y reflejada (más arriba que en Figma: el
	   encabezado ahora tiene etiqueta y la onda pasa sobre él, no por el título) */
	.home-faq__wave--red {
		left: -448px;
		top: -298px;
		width: 1094px;
		height: 522.66px;
	}

	.home-faq__wave--red :global(svg) {
		transform: rotate(-165deg) scaleY(-1);
	}

	/* Figma 1820:194: reflejada y girada 26.49° */
	.home-faq__wave--blue {
		--line-delay: 0.2;

		left: 795px;
		top: 472px;
		width: 1066.49px;
		height: 703.69px;
	}

	.home-faq__wave--blue :global(svg) {
		transform: rotate(26.49deg) scaleY(-1);
	}

	/* ----- Dos columnas: encabezado + extras a la izquierda, preguntas a la derecha ----- */
	.home-faq__inner {
		display: grid;
		grid-template-columns: minmax(0, 25.25rem) minmax(0, 52rem);
		grid-template-rows: auto 1fr;
		grid-template-areas:
			'intro list'
			'extras list';
		justify-content: space-between;
		align-items: start;
		column-gap: var(--space-9); /* 64px */
		row-gap: var(--space-7); /* 40px */
	}

	/* ===== Encabezado ===== */
	.home-faq__intro {
		grid-area: intro;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.home-faq__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border: 1px solid rgb(244 244 244 / 0.16);
		border-radius: var(--radius-pill);
		background-color: #232626;
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
		color: var(--color-pure-white);
	}

	.home-faq__eyebrow-star {
		width: 1rem;
		height: 1rem;
		color: var(--color-yellow);
	}

	/* Figma: Poppins Bold 64/64 */
	.home-faq__title {
		max-width: 24.1875rem; /* 387px */
		font-size: clamp(2rem, 1rem + 3.4vw, 4rem);
		line-height: 1;
		text-wrap: balance;
	}

	.home-faq__text {
		max-width: 24rem;
		font-size: var(--font-size-lg);
		line-height: 1.75rem;
		color: var(--text-on-dark-soft);
	}

	/* ===== Acordeón ===== */
	.home-faq__list {
		grid-area: list;
		display: flex;
		flex-direction: column;
		gap: var(--space-3); /* 12px */
	}

	.faq-item {
		/* Despliegue suave de la respuesta (ver ::details-content más abajo) */
		interpolate-size: allow-keywords;

		border: 1px solid var(--faq-border);
		border-radius: 1.75rem;
		background-color: var(--faq-surface);
		transition:
			border-color var(--duration-base) var(--ease-out),
			background-color var(--duration-base) var(--ease-out),
			box-shadow var(--duration-slow) var(--ease-out);
	}

	.faq-item:hover {
		border-color: rgb(244 244 244 / 0.36);
		background-color: var(--faq-surface-hover);
	}

	/* Abierta: fondo elevado y borde con el degradé de la marca */
	.faq-item[open] {
		border-color: transparent;
		background:
			linear-gradient(var(--faq-open-bg), var(--faq-open-bg)) padding-box,
			var(--faq-gradient) border-box;
		box-shadow: 0 1.75rem 3rem -2rem rgb(0 0 0 / 0.9);
	}

	.faq-item__summary {
		display: grid;
		grid-template-columns: var(--faq-number) minmax(0, 1fr) var(--faq-toggle);
		align-items: center;
		gap: var(--faq-gap);
		min-height: 5rem; /* 80px */
		padding: var(--space-4) var(--space-5) var(--space-4) var(--faq-pad);
		border-radius: inherit;
		list-style: none;
		cursor: pointer;
	}

	.faq-item__summary::-webkit-details-marker {
		display: none;
	}

	.faq-item__summary:focus-visible {
		outline: 3px solid var(--color-skyblue);
		outline-offset: 3px;
	}

	.faq-item__number {
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-bold);
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.06em;
		color: rgb(244 244 244 / 0.45);
		transition: color var(--duration-base) var(--ease-out);
	}

	/* Figma: Avenir Heavy 18/32 → Poppins SemiBold 18/28; amarillo si está abierta */
	.faq-item__question {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-semibold);
		line-height: 1.75rem;
		color: var(--color-pure-white);
		transition: color var(--duration-base) var(--ease-out);
	}

	.faq-item[open] .faq-item__number,
	.faq-item[open] .faq-item__question {
		color: var(--color-yellow);
	}

	/* Botón +/−: dos barras; al abrir, la vertical se acuesta y el botón gira */
	.faq-item__toggle {
		display: grid;
		place-items: center;
		width: var(--faq-toggle);
		height: var(--faq-toggle);
		border: 1px solid rgb(244 244 244 / 0.5);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.04);
		color: var(--color-white);
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out),
			rotate var(--duration-slow) var(--ease-out),
			scale var(--duration-base) var(--ease-out);
	}

	.faq-item__toggle::before,
	.faq-item__toggle::after {
		content: '';
		grid-area: 1 / 1;
		width: 0.875rem;
		height: 2px;
		border-radius: 1px;
		background-color: currentColor;
		transition: rotate var(--duration-slow) var(--ease-out);
	}

	.faq-item__toggle::after {
		rotate: 90deg;
	}

	.faq-item:hover .faq-item__toggle {
		border-color: var(--color-white);
		scale: 1.06;
	}

	.faq-item[open] .faq-item__toggle {
		border-color: var(--color-yellow);
		background-color: var(--color-yellow);
		color: var(--surface-dark);
		rotate: 180deg;
	}

	.faq-item[open] .faq-item__toggle::after {
		rotate: 0deg;
	}

	/* Figma: Avenir Roman 16/24, 80 % — alineada con la pregunta */
	.faq-item__answer {
		max-width: 46rem;
		padding: 0 calc(var(--space-5) + var(--faq-toggle) + var(--faq-gap)) var(--space-6)
			calc(var(--faq-pad) + var(--faq-number) + var(--faq-gap));
		line-height: 1.625rem;
		color: var(--text-on-dark-soft);
	}

	.faq-item__answer :global(p + p),
	.faq-item__answer :global(ul),
	.faq-item__answer :global(ol) {
		margin-top: var(--space-3);
	}

	.faq-item__answer :global(a) {
		color: var(--color-skyblue);
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* La respuesta se despliega con suavidad (Chrome, Edge…; en los demás, al instante) */
		.faq-item::details-content {
			block-size: 0;
			overflow-y: clip;
			transition:
				block-size 0.45s var(--ease-out),
				content-visibility 0.45s allow-discrete;
		}

		.faq-item[open]::details-content {
			block-size: auto;
		}

		/* …y su texto entra deslizándose */
		.faq-item[open] .faq-item__answer {
			animation: faq-answer-in 0.5s var(--ease-out) both;
		}
	}

	@keyframes faq-answer-in {
		from {
			opacity: 0;
			translate: 0 -0.5rem;
		}
	}

	/* ===== Video y ayuda ===== */
	.home-faq__extras {
		grid-area: extras;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	/* Video: miniatura + texto, en una tarjeta de vidrio */
	.faq-video {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-3);
		border: 1px solid var(--faq-border);
		border-radius: var(--radius-xl);
		background-color: var(--faq-surface);
		transition:
			border-color var(--duration-base) var(--ease-out),
			background-color var(--duration-base) var(--ease-out);
	}

	.faq-video__media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: clip;
		border-radius: var(--radius-lg);
		background-color: #2a3036;
	}

	.faq-video__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.8s var(--ease-out);
	}

	/* Botón ▶: círculo blanco con anillo translúcido */
	.faq-video__play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin: auto;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		box-shadow: 0 0 0 8px rgb(244 244 244 / 0.3);
		color: var(--color-blue);
		transition: scale var(--duration-slow) var(--ease-out);
	}

	.faq-video__play :global(svg) {
		margin-left: 0.125rem;
	}

	.faq-video__duration {
		position: absolute;
		right: 0.375rem;
		bottom: 0.375rem;
		padding: 0.0625rem 0.375rem;
		border-radius: 0.375rem;
		background-color: rgb(0 0 0 / 0.72);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		line-height: 1.125rem;
		font-variant-numeric: tabular-nums;
	}

	.faq-video__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 0;
		padding-right: var(--space-2);
	}

	.faq-video__label {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-on-dark-muted);
	}

	.faq-video__label-icon {
		color: var(--color-red);
	}

	/* Figma: Poppins SemiBold 16/20 */
	.faq-video__title {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		font-weight: var(--font-weight-semibold);
		line-height: 1.375rem;
		color: var(--color-pure-white);
	}

	.faq-video:hover {
		border-color: rgb(244 244 244 / 0.36);
		background-color: var(--faq-surface-hover);
	}

	.faq-video:hover .faq-video__image {
		scale: 1.06;
	}

	.faq-video:hover .faq-video__play {
		scale: 1.1;
	}

	.faq-video:focus-visible {
		outline: 3px solid var(--color-skyblue);
		outline-offset: 3px;
	}

	/* "¿No encontraste tu respuesta?" */
	.faq-help {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-5);
		border: 1px solid var(--faq-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(135deg, rgb(0 122 252 / 0.28), rgb(0 122 252 / 0.04) 75%), var(--faq-surface);
	}

	.faq-help__icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-pill);
		background-color: #25d366; /* verde de WhatsApp */
		box-shadow: 0 0.75rem 1.5rem -0.75rem rgb(37 211 102 / 0.7);
		color: var(--color-pure-white);
	}

	.faq-help__body {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.faq-help__title {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
		line-height: 1.5rem;
		color: var(--color-pure-white);
	}

	.faq-help__text {
		font-size: var(--font-size-sm);
		line-height: 1.375rem;
		color: var(--text-on-dark-soft);
	}

	.home-faq :global(.home-faq__cta) {
