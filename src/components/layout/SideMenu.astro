---
/**
 * SideMenu
 * --------------------------------------------------------------------------
 * Menú lateral que se abre con el botón ☰ del header (Figma: "Menu").
 * Fondo degradado azul, enlaces, datos de contacto y botón de WhatsApp.
 *
 * Es un <dialog>: se abre con cualquier elemento que tenga
 * data-dialog-open="side-menu" (ver src/scripts/dialog.ts).
 */
import { Image } from 'astro:assets';

import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { sideNav, isActiveLink } from '@data/navigation';
import { site, whatsappUrl } from '@data/site';
import flagPe from '@assets/images/flags/pe.png';
import menuWaves from '@assets/images/menu/menu-waves.png';

const currentPath = Astro.url.pathname;
---

<dialog id="side-menu" class="side-menu" aria-label="Menú">
	<div class="side-menu__panel">
		<div class="side-menu__top">
			<button type="button" class="side-menu__close" data-dialog-close>
				<Icon name="close" size={18} title="Cerrar menú" />
			</button>
		</div>

		<div class="side-menu__body">
			<nav aria-label="Menú del sitio">
				<ul role="list" class="side-menu__list">
					{sideNav.map((link) => {
						const active = isActiveLink(link, currentPath);
						return (
							<li>
								<a
									href={link.href}
									class:list={['side-menu__link', { 'is-active': active }]}
									aria-current={active ? 'page' : undefined}
									data-dialog-close-on-nav
								>
									{link.label}
								</a>
							</li>
						);
					})}
					<li>
						<button type="button" class="side-menu__link" data-dialog-open="auth-modal">
							Inicia sesión
						</button>
					</li>
				</ul>
			</nav>

			<div class="side-menu__contact">
				<div>
					<a class="side-menu__phone" href={`tel:+${site.contact.phoneRaw}`}>
						<Image src={flagPe} alt="" width={24} height={24} class="side-menu__flag" />
						{site.contact.phone}
					</a>
					<a class="side-menu__email" href={`mailto:${site.contact.email}`}>
						{site.contact.email}
					</a>
				</div>

				<Button href={whatsappUrl} variant="light" size="md" block target="_blank" rel="noopener">
					Contáctate ahora
				</Button>
			</div>
		</div>

		<!-- Ondas de marca (decorativas) -->
		<Image src={menuWaves} alt="" width={729} class="side-menu__waves decoration" />
	</div>
</dialog>

<script>
	import { initDialogs } from '@scripts/dialog';
	initDialogs();

	// Al elegir un enlace que apunta a una sección de la misma página (#ancla),
	// cerramos el menú para que se vea el desplazamiento.
	document.querySelectorAll<HTMLAnchorElement>('[data-dialog-close-on-nav]').forEach((link) => {
		link.addEventListener('click', () => link.closest('dialog')?.close());
	});
</script>

<style>
	/* ----- Contenedor <dialog>: ocupa el alto de la pantalla, a la derecha ----- */
	.side-menu {
		position: fixed;
		inset: 0 0 0 auto;
		width: min(22.5rem, 100vw); /* 360px */
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--text-on-dark);
	}

	.side-menu::backdrop {
		background: rgb(0 0 0 / 0.55);
		backdrop-filter: blur(2px);
	}

	/* Animación de entrada desde la derecha */
	.side-menu[open] .side-menu__panel {
		animation: slide-in var(--duration-slow) var(--ease-out);
	}

	@keyframes slide-in {
		from {
			transform: translateX(100%);
		}
	}

	.side-menu__panel {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		height: 100%;
		padding-block: var(--space-4) var(--space-7);
		overflow: clip;
		background: linear-gradient(to bottom, var(--color-blue), #004996);
	}

	.side-menu__top {
		display: flex;
		justify-content: flex-end;
		padding: var(--space-3) var(--space-5);
	}

	.side-menu__close {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		margin: -11px; /* área táctil amplia sin mover el ícono */
		color: var(--color-white);
	}

	.side-menu__body {
		position: relative;
		z-index: 1;
		display: flex;
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-6);
		overflow-y: auto;
	}

	/* ----- Enlaces ----- */
	.side-menu__link {
		display: flex;
		align-items: center;
		width: 100%;
		padding: var(--space-4) var(--space-5);
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-medium);
		line-height: 1.75rem;
		text-align: left;
		transition: background-color var(--duration-base) var(--ease-out);
	}

	.side-menu__link:hover,
	.side-menu__link.is-active {
		background-color: rgb(255 255 255 / 0.14);
	}

	/* ----- Contacto ----- */
	.side-menu__contact {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-inline: var(--space-5);
	}

	.side-menu__phone {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--font-size-h3);
		font-weight: var(--font-weight-semibold);
		color: rgb(247 247 255 / 0.85);
		white-space: nowrap;
	}

	.side-menu__flag {
		width: 24px;
		height: 24px;
		border-radius: var(--radius-pill);
	}

	.side-menu__email {
		display: block;
		margin-top: var(--space-1);
		font-size: var(--font-size-lg);
		color: rgb(247 247 255 / 0.65);
	}

	/* ----- Ondas decorativas al pie del menú ----- */
	.side-menu__waves {
		left: -206px;
		bottom: -180px;
		width: 729px;
		max-width: none;
		height: auto;
	}
</style>
