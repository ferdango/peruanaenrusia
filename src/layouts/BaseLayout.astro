---
/**
 * BaseLayout
 * --------------------------------------------------------------------------
 * Estructura HTML mínima compartida por TODAS las páginas:
 * <head> (SEO, fuentes, favicon) + estilos globales.
 *
 * No incluye header ni footer: para el sitio público usa SiteLayout y para el
 * portal del estudiante usa PortalLayout (ambos envuelven a este layout).
 */

// Fuente Poppins autoalojada (sin peticiones a Google): solo los pesos usados.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/400-italic.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';

import '@styles/global.css';

import { site } from '@data/site';

export interface Props {
	/** Título de la página (se completa con " | Peruana en Rusia") */
	title?: string;
	/** Descripción para buscadores y redes sociales */
	description?: string;
	/** Imagen para compartir en redes (ruta absoluta o URL) */
	image?: string;
	/** true = la página no se indexa en buscadores (ej. portal, 404) */
	noindex?: boolean;
	/** Clase extra para el <body> (ej. para cambiar el fondo de la página) */
	bodyClass?: string;
}

const { title, description = site.description, image, noindex = false, bodyClass } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Ícono del sitio: símbolo de la marca -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#171a1a" />

		<!-- Open Graph (vista previa al compartir en redes sociales) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		<meta name="twitter:card" content="summary_large_image" />

		<slot name="head" />
	</head>

	<body class={bodyClass}>
		<a class="skip-link" href="#contenido">
			Saltar al contenido
		</a>
		<slot />
	</body>
</html>
