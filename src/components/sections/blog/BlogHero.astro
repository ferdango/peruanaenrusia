---
/**
 * BlogHero — "Nuestro Blog"
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "MacBook Pro 14" - 6" (1519:383) › "Frame 23" (1519:447)
 * · UI Mobile › Blog (1081:188) › 1082:221 (título y bajada), con el lenguaje
 * del hero del Home (Manual de marca 2025):
 *
 *   - Fondo azul de la marca con el tubo degradé y las líneas planas, que se
 *     dibujan al cargar. El header queda transparente encima, como en el Home
 *     (body.hero-overlay, src/styles/motion.css): por eso la sección sube bajo
 *     el header con un margen negativo.
 *   - Título (h1), bajada y accesos a las secciones del blog.
 *   - La publicación más reciente destacada en una tarjeta de vidrio: si es un
 *     video, se reproduce en el modal (VideoModal en la página); sin
 *     JavaScript lleva a su página.
 *
 * Uso: primera sección de src/pages/blog/index.astro
 *   <BlogHero featured={posts[0]} />
 */
import { Image } from 'astro:assets';

import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import { blogSectionIds, type BlogPost } from '@data/blog';
import { detailRoutes } from '@data/navigation';
import { formatDate } from '@utils/format';
import tubeScene from '@assets/graphics/tubes/tube-blue-scene.webp';
import BrandLines from '@assets/graphics/waves/brand-lines.svg';
import Star from '@assets/graphics/stars/star-4-point.svg';

interface Props {
	/** Publicación destacada (la más reciente) */
	featured?: BlogPost;
}

const { featured } = Astro.props;

// ----- Contenido de la sección -----
const content = {
	eyebrow: 'Blog y videoblog',
	title: 'Nuestro Blog',
	subtitle: '¿Siempre quisiste estudiar fuera del país? Ahora sí es posible',
	lead: 'Historias reales, visitas a universidades y consejos para estudiar en Rusia, contados por estudiantes becados.',
	navLabel: 'Secciones del blog',
	latest: 'Lo más reciente',
	duration: 'Duración',
	watch: 'Ver video',
	read: 'Leer artículo',
};

/** Accesos a las secciones de la página */
const links = [
	{ label: 'Novedades', href: `#${blogSectionIds.news}` },
	{ label: 'Videoblogs', href: `#${blogSectionIds.videoblogs}` },
	{ label: 'Shorts de TikTok', href: '#redes' },
];

const video = featured?.type === 'video' ? featured.video : undefined;
const featuredLink = featured
	? {
			href: detailRoutes.blogPost(featured.slug),
			...(video?.youtubeId
				? {
						'data-video-open': '',
						'data-video-youtube': video.youtubeId,
						'data-video-title': video.title,
					}
				: {}),
		}
	: undefined;
---

<section class="blog-hero" aria-labelledby="blog-hero-title">
	<!-- Tubo degradé, líneas planas y estrellas de la marca (decorativos) -->
	<div class="blog-hero__decor" aria-hidden="true">
		<Image
			src={tubeScene}
			alt=""
			widths={[800, 1400, 2000]}
			sizes="(max-width: 1100px) 120vw, 70vw"
			loading="eager"
			class="blog-hero__tube"
		/>
		<BrandLines class="blog-hero__lines" />
		<Star class="blog-hero__star blog-hero__star--yellow" />
		<Star class="blog-hero__star blog-hero__star--sky" />
		<Star class="blog-hero__star blog-hero__star--pink" />
	</div>

	<div class="blog-hero__inner container">
		<div class="blog-hero__content">
			<p class="blog-hero__eyebrow">
				<Icon name="youtube-play" size={18} class="blog-hero__eyebrow-icon" />
				{content.eyebrow}
			</p>
			<h1 id="blog-hero-title" class="blog-hero__title">
				{content.title}
			</h1>
			<p class="blog-hero__subtitle">{content.subtitle}</p>
			<p class="blog-hero__lead">{content.lead}</p>

			<nav class="blog-hero__nav" aria-label={content.navLabel}>
				<ul role="list" class="blog-hero__links">
					{links.map((link) => (
						<li>
							<a href={link.href} class="blog-hero__chip">
								{link.label}
								<Icon name="arrow-right" size={14} class="blog-hero__chip-icon" />
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>

		{featured && featuredLink && (
			<article class="blog-hero__feature">
				<div class="blog-hero__media">
					<MediaImage
						image={featured.image}
						alt=""
						widths={[640, 960, 1280]}
						sizes="(max-width: 1100px) 92vw, 528px"
						loading="eager"
						class="blog-hero__image"
					/>
					{video && (
						<span class="blog-hero__play" aria-hidden="true">
							<Icon name="play" size={26} />
						</span>
					)}
					{video?.duration && (
						<span class="blog-hero__duration" aria-hidden="true">
							{video.duration}
						</span>
					)}
				</div>
				<div class="blog-hero__feature-body">
					<p class="blog-hero__meta">
						<span class="blog-hero__badge">{content.latest}</span>
						<time datetime={featured.date}>{formatDate(featured.date)}</time>
						{video?.duration && (
							<span class="visually-hidden">
								· {content.duration} {video.duration}
							</span>
						)}
					</p>
					<h2 class="blog-hero__feature-title">
						<a class="blog-hero__link" {...featuredLink}>
							<span class="visually-hidden">{video ? content.watch : content.read}: </span>
							{featured.title}
						</a>
					</h2>
				</div>
			</article>
		)}
	</div>
</section>

<style>
	.blog-hero {
		position: relative;
		isolation: isolate;
		overflow: clip;
		/* Sube bajo el header (transparente sobre el hero, como en el Home) */
		margin-top: calc(-1 * var(--header-height));
		padding-top: calc(var(--header-height) + clamp(3rem, 1.5rem + 4.5vw, 6.5rem));
		padding-bottom: clamp(5rem, 3rem + 6vw, 9rem);
		/* Azul profundo a la izquierda (contraste del texto) que termina en el tono del tubo */
		background:
			radial-gradient(60rem 30rem at 85% 10%, rgb(0 192 252 / 0.28), transparent 60%),
			linear-gradient(100deg, #0052c4 0%, #0066e8 38%, #007cff 70%);
		color: var(--color-pure-white);
	}

	/* ===== Decorados ===== */
	.blog-hero__decor {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	/* Tubo degradé (render oficial): asoma a la derecha y se funde con el fondo */
	.blog-hero__tube {
		position: absolute;
		top: -12%;
		right: -16%;
		width: min(78rem, 72%);
		max-width: none;
		height: auto;
		opacity: 0.95;
		mask-image:
			linear-gradient(to right, transparent 0%, #000 34%),
			linear-gradient(to bottom, #000 70%, transparent 100%);
		mask-composite: intersect;
	}

	/* Líneas planas (amarilla, roja y celeste) al pie del hero */
	.blog-hero__lines {
		position: absolute;
		bottom: clamp(-1.5rem, -1vw, -0.5rem);
		left: 0;
		width: 100%;
		height: clamp(6rem, 9vw, 9.5rem);
	}

	.blog-hero__lines :global(.brand-line) {
		stroke-dasharray: 100 100;
	}

	.blog-hero__star {
		position: absolute;
		height: auto;
	}

	.blog-hero__star--yellow {
		top: calc(var(--header-height) + 2.5rem);
		left: max(var(--gutter), calc((100% - var(--container-max)) / 2 + 26rem));
		width: 2rem;
		color: var(--color-yellow);
	}

	.blog-hero__star--sky {
		bottom: 9rem;
		left: 46%;
		width: 1.25rem;
		color: var(--color-skyblue);
	}

	.blog-hero__star--pink {
		top: 32%;
		right: max(var(--gutter), calc((100% - var(--container-max)) / 2 - 1rem));
		width: 1rem;
		color: var(--color-pink);
	}

	/* ===== Contenido: texto + publicación destacada ===== */
	.blog-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 33rem);
		align-items: center;
		gap: var(--space-8) clamp(var(--space-8), 5vw, 6rem);
	}

	.blog-hero__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.blog-hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border: 1px solid rgb(255 255 255 / 0.28);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.12);
		backdrop-filter: blur(8px);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
	}

	.blog-hero__eyebrow :global(.blog-hero__eyebrow-icon) {
		color: var(--color-red);
	}

	.blog-hero__title {
		font-size: var(--font-size-display);
		line-height: 0.98;
		letter-spacing: -0.035em;
	}

	.blog-hero__subtitle {
		max-width: 32rem;
		font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem);
		font-weight: var(--font-weight-semibold);
		line-height: 1.3;
	}

	.blog-hero__lead {
		max-width: 32rem;
		font-size: var(--font-size-lg);
		line-height: 1.75rem;
		color: rgb(255 255 255 / 0.88);
	}

	/* Accesos a las secciones */
	.blog-hero__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		margin-top: var(--space-3);
	}

	.blog-hero__chip {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.75rem;
		padding: 0.5rem 1rem;
		border: 1px solid rgb(255 255 255 / 0.35);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.1);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		transition:
			background-color var(--duration-base) var(--ease-out),
			color var(--duration-base) var(--ease-out);
	}

	.blog-hero__chip:hover {
		background-color: var(--color-pure-white);
		color: var(--color-blue-title);
	}

	.blog-hero__chip :global(.blog-hero__chip-icon) {
		transition: translate var(--duration-base) var(--ease-out);
	}

	.blog-hero__chip:hover :global(.blog-hero__chip-icon) {
		translate: 0.1875rem 0;
	}

	.blog-hero a:focus-visible {
		outline: 3px solid var(--color-yellow);
		outline-offset: 3px;
	}

	/* ----- Publicación destacada: tarjeta de vidrio ----- */
	.blog-hero__feature {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-3) var(--space-3) var(--space-5);
		border: 1px solid rgb(255 255 255 / 0.24);
		border-radius: var(--radius-xl);
		background-color: rgb(255 255 255 / 0.1);
		backdrop-filter: blur(16px) saturate(1.3);
		box-shadow: 0 2.5rem 5rem -2.5rem rgb(0 20 70 / 0.75);
	}

	.blog-hero__media {
		position: relative;
		overflow: clip;
		aspect-ratio: 16 / 9;
		border-radius: calc(var(--radius-xl) - var(--space-3));
	}

	.blog-hero__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 0.8s var(--ease-out);
	}

	.blog-hero__feature:hover .blog-hero__image {
		scale: 1.05;
	}

	.blog-hero__play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		box-shadow:
			0 0 0 0.75rem rgb(255 255 255 / 0.25),
			0 1rem 2rem -0.75rem rgb(0 0 0 / 0.6);
		color: var(--color-blue);
		translate: -50% -50%;
		transition: scale var(--duration-slow) var(--ease-out);
	}

	.blog-hero__play :global(svg) {
		margin-left: 0.25rem;
	}

	.blog-hero__feature:hover .blog-hero__play {
		scale: 1.08;
	}

	.blog-hero__duration {
		position: absolute;
		right: var(--space-3);
		bottom: var(--space-3);
		padding: 0.25rem 0.5rem;
		border-radius: 0.5rem;
		background-color: rgb(0 0 0 / 0.72);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		font-variant-numeric: tabular-nums;
		line-height: 1rem;
	}

	.blog-hero__feature-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-inline: var(--space-3);
	}

	.blog-hero__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-3);
		font-size: var(--font-size-sm);
		color: rgb(255 255 255 / 0.85);
	}

	.blog-hero__badge {
		padding: 0.1875rem 0.625rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-red);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		letter-spacing: 0.02em;
		color: var(--color-pure-white);
	}

	.blog-hero__feature-title {
		font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem);
		font-weight: var(--font-weight-bold);
		line-height: 1.25;
		text-wrap: balance;
	}

	/* Toda la tarjeta es clicable */
	.blog-hero__link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: inherit;
	}

	.blog-hero__link:focus-visible {
		outline: none;
	}

	.blog-hero__feature:has(.blog-hero__link:focus-visible) {
		outline: 3px solid var(--color-yellow);
		outline-offset: 4px;
	}

	/* ===== Entrada al cargar (sin "reducir movimiento") ===== */
	@media (prefers-reduced-motion: no-preference) {
		.blog-hero__content > * {
			animation: blog-hero-rise 0.9s var(--ease-out) both;
		}

		.blog-hero__content > :nth-child(2) {
			animation-delay: 0.08s;
		}

		.blog-hero__content > :nth-child(3) {
			animation-delay: 0.18s;
		}

		.blog-hero__content > :nth-child(4) {
			animation-delay: 0.26s;
		}

		.blog-hero__content > :nth-child(5) {
			animation-delay: 0.34s;
		}

		.blog-hero__feature {
			animation: blog-hero-card 1.1s 0.2s var(--ease-out) both;
		}

		.blog-hero__tube {
			animation: blog-hero-tube 1.6s var(--ease-out) both;
		}

		/* Las líneas se dibujan una tras otra */
		.blog-hero__lines :global(.brand-line) {
			animation: blog-hero-draw 1.8s 0.3s cubic-bezier(0.65, 0, 0.35, 1) both;
		}

		.blog-hero__lines :global(.brand-line:nth-of-type(2)) {
			animation-delay: 0.45s;
		}

		.blog-hero__lines :global(.brand-line:nth-of-type(3)) {
			animation-delay: 0.6s;
		}

		.blog-hero__star {
			animation: blog-hero-twinkle 3.4s ease-in-out infinite;
		}

		.blog-hero__star--sky {
			animation-delay: -1.2s;
		}

		.blog-hero__star--pink {
			animation-delay: -2.3s;
		}
	}

	@keyframes blog-hero-rise {
		from {
			opacity: 0;
			translate: 0 1.5rem;
		}
	}

	@keyframes blog-hero-card {
		from {
			opacity: 0;
			translate: 3rem 0;
			rotate: 2deg;
		}
	}

	@keyframes blog-hero-tube {
		from {
			opacity: 0;
			scale: 0.92;
			translate: 4% 4%;
		}
	}

	@keyframes blog-hero-draw {
		from {
			stroke-dashoffset: 100;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes blog-hero-twinkle {
		0%,
		100% {
			transform: rotate(-14deg) scale(1);
		}
		50% {
			transform: rotate(14deg) scale(0.7);
		}
	}

	/* ===== Tablet: la tarjeta va debajo del texto ===== */
	@media (max-width: 1100px) {
		.blog-hero__inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.blog-hero__feature {
			max-width: 36rem;
		}

		.blog-hero__tube {
			top: -6%;
			right: -40%;
			width: 110%;
		}

		.blog-hero__star--yellow {
			left: auto;
			right: var(--gutter);
		}
	}

	/* ===== Móvil ===== */
	@media (max-width: 640px) {
		.blog-hero {
			padding-top: calc(var(--header-height) + var(--space-8));
			padding-bottom: var(--space-10);
		}

		.blog-hero__content {
			gap: var(--space-3);
		}

		.blog-hero__title {
			font-size: var(--font-size-display-mobile);
		}

		.blog-hero__subtitle {
			font-size: 1.125rem;
		}

		.blog-hero__lead {
			font-size: var(--font-size-md);
			line-height: 1.5rem;
		}

		.blog-hero__tube {
			top: 0;
			right: -60%;
			width: 150%;
			opacity: 0.55;
		}

		.blog-hero__feature {
			padding: var(--space-2) var(--space-2) var(--space-4);
			border-radius: var(--radius-lg);
		}

		.blog-hero__media {
			border-radius: calc(var(--radius-lg) - var(--space-2));
		}

		.blog-hero__play {
			width: 3.5rem;
			height: 3.5rem;
		}

		.blog-hero__feature-body {
			padding-inline: var(--space-2);
		}

		.blog-hero__feature-title {
			font-size: var(--font-size-card-title-mobile);
			line-height: 1.35;
		}

		.blog-hero__star--sky {
			display: none;
		}
	}
</style>
