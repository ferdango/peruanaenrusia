# ==========================================================================
# Variables de entorno — Peruana en Rusia
# --------------------------------------------------------------------------
# Copia este archivo como .env (desarrollo) o configúralas en el panel de tu
# hosting (producción). NUNCA subas el archivo .env al repositorio.
# Todas son opcionales: sin ellas el sitio funciona con el contenido local y,
# en desarrollo, los correos se muestran en la terminal.
# Guías: docs/DESPLIEGUE.md · docs/WORDPRESS.md · docs/AUTENTICACION.md
# ==========================================================================

# ----- Sitio -----
# Dominio público (URLs canónicas, sitemap, Open Graph y vuelta de Google)
SITE_URL=https://peruanaenrusia.pe
# Subcarpeta de publicación (vacío = raíz del dominio). GitHub Pages sin
# dominio propio publica en /<repositorio>, ej. /peruanaenrusia
BASE_PATH=
# server = servidor Node con API (por defecto) · static = HTML puro para
# GitHub Pages (portal de ejemplo y acceso de demostración). Ver docs/DESPLIEGUE.md
DEPLOY_TARGET=server

# ----- Gestor de contenidos: WordPress headless -----
# Con WORDPRESS_URL el contenido (blog, universidades, casos de éxito,
# preguntas frecuentes y legales) se lee de WordPress al compilar.
WORDPRESS_URL=
# Usuario y "contraseña de aplicación" (WordPress → Usuarios → Perfil) para
# guardar cuentas de estudiantes y reclamaciones en WordPress.
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

# ----- Inicio de sesión con Google (OAuth) -----
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente de OAuth
# URI de redirección autorizado: https://TU-DOMINIO/api/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Sesiones -----
# Secreto aleatorio de al menos 32 caracteres (obligatorio en producción).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ----- Correo (códigos de acceso y Libro de reclamaciones) -----
# Remitente de los correos
MAIL_FROM="Peruana en Rusia <hola@peruanaenrusia.pe>"
# Dónde llegan los avisos de nuevas reclamaciones
COMPLAINTS_EMAIL=hola@peruanaenrusia.pe
# Opción A: Resend (https://resend.com)
RESEND_API_KEY=
# Opción B: SMTP (ej. correo de Hostinger: smtp.hostinger.com, puerto 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ----- Servidor -----
# Carpeta privada para sesiones, cuentas y reclamaciones si no hay WordPress
DATA_DIR=.data
# true si el sitio está detrás de un proxy que envía X-Forwarded-For (Hostinger, Nginx…)
TRUST_PROXY=false
# true = el portal se puede ver sin iniciar sesión (SOLO para revisar el diseño)
PORTAL_DEMO=false
# Puerto y host del servidor de producción (npm start)
PORT=4321
HOST=0.0.0.0
