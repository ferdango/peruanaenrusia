---
/**
 * HomeIntro — "Te acompañamos en cada paso de tu camino hacia tu meta"
 * --------------------------------------------------------------------------
 * Figma: Home › "Frame 628097" (1317:194): título + párrafo (889:264) y,
 * debajo, el video destacado con su portada.
 *
 * Un solo video, en una tarjeta ancha y cinematográfica: portada real del
 * video, botón ▶ con pulso, título, canal y duración. La onda naranja y la
 * estrella de la marca asoman por detrás de la tarjeta.
 *
 * Al hacer clic se abre en el modal con mini reproductor
 * (src/components/overlays/VideoModal.astro): se puede minimizar y seguir
 * navegando. Sin JavaScript abre YouTube. El video (y su portada) se cambia en
 * src/data/videos.ts › featuredVideo.
 */
import { Image } from 'astro:assets';

import Icon from '@components/ui/Icon.astro';
import { featuredVideo } from '@data/videos';
import WaveOrange from '@assets/graphics/waves/wave-orange-intro.svg';
import Star from '@assets/graphics/stars/star-4-point.svg';

// ----- Contenido de la sección -----
const content = {
	title: 'Te acompañamos en cada paso de tu camino hacia tu meta',
	text: 'Somos estudiantes peruanos becados en Rusia, que han ganado la beca, estudian y trabajan allá, sabemos todos los pasos a pasar y los errores que no debes cometer.',
	videoLabel: 'Video',
	watch: 'Ver el video',
};
---

<section class="home-intro section" id="acompanamiento" aria-labelledby="home-intro-title">
	<div class="home-intro__inner container">
		<header class="home-intro__header">
			<h2 id="home-intro-title" class="home-intro__title">
				{content.title}
			</h2>
			<p class="home-intro__text">{content.text}</p>
		</header>

		<div class="home-intro__media">
			<!-- Recursos de la marca por detrás de la tarjeta (decorativos) -->
			<WaveOrange class="home-intro__wave" aria-hidden="true" />
			<Star class="home-intro__star" aria-hidden="true" />

			<a
				class="intro-video"
				href={featuredVideo.url}
				target="_blank"
				rel="noopener"
				data-video-open
				data-video-youtube={featuredVideo.youtubeId}
				data-video-title={featuredVideo.title}
			>
				<Image
					src={featuredVideo.cover}
					alt=""
					widths={[640, 960, 1280]}
					sizes="(max-width: 1512px) 92vw, 1352px"
					class="intro-video__cover"
				/>
				<span class="intro-video__shade" aria-hidden="true"></span>

				<span class="intro-video__play" aria-hidden="true">
					<Icon name="play" size={28} />
				</span>

				<span class="intro-video__caption">
					<span class="visually-hidden">{content.watch}:</span>
					<span class="intro-video__chip">
						<Icon name="youtube-play" size={16} />
						{content.videoLabel} · {featuredVideo.duration}
					</span>
					<span class="intro-video__title">{featuredVideo.title}</span>
					<span class="intro-video__channel">{featuredVideo.channel}</span>
				</span>
			</a>
		</div>
	</div>
</section>

<style>
	.home-intro {
		/* La onda decorativa sobresale de la tarjeta: sin scroll horizontal */
		overflow-x: clip;
		/* Más aire arriba: las franjas de lemas se superponen 4.25rem a la sección */
		padding-top: calc(var(--section-padding-y) + 5.75rem);
		background-color: var(--surface-dark);
		color: var(--text-on-dark);
	}

	.home-intro__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-8); /* 48px */
	}

	/* ----- Encabezado: título (801px) + párrafo ----- */
	.home-intro__header {
		display: flex;
		align-items: center;
		gap: var(--space-8);
	}

	.home-intro__title {
		flex: 0 1 50.0625rem; /* 801px */
		font-size: var(--font-size-h1);
		line-height: 1.1667; /* 56px */
	}

	.home-intro__text {
		flex: 1;
		line-height: 1.75rem; /* 28px */
		color: color-mix(in srgb, var(--color-white) 90%, transparent);
	}

	/* ----- Video ----- */
	.home-intro__media {
		position: relative;
		isolation: isolate;
	}

	/* Onda naranja: asoma por arriba a la derecha, detrás de la tarjeta */
	.home-intro__wave {
		position: absolute;
		z-index: -1;
		top: -14%;
		right: -6%;
		width: 52%;
		height: auto;
		color: var(--color-orange);
		transform: rotate(-8deg);
		pointer-events: none;
	}

	.home-intro__star {
		position: absolute;
		z-index: 2;
		left: -1.25rem;
		bottom: 12%;
		width: 2.5rem;
		height: 2.5rem;
		color: var(--color-yellow);
		pointer-events: none;
	}

	.intro-video {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 2 / 1;
		border-radius: var(--radius-xl);
		background-color: var(--surface-dark-raised);
		box-shadow: 0 2rem 4rem -2rem rgb(0 0 0 / 0.8);
		color: var(--color-pure-white);
	}

	.intro-video__cover {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 38%;
		transition: scale 0.8s var(--ease-out);
	}

	.intro-video:hover .intro-video__cover {
		scale: 1.04;
	}

	/* Sombra para que el texto se lea sobre cualquier portada */
	.intro-video__shade {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, rgb(10 14 20 / 0.9) 0%, rgb(10 14 20 / 0.35) 38%, transparent 62%),
			linear-gradient(to right, rgb(10 14 20 / 0.45) 0%, transparent 45%);
	}

	/* Botón ▶: círculo blanco con anillo que late (a la derecha: no tapa a la persona) */
	.intro-video__play {
		position: absolute;
		top: 50%;
		right: clamp(var(--space-6), 9vw, 10rem);
		display: grid;
		place-items: center;
		width: clamp(4.5rem, 3.5rem + 3vw, 6.5rem);
		aspect-ratio: 1;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		color: var(--color-blue);
		translate: 0 -50%;
		box-shadow: 0 1rem 2.5rem -0.75rem rgb(0 0 0 / 0.6);
		transition: scale var(--duration-slow) var(--ease-out);
	}

	.intro-video__play :global(svg) {
		margin-left: 0.25rem; /* centro óptico del triángulo */
	}

	.intro-video__play::before,
	.intro-video__play::after {
		content: '';
		position: absolute;
		inset: 0;
		border: 2px solid rgb(255 255 255 / 0.7);
		border-radius: inherit;
		opacity: 0;
	}

	.intro-video:hover .intro-video__play {
		scale: 1.08;
	}

	.intro-video:focus-visible {
		outline: 3px solid var(--color-skyblue);
		outline-offset: 4px;
	}

	/* Título, canal y duración (abajo a la izquierda) */
	.intro-video__caption {
		position: absolute;
		left: clamp(var(--space-5), 4vw, var(--space-9));
		right: var(--space-5);
		bottom: clamp(var(--space-5), 3.5vw, var(--space-8));
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
	}

	.intro-video__chip {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.75rem;
		border: 1px solid rgb(255 255 255 / 0.3);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.14);
		backdrop-filter: blur(8px);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
	}

	.intro-video__chip :global(svg) {
		color: var(--color-red);
	}

	.intro-video__title {
		max-width: 22ch;
		font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.75rem);
		font-weight: var(--font-weight-bold);
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.intro-video__channel {
		font-size: var(--font-size-sm);
		color: rgb(255 255 255 / 0.82);
	}

	@media (prefers-reduced-motion: no-preference) {
		.intro-video__play::before {
			animation: intro-video-ping 2.6s var(--ease-out) infinite;
		}

		.intro-video__play::after {
			animation: intro-video-ping 2.6s 1.3s var(--ease-out) infinite;
		}
	}

	@keyframes intro-video-ping {
		0% {
			opacity: 0.8;
			scale: 1;
		}
		75%,
		100% {
			opacity: 0;
			scale: 1.7;
		}
	}

	/* ===== Tablet: encabezado apilado ===== */
	@media (max-width: 1100px) {
		.home-intro__header {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--space-4);
		}

		.home-intro__title {
			flex-basis: auto;
		}

		.intro-video {
			aspect-ratio: 16 / 10;
		}
	}

	/* ===== Móvil: tarjeta vertical con la persona al centro ===== */
	@media (max-width: 640px) {
		.home-intro__text {
			line-height: 1.625rem;
		}

		.home-intro {
			/* 48px + lo que se superponen las franjas en móvil (3.25rem) + aire */
			padding-block: calc(var(--space-8) + 4.75rem) var(--space-8);
		}

		.home-intro__inner {
			gap: 1.75rem; /* 28px */
		}

		.home-intro__title {
			line-height: var(--line-height-title-mobile);
			font-size: var(--font-size-title-mobile);
		}

		.home-intro__media {
			/* En el diseño las tarjetas quedan a 12px del borde de la pantalla */
			margin-inline: calc(-1 * var(--space-1));
		}

		.intro-video {
			aspect-ratio: 4 / 5;
			border-radius: var(--radius-lg);
		}

		.intro-video__cover {
			object-position: 46% center;
		}

		/* ▶ en la esquina inferior derecha; el texto le deja espacio */
		.intro-video__play {
			top: auto;
			right: var(--space-5);
			bottom: var(--space-5);
			width: 4rem;
			translate: none;
		}

		.intro-video__caption {
			right: 6rem;
		}

		.home-intro__star {
			left: -0.5rem;
			width: 1.75rem;
			height: 1.75rem;
		}
	}
</style>
