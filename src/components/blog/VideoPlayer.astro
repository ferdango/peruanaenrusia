---
/**
 * VideoPlayer
 * --------------------------------------------------------------------------
 * Video principal de una publicación del blog: miniatura de 1024 × 580 px
 * con el botón ▶ en el centro (Figma: "Single Article Video" › 1698:229).
 *
 * - Con `youtubeId`: al pulsar ▶ se carga el reproductor de YouTube en el
 *   mismo lugar (dominio youtube-nocookie.com, sin cookies de seguimiento).
 *   Hasta entonces no se descarga nada de YouTube. Sin JavaScript, el botón
 *   abre el video en YouTube.
 * - Sin `youtubeId`: el botón ▶ abre el canal de YouTube de la marca
 *   (src/data/site.ts) en una pestaña nueva.
 *
 * Uso:
 *   <VideoPlayer title={video.title} thumbnail={video.thumbnail} youtubeId={video.youtubeId} />
 */
import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import type { ImageSource } from '@lib/content/images';
import { site } from '@data/site';

interface Props {
	/** Título del video (texto accesible del botón y del reproductor) */
	title: string;
	thumbnail: ImageSource;
	youtubeId?: string;
	class?: string;
}

const { title, thumbnail, youtubeId, class: className } = Astro.props;

const youtubeChannel =
	site.socials.find((social) => social.icon === 'youtube')?.href ?? 'https://www.youtube.com/';
const watchUrl = youtubeId ? `https://www.youtube.com/watch?v=${youtubeId}` : youtubeChannel;
const playLabel = youtubeId
	? `Reproducir el video «${title}»`
	: `Ver «${title}» en el canal de YouTube (se abre en una pestaña nueva)`;
---

<div class:list={['video-player', className]} data-video-player data-youtube-id={youtubeId}>
	<MediaImage
		image={thumbnail}
		alt=""
		widths={[640, 1024, 1600]}
		sizes="(max-width: 1100px) 100vw, 1024px"
		class="video-player__poster"
		loading="eager"
	/>

	<a href={watchUrl} class="video-player__play" target="_blank" rel="noopener" data-video-play>
		<Icon name="play" size={24} />
		<span class="visually-hidden">{playLabel}</span>
	</a>
</div>

<script>
	/**
	 * Reproductor "liviano": reemplaza la miniatura por el reproductor de
	 * YouTube solo cuando la persona pulsa ▶.
	 */
	document.querySelectorAll<HTMLElement>('[data-video-player][data-youtube-id]').forEach((player) => {
		const playButton = player.querySelector<HTMLAnchorElement>('[data-video-play]');
		const videoId = player.dataset.youtubeId;
		if (!playButton || !videoId) return;

		playButton.addEventListener('click', (event) => {
			event.preventDefault();

			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0`;
			iframe.title = playButton.textContent?.trim() || 'Video de YouTube';
			iframe.allow =
				'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			iframe.className = 'video-player__iframe';

			player.append(iframe);
			player.classList.add('is-playing');
			iframe.focus();
		});
	});
</script>

<style>
	.video-player {
		position: relative;
		aspect-ratio: 1024 / 580;
		border-radius: var(--radius-xl);
		overflow: clip;
		background-color: var(--surface-dark-raised);
	}

	.video-player__poster {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Botón ▶ blanco con anillo translúcido (como en las tarjetas de video) */
	.video-player__play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 3rem; /* 48px */
		height: 3rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-pure-white);
		box-shadow: 0 0 0 12px rgb(244 244 244 / 0.32);
		color: var(--color-blue);
		transform: translate(-50%, -50%);
		transition: transform var(--duration-base) var(--ease-out);
	}

	.video-player__play:hover {
		transform: translate(-50%, -50%) scale(1.1);
	}

	.video-player__play:focus-visible {
		border-radius: var(--radius-pill);
		box-shadow:
			0 0 0 12px rgb(244 244 244 / 0.32),
			var(--focus-ring);
	}

	/* Reproductor de YouTube (se crea desde JavaScript) */
	.video-player :global(.video-player__iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.video-player:global(.is-playing) .video-player__play {
		display: none;
	}
</style>
