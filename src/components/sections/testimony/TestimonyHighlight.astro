---
/**
 * TestimonyHighlight — Cita destacada sobre la forma celeste
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "My testimony" (1616:222) › "Mask group" (1732:2074):
 * fondo gris claro, la forma celeste de "reloj de arena" de la marca (las
 * bandas superior e inferior unidas por un cuello con la estrella de 4
 * puntas), la frase del estudiante en grande y su nombre abajo a la derecha.
 * Móvil: UI Mobile › Caso de éxito: la misma forma recortada al ancho de la
 * pantalla (se ve el cuello al centro) y la frase en varias líneas.
 *
 * La forma (src/assets/graphics/shapes/shape-hourglass-highlight.svg) es el
 * mismo vector de la marca que usan los consejos de la ficha de universidad,
 * estirado como en el diseño de esta sección (lienzo de 1512 × 890).
 *
 * Mejorado: las comillas de la marca arriba, la frase aparece palabra por
 * palabra al hacer scroll (src/scripts/motion.ts) y la firma lleva la foto
 * del estudiante con su bandera, centrada bajo la frase.
 *
 * Uso: <TestimonyHighlight testimonial={testimonial} />
 */
import { Image } from 'astro:assets';

import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import { countries } from '@data/countries';
import Shape from '@assets/graphics/shapes/shape-hourglass-highlight.svg';
import StarRed from '@assets/graphics/stars/star-red-small.svg';
import StarYellow from '@assets/graphics/stars/star-yellow-small.svg';
import type { Testimonial } from '@data/testimonials';

interface Props {
	testimonial: Testimonial;
}

const { testimonial } = Astro.props;
const country = countries[testimonial.country];
---

{testimonial.highlight && (
	<section class="testimony-highlight" aria-label={`Frase de ${testimonial.name}`}>
		<div class="testimony-highlight__decor" aria-hidden="true">
			<Shape class="testimony-highlight__shape" preserveAspectRatio="xMidYMid slice" />
			<StarYellow class="testimony-highlight__star testimony-highlight__star--yellow" />
			<StarRed class="testimony-highlight__star testimony-highlight__star--red" />
		</div>

		<figure class="testimony-highlight__inner">
			<span class="testimony-highlight__mark" aria-hidden="true">
				<Icon name="quote" width={30} height={34} />
			</span>
			<blockquote class="testimony-highlight__quote">
				<p>“{testimonial.highlight}”</p>
			</blockquote>
			<figcaption class="testimony-highlight__author">
				<span class="testimony-highlight__avatar-ring">
					<MediaImage
						image={testimonial.avatar}
						alt=""
						width={48}
						height={48}
						class="testimony-highlight__avatar"
					/>
					<Image
						src={country.flag}
						alt={country.name}
						width={20}
						height={20}
						densities={[1, 2]}
						class="testimony-highlight__flag"
					/>
				</span>
				<span class="testimony-highlight__who">
					<strong class="testimony-highlight__name">{testimonial.name}</strong>
					<span>{testimonial.role}</span>
				</span>
			</figcaption>
		</figure>
	</section>
)}

<style>
	.testimony-highlight {
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		min-height: clamp(40rem, 52vw, 50rem); /* Figma: 890px */
		overflow: clip;
		background-color: var(--surface-light);
		color: var(--text-on-light);
	}

	/* ----- Forma celeste: lienzo de 1512 × 890 centrado ----- */
	.testimony-highlight__decor {
		position: absolute;
		top: 0;
		left: 50%;
		z-index: -1;
		width: 1512px;
		height: 100%;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.testimony-highlight__shape {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
	}

	.testimony-highlight__star {
		position: absolute;
		max-width: none;
	}

	/* Posiciones de Figma, en % del alto (la sección es más baja que en Figma) */
	.testimony-highlight__star--yellow {
		left: 1300px;
		top: 13%;
		width: 17px;
		height: auto;
	}

	.testimony-highlight__star--red {
		left: 180px;
		top: 76%;
		width: 16px;
		height: auto;
	}

	/* ----- Frase ----- */
	.testimony-highlight__inner {
		display: grid;
		justify-items: center;
		gap: var(--space-6);
		width: 100%;
		max-width: calc(80rem + 2 * var(--gutter)); /* 1280px */
		margin: 0 auto;
		padding: var(--space-10) var(--gutter);
	}

	/* Figma: Poppins Bold ~100/107, azul de títulos, centrada */
	.testimony-highlight__quote {
		max-width: 75rem; /* 1200px: cortes de línea como en Figma */
		margin: 0 auto;
		font-size: clamp(2.5rem, 0.6rem + 5.9vw, 6.25rem);
		font-weight: var(--font-weight-bold);
		line-height: 1.07;
		color: var(--color-blue-title);
		text-align: center;
		text-wrap: balance;
	}

	/* Comillas de la marca en un círculo azul */
	.testimony-highlight__mark {
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: var(--radius-pill);
		background: linear-gradient(135deg, var(--color-skyblue), var(--color-blue));
		box-shadow: 0 1rem 2rem -1rem rgb(0 122 252 / 0.8);
		color: var(--color-pure-white);
	}

	/* Firma: foto con anillo degradé y bandera + nombre y carrera (Figma: 16/20 y 14/20) */
	.testimony-highlight__author {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-5) var(--space-2) var(--space-2);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.85);
		box-shadow: 0 1rem 2rem -1.5rem rgb(18 91 168 / 0.6);
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
	}

	.testimony-highlight__avatar-ring {
		position: relative;
		flex-shrink: 0;
		padding: 2px;
		border-radius: var(--radius-pill);
		background: linear-gradient(135deg, var(--color-skyblue), var(--color-red));
	}

	.testimony-highlight__avatar {
		display: block;
		width: 3rem;
		height: 3rem;
		border: 2px solid var(--surface-white);
		border-radius: var(--radius-pill);
		object-fit: cover;
	}

	.testimony-highlight__flag {
		position: absolute;
		right: -0.25rem;
		bottom: -0.125rem;
		width: 1.25rem;
		height: 1.25rem;
		border: 2px solid var(--surface-white);
		border-radius: var(--radius-pill);
		object-fit: cover;
	}

	.testimony-highlight__who {
		display: flex;
		flex-direction: column;
		max-width: 16rem;
	}

	.testimony-highlight__name {
		font-size: var(--font-size-md);
		color: var(--color-blue-title);
	}

	/* ===== Tablet y móvil: la forma se recorta al ancho de la pantalla ===== */
	@media (max-width: 1100px) {
		.testimony-highlight__decor {
			left: 0;
			width: 100%;
			transform: none;
		}

		.testimony-highlight__star {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.testimony-highlight {
			min-height: 46rem;
		}

		.testimony-highlight__inner {
			gap: var(--space-6);
			padding-block: var(--space-9);
		}

		.testimony-highlight__mark {
			width: 3.5rem;
			height: 3.5rem;
		}

		.testimony-highlight__quote {
			font-size: 2.25rem;
			line-height: 1.1;
		}

		.testimony-highlight__author {
			padding-right: var(--space-4);
		}

		.testimony-highlight__who {
			max-width: 13rem;
		}
	}
</style>
