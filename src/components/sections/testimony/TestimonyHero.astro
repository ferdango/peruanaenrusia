---
/**
 * TestimonyHero — Portada del caso de éxito
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "My testimony" (1616:222) › panel azul (1732:2082),
 * foto (1732:2089), texto (1732:2094 · 1825:240) y flecha (1835:256).
 * Móvil: UI Mobile › 1758:3816.
 *
 * Con el lenguaje del Home y del Blog: el header es transparente sobre la
 * portada (body.hero-overlay) y la portada sube bajo el header.
 *   - Izquierda: "← Casos de éxito", la etiqueta, la frase del estudiante
 *     (h1 de la página), su foto con la bandera, su nombre y carrera, y el
 *     botón "Mi historia" (baja al paso a paso).
 *   - Derecha: la foto en una tarjeta con la ruta "Perú → Rusia".
 *   - Las líneas de la marca se dibujan al cargar y las estrellas titilan.
 *   - Abajo al centro: flecha para bajar a la siguiente sección.
 * Móvil: el texto arriba y la foto debajo.
 *
 * Uso:
 *   <TestimonyHero testimonial={testimonial} storyHref="#mi-historia" nextHref="#conoce-mi-historia" />
 */
import { Image } from 'astro:assets';

import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import MediaImage from '@components/ui/MediaImage.astro';
import { countries } from '@data/countries';
import { routes } from '@data/navigation';
import type { Testimonial } from '@data/testimonials';
import BrandLines from '@assets/graphics/waves/brand-lines.svg';
import Star from '@assets/graphics/stars/star-4-point.svg';

interface Props {
	testimonial: Testimonial;
	/** Ancla del botón "Mi historia" */
	storyHref: string;
	/** Ancla de la flecha "bajar" */
	nextHref: string;
}

const { testimonial, storyHref, nextHref } = Astro.props;

const country = countries[testimonial.country];
const destination = countries.ru;

// ----- Contenido de la sección -----
const content = {
	back: 'Casos de éxito',
	eyebrow: 'Caso de éxito',
	titlePrefix: `Caso de éxito de ${testimonial.name}:`,
	cta: 'Mi historia',
	route: `De ${country.name} a ${destination.name}`,
	scrollLabel: 'Bajar a la siguiente sección',
};

const headline = testimonial.headline ?? testimonial.quote;
const portrait = testimonial.portrait ?? { src: testimonial.avatar, alt: `Foto de ${testimonial.name}` };
---

<section class="testimony-hero" aria-labelledby="testimony-hero-title">
	<!-- Líneas planas y estrellas de la marca (decorativas) -->
	<div class="testimony-hero__decor" aria-hidden="true">
		<BrandLines class="testimony-hero__lines" />
		<Star class="testimony-hero__star testimony-hero__star--yellow" />
		<Star class="testimony-hero__star testimony-hero__star--sky" />
		<Star class="testimony-hero__star testimony-hero__star--pink" />
	</div>

	<div class="testimony-hero__inner container">
		<div class="testimony-hero__content">
			<a href={routes.successCases} class="testimony-hero__back">
				<Icon name="arrow-left" size={16} />
				{content.back}
			</a>

			<p class="testimony-hero__eyebrow">
				<Star class="testimony-hero__eyebrow-star" aria-hidden="true" />
				{content.eyebrow}
			</p>

			<h1 id="testimony-hero-title" class="testimony-hero__quote">
				<span class="visually-hidden">{content.titlePrefix} </span>“{headline}”
			</h1>

			<div class="testimony-hero__author">
				<span class="testimony-hero__avatar-ring">
					<MediaImage
						image={testimonial.avatar}
						alt=""
						width={64}
						height={64}
						class="testimony-hero__avatar"
					/>
					<Image
						src={country.flag}
						alt={country.name}
						width={24}
						height={24}
						densities={[1, 2]}
						class="testimony-hero__flag"
					/>
				</span>
				<p class="testimony-hero__who">
					<strong class="testimony-hero__name">{testimonial.name}</strong>
					<span class="testimony-hero__role">{testimonial.role}</span>
				</p>
			</div>

			<Button href={storyHref} class="testimony-hero__cta">
				{content.cta}
			</Button>
		</div>

		<div class="testimony-hero__media">
			<div class="testimony-hero__card">
				<MediaImage
					image={portrait.src}
					alt={portrait.alt}
					widths={[480, 760, 1100]}
					sizes="(max-width: 640px) 92vw, (max-width: 1100px) 26rem, 34rem"
					loading="eager"
					fetchpriority="high"
					class="testimony-hero__photo"
				/>
				<span class="testimony-hero__shade" aria-hidden="true"></span>

				<p class="testimony-hero__route">
					<span class="testimony-hero__route-place" aria-hidden="true">
						<Image
							src={country.flag}
							alt=""
							width={20}
							height={20}
							densities={[1, 2]}
							class="testimony-hero__route-flag"
						/>
						{country.name}
					</span>
					<span class="testimony-hero__route-line" aria-hidden="true"></span>
					<span class="testimony-hero__route-place" aria-hidden="true">
						<Image
							src={destination.flag}
							alt=""
							width={20}
							height={20}
							densities={[1, 2]}
							class="testimony-hero__route-flag"
						/>
						{destination.name}
					</span>
					<span class="visually-hidden">{content.route}</span>
				</p>
			</div>

			<span class="testimony-hero__badge" aria-hidden="true">
				<Icon name="quote" width={24} height={27} />
			</span>
		</div>
	</div>

	<a href={nextHref} class="testimony-hero__scroll" aria-label={content.scrollLabel}>
		<Icon name="arrow-right" size={22} />
	</a>
</section>

<style>
	.testimony-hero {
		position: relative;
		isolation: isolate;
		/* Sube bajo el header (transparente sobre la portada, como en el Home) */
		margin-top: calc(-1 * var(--header-height));
		padding-block: calc(var(--header-height) + clamp(2.5rem, 1rem + 4vw, 5rem))
			clamp(8rem, 5rem + 6vw, 10.5rem);
		overflow: hidden; /* respaldo de "clip" en navegadores antiguos */
		overflow: clip;
		/* Azul de la marca, más profundo a la izquierda (contraste AA del texto) */
		background:
			radial-gradient(56rem 32rem at 85% 0%, rgb(0 192 252 / 0.32), transparent 62%),
			radial-gradient(42rem 28rem at 0% 100%, rgb(255 26 48 / 0.2), transparent 70%),
			linear-gradient(110deg, #0046ad 0%, #005ad1 45%, #0a72ec 100%);
		color: var(--color-pure-white);
	}

	/* ===== Decorados ===== */
	.testimony-hero__decor {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	/* Líneas planas (amarilla, roja y celeste) al pie de la portada */
	.testimony-hero__lines {
		position: absolute;
		bottom: clamp(-1.5rem, -1vw, -0.5rem);
		left: 0;
		width: 100%;
		height: clamp(6rem, 9vw, 9.5rem);
	}

	.testimony-hero__lines :global(.brand-line) {
		stroke-dasharray: 100 100;
	}

	.testimony-hero__star {
		position: absolute;
		height: auto;
	}

	.testimony-hero__star--yellow {
		top: calc(var(--header-height) + 2.5rem);
		left: max(var(--gutter), calc((100% - var(--container-max)) / 2 + 30rem));
		width: 2rem;
		color: var(--color-yellow);
	}

	.testimony-hero__star--sky {
		bottom: 10rem;
		left: 44%;
		width: 1.25rem;
		color: var(--color-skyblue);
	}

	.testimony-hero__star--pink {
		top: 30%;
		right: max(calc(var(--gutter) - 0.5rem), calc((100% - var(--container-max)) / 2 - 1.5rem));
		width: 1rem;
		color: var(--color-pink);
	}

	/* ===== Contenido ===== */
	.testimony-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		align-items: center;
		gap: clamp(2.5rem, 5vw, 5rem);
	}

	.testimony-hero__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-5);
	}

	.testimony-hero__back {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		color: rgb(255 255 255 / 0.82);
		transition: color var(--duration-base) var(--ease-out);
	}

	.testimony-hero__back :global(svg) {
		transition: translate var(--duration-base) var(--ease-out);
	}

	.testimony-hero__back:hover {
		color: var(--color-pure-white);
	}

	.testimony-hero__back:hover :global(svg) {
		translate: -3px 0;
	}

	.testimony-hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-2);
		padding: 0.375rem 0.875rem 0.375rem 0.625rem;
		border: 1px solid rgb(255 255 255 / 0.24);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.1);
		backdrop-filter: blur(8px);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.02em;
	}

	.testimony-hero__eyebrow-star {
		width: 1rem;
		height: 1rem;
		color: var(--color-yellow);
	}

	/* Figma: Poppins Bold 84 */
	.testimony-hero__quote {
		max-width: 14ch;
		font-size: clamp(2.5rem, 1rem + 4.4vw, 5.25rem);
		font-weight: var(--font-weight-bold);
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--color-pure-white);
		text-wrap: balance;
	}

	/* Autor: foto con anillo degradé y bandera, nombre y carrera */
	.testimony-hero__author {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		margin-top: var(--space-2);
	}

	.testimony-hero__avatar-ring {
		position: relative;
		flex-shrink: 0;
		padding: 3px;
		border-radius: var(--radius-pill);
		background: linear-gradient(135deg, var(--color-yellow), var(--color-red));
	}

	.testimony-hero__avatar {
		display: block;
		width: 3.5rem;
		height: 3.5rem;
		border: 2px solid #0050c0;
		border-radius: var(--radius-pill);
		object-fit: cover;
	}

	.testimony-hero__flag {
		position: absolute;
		right: -0.25rem;
		bottom: -0.125rem;
		width: 1.5rem;
		height: 1.5rem;
		border: 2px solid #0050c0;
		border-radius: var(--radius-pill);
		object-fit: cover;
	}

	.testimony-hero__who {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		max-width: 20rem;
	}

	.testimony-hero__name {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-bold);
		line-height: 1.5rem;
	}

	.testimony-hero__role {
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
		color: var(--text-on-dark-soft);
	}

	.testimony-hero :global(.testimony-hero__cta) {
		margin-top: var(--space-3);
	}

	/* ===== Foto en una tarjeta ===== */
	.testimony-hero__media {
		position: relative;
		justify-self: end;
		width: min(100%, 34rem);
	}

	/* Halo de color detrás de la tarjeta */
	.testimony-hero__media::before {
		content: '';
		position: absolute;
		inset: 8% -6% -6% 8%;
		z-index: -1;
		border-radius: 2.5rem;
		background: linear-gradient(135deg, var(--color-skyblue), var(--color-red));
		opacity: 0.55;
		filter: blur(2.5rem);
	}

	.testimony-hero__card {
		position: relative;
		isolation: isolate;
		aspect-ratio: 4 / 5;
		overflow: clip;
		border: 1px solid rgb(255 255 255 / 0.24);
		border-radius: 2.5rem;
		background-color: #0b3f8f;
		box-shadow: 0 2.5rem 5rem -2rem rgb(0 20 60 / 0.75);
	}

	.testimony-hero__photo {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.testimony-hero__shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(to top, rgb(0 18 48 / 0.6), transparent 40%);
	}

	/* Ruta "Perú → Rusia" en una píldora de vidrio */
	.testimony-hero__route {
		position: absolute;
		left: var(--space-5);
		bottom: var(--space-5);
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		padding: 0.5rem 0.875rem;
		border: 1px solid rgb(255 255 255 / 0.28);
		border-radius: var(--radius-pill);
		background-color: rgb(0 18 48 / 0.45);
		backdrop-filter: blur(10px);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
	}

	.testimony-hero__route-place {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.testimony-hero__route-flag {
		width: 1.25rem;
		height: 1.25rem;
		border-radius: var(--radius-pill);
		box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.85);
		object-fit: cover;
	}

	.testimony-hero__route-line {
		width: 2.25rem;
		height: 2px;
		background: repeating-linear-gradient(
			to right,
			rgb(255 255 255 / 0.8) 0 0.375rem,
			transparent 0.375rem 0.75rem
		);
		background-size: 0.75rem 100%;
	}

	/* Comillas de la marca, flotando sobre la esquina de la tarjeta */
	.testimony-hero__badge {
		position: absolute;
		top: -1.25rem;
		left: -1.25rem;
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-yellow);
		box-shadow: 0 1rem 2rem -0.75rem rgb(0 0 0 / 0.45);
		color: #002546;
	}

	/* ===== Flecha "bajar" ===== */
	.testimony-hero__scroll {
		position: absolute;
		bottom: var(--space-7);
		left: 50%;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 3.5rem;
		height: 3.5rem;
		border: 1px solid rgb(255 255 255 / 0.4);
		border-radius: var(--radius-pill);
		background-color: rgb(255 255 255 / 0.08);
		backdrop-filter: blur(8px);
		color: var(--color-pure-white);
		translate: -50% 0;
		transition:
			background-color var(--duration-base) var(--ease-out),
			border-color var(--duration-base) var(--ease-out);
	}

	.testimony-hero__scroll :global(svg) {
		rotate: 90deg;
	}

	.testimony-hero__scroll:hover {
		border-color: var(--color-pure-white);
		background-color: rgb(255 255 255 / 0.18);
	}

	.testimony-hero a:focus-visible {
		outline: 2px solid var(--color-yellow);
		outline-offset: 3px;
	}

	/* ===== Entrada al cargar ===== */
	@media (prefers-reduced-motion: no-preference) {
		.testimony-hero__content > * {
			animation: testimony-hero-rise 0.9s var(--ease-out) both;
		}

		.testimony-hero__content > :nth-child(2) {
			animation-delay: 0.06s;
		}

		.testimony-hero__content > :nth-child(3) {
			animation-delay: 0.12s;
		}

		.testimony-hero__content > :nth-child(4) {
			animation-delay: 0.22s;
		}

		.testimony-hero__content > :nth-child(5) {
			animation-delay: 0.3s;
		}

		.testimony-hero__card {
			animation: testimony-hero-card 1.2s var(--ease-out) 0.1s both;
		}

		.testimony-hero__badge {
			animation:
				testimony-hero-pop 0.7s var(--ease-out) 0.7s both,
				testimony-hero-float 6s ease-in-out 1.4s infinite;
		}

		.testimony-hero__lines :global(.brand-line) {
			animation: testimony-hero-draw 1.8s 0.3s cubic-bezier(0.65, 0, 0.35, 1) both;
		}

		.testimony-hero__lines :global(.brand-line:nth-of-type(2)) {
			animation-delay: 0.45s;
		}

		.testimony-hero__lines :global(.brand-line:nth-of-type(3)) {
			animation-delay: 0.6s;
		}

		.testimony-hero__star {
			animation: testimony-hero-twinkle 3.4s ease-in-out infinite;
		}

		.testimony-hero__star--sky {
			animation-delay: -1.2s;
		}

		.testimony-hero__star--pink {
			animation-delay: -2.3s;
		}
	}

	@keyframes testimony-hero-rise {
		from {
			opacity: 0;
			translate: 0 1.5rem;
		}
	}

	@keyframes testimony-hero-card {
		from {
			opacity: 0;
			scale: 0.94;
			translate: 0 2rem;
		}
	}

	@keyframes testimony-hero-pop {
		from {
			opacity: 0;
			scale: 0.4;
		}
	}

	@keyframes testimony-hero-float {
		50% {
			translate: 0 -0.5rem;
		}
	}

	@keyframes testimony-hero-draw {
		from {
			stroke-dashoffset: 100;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes testimony-hero-twinkle {
		0%,
		100% {
			transform: rotate(-14deg) scale(1);
		}
		50% {
			transform: rotate(14deg) scale(0.7);
		}
	}

	/* ===== Tablet ===== */
	@media (max-width: 1100px) {
		.testimony-hero__inner {
			grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
			gap: var(--space-7);
		}

		.testimony-hero__star--yellow {
			left: auto;
			right: 40%;
		}
	}

	/* ===== Móvil: el texto arriba y la foto debajo ===== */
	@media (max-width: 640px) {
		.testimony-hero {
			padding-block: calc(var(--header-height) + var(--space-6)) var(--space-10);
		}

		.testimony-hero__inner {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-8);
		}

		.testimony-hero__content {
			gap: var(--space-4);
		}

		.testimony-hero__quote {
			max-width: none;
			font-size: var(--font-size-display-mobile);
			line-height: 1.05;
		}

		.testimony-hero__name {
			font-size: var(--font-size-md);
		}

		.testimony-hero__media {
			justify-self: stretch;
			width: auto;
			margin-inline: var(--space-3);
		}

		.testimony-hero__card {
			border-radius: var(--radius-xl);
		}

		.testimony-hero__badge {
			top: -1rem;
			left: -0.75rem;
			width: 3.25rem;
			height: 3.25rem;
		}

		.testimony-hero__route {
			left: var(--space-4);
			bottom: var(--space-4);
			font-size: var(--font-size-xs);
		}

		.testimony-hero__star--yellow {
			top: calc(var(--header-height) + 1.5rem);
			right: var(--gutter);
			width: 1.5rem;
		}

		.testimony-hero__star--sky {
			display: none;
		}

		.testimony-hero__scroll {
			display: none;
		}
	}
</style>
