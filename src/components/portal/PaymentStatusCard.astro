---
/**
 * PaymentStatusCard — resultado del pago (enviado / rechazado)
 * --------------------------------------------------------------------------
 * Figma: UI Desktop ›
 *   variant="sent"     → "MacBook Pro 14' - 9" (2045:358): foto con onda
 *                        amarilla y estrellas, estado naranja, fecha y botón
 *                        "Descargar mi constancia".
 *   variant="rejected" → "MacBook Pro 14' - 10" (2075:455): foto con onda roja
 *                        que pasa por detrás de la estudiante, estado rojo,
 *                        mensaje y botón "Volver a intentar".
 *
 * Las fotos están recortadas a la zona visible del diseño (448 × 351 / 337).
 * Las decoraciones se posicionan en % del recuadro para escalar con él.
 *
 * Uso:
 *   <PaymentStatusCard variant="sent" title="Solicitud de pago enviada"
 *       status="En validación de fondos" detail="28 sep 2025 - 01:23 am"
 *       action={{ label: 'Descargar mi constancia', href: '#', download: true }} />
 */
import { Image } from 'astro:assets';
import PortalButton from './PortalButton.astro';
import photoSent from '@assets/images/portal/payment-sent.jpg';
import photoRejected from '@assets/images/portal/payment-rejected.jpg';
import waveYellow from '@assets/graphics/illustrations/portal-wave-yellow.svg';
import waveRed from '@assets/graphics/illustrations/portal-wave-red.svg';
import starSkyblue from '@assets/graphics/illustrations/portal-star-skyblue.svg';
import starYellow from '@assets/graphics/illustrations/portal-star-yellow.svg';
import rejectedPhotoMask from '@assets/graphics/illustrations/portal-mask-rejected-photo.svg';

interface Props {
	variant: 'sent' | 'rejected';
	title: string;
	/** Texto del estado (ej. "En validación de fondos") */
	status: string;
	/** Línea bajo el estado: fecha (enviado) o mensaje (rechazado) */
	detail?: string;
	action: { label: string; href: string; download?: boolean };
}

const { variant, title, status, detail, action } = Astro.props;

const photo = variant === 'sent' ? photoSent : photoRejected;
const imageProps = {
	src: photo,
	alt: '',
	widths: [448, 896],
	sizes: '(max-width: 640px) calc(100vw - 2rem), 448px',
	loading: 'eager' as const,
};
---

<article class:list={['payment-status', `payment-status--${variant}`]} aria-labelledby="payment-status-title">
	<div
		class="payment-status__media"
		aria-hidden="true"
		style={variant === 'rejected' ? `--occluder-mask: url('${rejectedPhotoMask.src}')` : undefined}
	>
		<Image {...imageProps} class="payment-status__photo" />

		{variant === 'sent' ? (
			<>
				<img
					class="payment-status__star payment-status__star--skyblue"
					src={starSkyblue.src}
					alt=""
				/>
				<img class="payment-status__star payment-status__star--yellow" src={starYellow.src} alt="" />
				<img class="payment-status__wave" src={waveYellow.src} alt="" />
			</>
		) : (
			<>
				<img class="payment-status__wave" src={waveRed.src} alt="" />
				<!-- Copia de la foto recortada con la silueta: la onda pasa "por detrás" -->
				<Image {...imageProps} class="payment-status__photo payment-status__photo--front" />
			</>
		)}

		<span class="payment-status__shade"></span>
	</div>

	<div class="payment-status__body">
		<h1 id="payment-status-title" class="payment-status__title">
			{title}
		</h1>
		<p class="payment-status__state">
			Estado: <strong class="payment-status__state-value">{status}</strong>
		</p>
		{detail && <p class="payment-status__detail">{detail}</p>}
		<PortalButton
			href={action.href}
			width={240}
			download={action.download}
			class="payment-status__action"
		>
			{action.label}
		</PortalButton>
	</div>
</article>

<style>
	.payment-status {
		/* Medidas de Figma (enviado) */
		--media-ratio: 448 / 351;
		--body-padding-top: 2.5rem; /* 40px */
		--body-padding-bottom: 2.1875rem; /* 35px */
		--title-line-height: 1.5rem; /* 24px */
		--state-gap: 0.375rem; /* 6px */
		--detail-gap: 0.375rem; /* 6px */
		--status-color: var(--color-orange);

		width: 100%;
		max-width: 28rem; /* 448px */
		margin: 2.75rem auto 0; /* 44px bajo el stepper */
		overflow: clip;
		border-radius: var(--radius-lg);
		background-color: var(--portal-surface);
	}

	.payment-status--rejected {
		--media-ratio: 448 / 337;
		--body-padding-top: 1.6875rem; /* 27px */
		--body-padding-bottom: 2.125rem; /* 34px */
		--title-line-height: 1.75rem; /* 28px */
		--state-gap: 0.3125rem; /* 5px */
		--detail-gap: 1.125rem; /* 18px */
		--status-color: var(--color-red);
	}

	/* ----- Foto + decoraciones (posiciones de Figma en % del recuadro) ----- */
	.payment-status__media {
		position: relative;
		aspect-ratio: var(--media-ratio);
		overflow: clip;
		background-color: var(--color-black);
	}

	.payment-status__media > :global(*) {
		position: absolute;
		pointer-events: none;
		user-select: none;
	}

	.payment-status__media :global(.payment-status__photo) {
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Degradado oscuro en la parte inferior de la foto */
	.payment-status__shade {
		inset: 0;
		background: linear-gradient(to bottom, rgb(0 0 0 / 0) 60.5%, rgb(0 0 0) 111.08%);
	}

	.payment-status__wave {
		max-width: none;
		height: auto;
	}

	/* Enviado: onda amarilla 541.9 × 144.2 en (-58.7, 103.4) */
	.payment-status--sent .payment-status__wave {
		top: 29.462%;
		left: -13.096%;
		width: 120.952%;
	}

	/* Estrellas (4 puntas) */
	.payment-status__star {
		height: auto;
	}

	.payment-status__star--skyblue {
		top: 23.695%;
		left: 32.248%;
		width: 2.182%;
		transform: rotate(18.59deg) skewX(-0.07deg);
	}

	.payment-status__star--yellow {
		top: 7.67%;
		left: 59.516%;
		width: 1.502%;
		transform: rotate(-31.57deg) skewX(-0.07deg);
	}

	/* Rechazado: onda roja 542.4 × 138.3 en (-58.9, 26.6), rotada -7.67° */
	.payment-status--rejected .payment-status__wave {
		top: 7.905%;
		left: -13.154%;
		width: 121.078%;
		transform: rotate(-7.67deg) skewX(-0.88deg);
	}

	/* Silueta (193.9 × 81.7 en 132.8, 88.8) donde la foto tapa la onda */
	.payment-status__media :global(.payment-status__photo--front) {
		-webkit-mask-image: var(--occluder-mask);
		mask-image: var(--occluder-mask);
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-size: 43.274% 24.242%;
		mask-size: 43.274% 24.242%;
		-webkit-mask-position: 52.256% 34.778%;
		mask-position: 52.256% 34.778%;
	}

	/* ----- Textos ----- */
	.payment-status__body {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: var(--body-padding-top) var(--space-6) var(--body-padding-bottom);
		text-align: center;
	}

	.payment-status__title {
		color: var(--color-blue-title);
		font-size: var(--font-size-h4); /* 24px */
		font-weight: var(--font-weight-bold);
		line-height: var(--title-line-height);
	}

	.payment-status__state {
		margin-top: var(--state-gap);
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
	}

	.payment-status__state-value {
		color: var(--status-color);
		font-weight: var(--font-weight-semibold);
	}

	.payment-status__detail {
		max-width: 23.25rem; /* 372px */
		margin-top: var(--detail-gap);
		font-size: var(--font-size-sm);
		line-height: 1.25rem;
	}

	.payment-status--rejected .payment-status__detail {
		line-height: 1.5; /* "normal" en Figma */
	}

	.payment-status__body :global(.payment-status__action) {
		margin-top: var(--space-6); /* 32px */
	}

	@media (max-width: 640px) {
		.payment-status {
			margin-top: var(--space-6);
		}

		.payment-status__body {
			padding-inline: var(--space-4);
		}
	}
</style>
