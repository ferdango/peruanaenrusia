---
/**
 * PaymentNextSteps — "¿Qué sigue?" junto al resultado del pago
 * --------------------------------------------------------------------------
 * Tarjeta con los pasos que siguen después de enviar el pago (o cómo
 * solucionarlo si se rechazó), en una línea de tiempo numerada. El primer
 * paso queda resaltado: es el que está ocurriendo ahora.
 *
 * Los textos salen de src/data/portal.ts (paymentNextSteps).
 *
 * Uso (ya lo incluye PaymentStatusCard):
 *   <PaymentNextSteps variant="sent" />
 */
import PortalButton from './PortalButton.astro';
import { paymentNextSteps } from '@data/portal';

interface Props {
	variant: 'sent' | 'rejected';
}

const { variant } = Astro.props;
const { title, steps, link } = paymentNextSteps[variant];
---

<section
	class:list={['payment-next', `payment-next--${variant}`]}
	aria-labelledby={`payment-next-${variant}-title`}
>
	<h2 id={`payment-next-${variant}-title`} class="payment-next__title">
		{title}
	</h2>

	<ol class="payment-next__list" role="list">
		{steps.map((step, index) => (
			<li class="payment-next__item">
				<span class="payment-next__number" aria-hidden="true">
					{index + 1}
				</span>
				<div class="payment-next__text">
					<h3 class="payment-next__step-title">{step.title}</h3>
					<p class="payment-next__step-text">{step.text}</p>
				</div>
			</li>
		))}
	</ol>

	{link && (
		<PortalButton href={link.href} variant="outline" block>
			{link.label}
		</PortalButton>
	)}
</section>

<style>
	.payment-next {
		--next-accent: var(--color-blue);

		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		padding: var(--space-6);
		border: var(--portal-card-border);
		border-radius: var(--portal-radius-card);
		background:
			radial-gradient(18rem 10rem at 100% 0%, rgb(0 192 252 / 0.12), transparent 70%),
			var(--portal-surface);
		box-shadow: var(--portal-card-shadow);
	}

	.payment-next--rejected {
		--next-accent: var(--color-red);

		background:
			radial-gradient(18rem 10rem at 100% 0%, rgb(255 26 48 / 0.08), transparent 70%),
			var(--portal-surface);
	}

	.payment-next__title {
		color: var(--color-blue-title);
		font-size: var(--font-size-h4);
		font-weight: var(--font-weight-bold);
		line-height: 1.75rem;
	}

	/* ----- Línea de tiempo ----- */
	.payment-next__list {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.payment-next__item {
		position: relative;
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		gap: var(--space-4);
		padding-bottom: var(--space-5);
	}

	.payment-next__item:last-child {
		padding-bottom: 0;
	}

	/* Línea que une los números */
	.payment-next__item:not(:last-child)::before {
		content: '';
		position: absolute;
		top: 2.75rem;
		bottom: 0.5rem;
		left: calc(1.125rem - 1px);
		width: 2px;
		border-radius: var(--radius-pill);
		background-color: rgb(18 91 168 / 0.14);
	}

	.payment-next__number {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 2px solid rgb(18 91 168 / 0.2);
		border-radius: var(--radius-pill);
		background-color: var(--portal-surface);
		color: var(--color-blue-title);
		font-size: var(--font-size-md);
		font-weight: var(--font-weight-bold);
	}

	/* El paso que ocurre ahora */
	.payment-next__item:first-child .payment-next__number {
		border-color: var(--next-accent);
		background-color: var(--next-accent);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--next-accent) 18%, transparent);
		color: var(--color-pure-white);
	}

	.payment-next__text {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		padding-top: 0.375rem;
	}

	.payment-next__step-title {
		color: var(--text-on-light);
		font-size: var(--font-size-md);
		font-weight: var(--font-weight-semibold);
		line-height: 1.5rem;
	}

	.payment-next__step-text {
		color: var(--portal-text-soft);
		font-size: var(--font-size-sm);
		line-height: 1.375rem;
	}

	@media (max-width: 640px) {
		.payment-next {
			padding: var(--space-5) var(--space-4);
		}

		.payment-next__title {
			font-size: var(--font-size-lg);
			line-height: 1.5rem;
		}
	}
</style>
