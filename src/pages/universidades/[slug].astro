---
/**
 * Ficha de universidad ( /universidades/{slug}/ )
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › "Universidad Single" (3333:276).
 *
 * En Figma la ficha es un panel con botón ✕; aquí es una página como las
 * demás, con el lenguaje del Home: el header es transparente sobre la portada
 * (body.hero-overlay) y la página usa el mismo movimiento (body.motion:
 * src/scripts/motion.ts y src/styles/motion.css).
 *
 * Secciones (src/components/sections/universities/):
 *   1. UniversityHero      → foto, nombre (h1), resumen, "Descargar brochure",
 *                            "Ir al sitio web" y datos clave
 *   2. UniversityTabs      → píldora fija "De un vistazo · Detalles · Consejos · Brochure"
 *   3. UniversityOverview  → "De un vistazo" (#de-un-vistazo)
 *   4. UniversityDetails   → áreas de estudio, rankings y vida estudiantil (#detalles)
 *   5. UniversityTips      → "Consejos" (#consejos)
 *   6. UniversityBrochure  → "Lleva la ficha contigo" (#brochure)
 *   7. UniversityMore      → "Otras universidades"
 *
 * Se genera una página por cada universidad (de WordPress o, si no está
 * configurado, de src/data/universities.ts). Solo se dibujan las secciones
 * que tienen datos (los campos de la ficha son opcionales).
 */
import '@styles/motion.css';

import SiteLayout from '@layouts/SiteLayout.astro';

import UniversityHero from '@components/sections/universities/UniversityHero.astro';
import UniversityTabs from '@components/sections/universities/UniversityTabs.astro';
import UniversityOverview from '@components/sections/universities/UniversityOverview.astro';
import UniversityDetails from '@components/sections/universities/UniversityDetails.astro';
import UniversityTips from '@components/sections/universities/UniversityTips.astro';
import UniversityBrochure from '@components/sections/universities/UniversityBrochure.astro';
import UniversityMore from '@components/sections/universities/UniversityMore.astro';
import { routes } from '@data/navigation';
import type { University } from '@data/universities';
import { universityBrochure } from '@lib/brochures';
import { getUniversities } from '@lib/content';
import { breadcrumbSchema, universitySchema } from '@lib/seo/schema';
import { shareImageUrl } from '@lib/seo/share-image';

export async function getStaticPaths() {
	const universities = await getUniversities();
	return universities.map((university) => ({
		params: { slug: university.slug },
		props: { university },
	}));
}

interface Props {
	university: University;
}

const { university } = Astro.props;

/** Secciones de la ficha (anclas de la píldora "De un vistazo · Detalles · Consejos · Brochure") */
const sections = {
	overview: { id: 'de-un-vistazo', label: 'De un vistazo' },
	details: { id: 'detalles', label: 'Detalles' },
	tips: { id: 'consejos', label: 'Consejos' },
	brochure: { id: 'brochure', label: 'Brochure' },
};

const hasDetails = Boolean(
	university.faculties?.length || university.rankings || university.studentLife?.length,
);
const tips = university.tips ?? [];

const tabs = [
	sections.overview,
	...(hasDetails ? [sections.details] : []),
	...(tips.length ? [sections.tips] : []),
	sections.brochure,
];

const brochure = universityBrochure(university);

const description =
	university.summary ??
	`Conoce la ${university.name} (${university.city}, Rusia): carreras, vida estudiantil y consejos para postular con Peruana en Rusia.`;

// ----- SEO: datos estructurados -----
const path = Astro.url.pathname;
const shareImage = university.cover?.src ?? university.image;
const jsonLd = [
	breadcrumbSchema(
		[
			{ name: 'Inicio', path: routes.home },
			{ name: 'Universidades', path: routes.universities },
			{ name: university.name, path },
		],
		Astro.site,
	),
	universitySchema(
		{
			name: university.name,
			description,
			city: university.city,
			path,
			image: await shareImageUrl(shareImage, Astro.site),
			website: university.website,
		},
		Astro.site,
	),
];
---

<SiteLayout
	title={university.name}
	description={description}
	image={shareImage}
	jsonLd={jsonLd}
	bodyClass="university motion hero-overlay"
>
	<UniversityHero university={university} brochure={brochure} />

	<div class="university-page">
		<UniversityTabs items={tabs} />
		<UniversityOverview id={sections.overview.id} university={university} />
		{hasDetails && <UniversityDetails id={sections.details.id} university={university} />}
		{tips.length > 0 && <UniversityTips id={sections.tips.id} tips={tips} />}
		<UniversityBrochure id={sections.brochure.id} university={university} brochure={brochure} />
	</div>

	<UniversityMore currentSlug={university.slug} />
</SiteLayout>

<script>
	// Movimiento compartido con el Home: apariciones, filas con el scroll, tarjetas 3D
	import { initMotion } from '@scripts/motion';
	initMotion();
</script>

<style>
	/* Fondo claro de la ficha (la píldora de secciones se oculta al terminar este bloque) */
	.university-page {
		position: relative;
		background-color: var(--surface-white);
	}
</style>
