---
/**
 * BlogNews — "Novedades"
 * --------------------------------------------------------------------------
 * Figma: UI Desktop › Blog (1519:383) › "Frame 628302" (1711:406).
 *
 * Carrusel de tarjetas horizontales con las publicaciones destacadas
 * (videos y artículos con `featured: true`, ver src/data/blog.ts). Las
 * tarjetas de video muestran el botón ▶ y el ícono de YouTube; las de
 * artículos, solo la foto, el título y la fecha.
 *
 * Uso: segunda sección de src/pages/blog/index.astro
 *   <BlogNews />
 */
import FeaturedPostCard from '@components/blog/FeaturedPostCard.astro';
import Carousel from '@components/ui/Carousel.astro';
import { blogSectionIds, getFeaturedPosts } from '@data/blog';

// ----- Contenido de la sección -----
const content = {
	title: 'Novedades',
};

const posts = getFeaturedPosts();
---

<section class="blog-news" id={blogSectionIds.news} aria-labelledby="blog-news-title">
	<h2 id="blog-news-title" class="blog-news__title container">
		{content.title}
	</h2>

	<Carousel label={content.title} gap={12}>
		{posts.map((post) => (
			<FeaturedPostCard post={post} />
		))}
	</Carousel>
</section>

<style>
	/* `position: relative` hace que la sección se pinte sobre las ondas del hero */
	.blog-news {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		padding-block: var(--space-9); /* 64px */
		--carousel-controls-gap: 1.75rem; /* 28px */
	}

	.blog-news__title {
		font-size: var(--font-size-h3);
		line-height: 1.15; /* 32px */
	}

	/* Controles: flechas de 40px en una fila de 55px (como en Figma) */
	.blog-news :global(.carousel__controls) {
		min-height: 3.4375rem;
	}

	.blog-news :global(.carousel__arrow) {
		width: 2.5rem;
		height: 2.5rem;
	}

	@media (max-width: 640px) {
		.blog-news {
			padding-block: var(--space-7);
			--featured-card-width: min(85vw, 30rem);
		}
	}
</style>
